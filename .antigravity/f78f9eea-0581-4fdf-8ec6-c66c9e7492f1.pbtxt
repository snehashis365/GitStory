  code_action {
    action_spec {
      create_file {
        instruction: "import { useEffect, useMemo, useRef, useState } from \'react\';\nimport * as THREE from \'three\';\nimport { OrbitControls } from \'three/addons/controls/OrbitControls.js\';\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\nimport {\n  ChevronDown,\n  ChevronUp,\n  ExternalLink,\n  MessageCircle,\n  PartyPopper,\n  RotateCw,\n  X,\n} from \'lucide-react\';\nimport type { AiDigest, LifecycleStageId, LifecycleStageInfo, RepoSnapshot } from \'../types\';\nimport { formatCompactNumber, formatRelativeTime } from \'../utils/format\';\n\ninterface ProjectLifecycle3DProps {\n  snapshot: RepoSnapshot;\n  digest: AiDigest | null;\n  isAiLoading: boolean;\n  celebrationSignal: number;\n  onAskAboutStage: (prompt: string, contextLabel: string) => void;\n}\n\ntype CameraPresetId = \'overview\' | LifecycleStageId;\n\nconst STAGE_X: Record<LifecycleStageId, number> = {\n  commits: -7.8,\n  prs: -2.6,\n  community: 2.6,\n  release: 7.8,\n};\n\nconst CAMERA_PRESETS: Record<\n  CameraPresetId,\n  { label: string; pos: [number, number, number]; target: [number, number, number] }\n> = {\n  overview: { label: \'Full Lifecycle\', pos: [0, 8.8, 18.6], target: [0, 1.35, 0] },\n  commits: { label: \'1. Coding\', pos: [-8.6, 5.2, 8.6], target: [STAGE_X.commits, 1.5, 0] },\n  prs: { label: \'2. Review & Merge\', pos: [-2.6, 5.0, 8.6], target: [STAGE_X.prs, 1.6, 0] },\n  community: { label: \'3. Builders\', pos: [2.6, 5.4, 8.8], target: [STAGE_X.community, 1.7, 0] },\n  release: { label: \'4. Release\', pos: [8.6, 5.2, 8.8], target: [STAGE_X.release, 1.9, 0] },\n};\n\n// Reusable per-frame math helpers (zero GC inside animation loop)\nconst _camGoalPos = new THREE.Vector3();\nconst _camGoalTarget = new THREE.Vector3();\nconst _projVec = new THREE.Vector3();\nconst _dummyMatrix = new THREE.Matrix4();\nconst _dummyPos = new THREE.Vector3();\nconst _dummyQuat = new THREE.Quaternion();\nconst _dummyScale = new THREE.Vector3();\nconst _dummyEuler = new THREE.Euler();\nconst _color = new THREE.Color();\n\nfunction createStudioGridTexture(maxAnisotropy: number): THREE.CanvasTexture {\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = 512;\n  canvas.height = 512;\n  const ctx = canvas.getContext(\'2d\')!;\n\n  ctx.fillStyle = \'#F8FAFC\';\n  ctx.fillRect(0, 0, 512, 512);\n\n  // Clean architectural blueprint grid\n  ctx.strokeStyle = \'rgba(148, 163, 184, 0.22)\';\n  ctx.lineWidth = 1;\n  for (let i = 0; i <= 512; i += 64) {\n    ctx.beginPath();\n    ctx.moveTo(i, 0);\n    ctx.lineTo(i, 512);\n    ctx.stroke();\n\n    ctx.beginPath();\n    ctx.moveTo(0, i);\n    ctx.lineTo(512, i);\n    ctx.stroke();\n  }\n\n  // Subtle crosshairs at intersections\n  ctx.fillStyle = \'rgba(13, 148, 136, 0.25)\';\n  for (let x = 0; x <= 512; x += 128) {\n    for (let y = 0; y <= 512; y += 128) {\n      ctx.fillRect(x - 2, y - 2, 4, 4);\n    }\n  }\n\n  const tex = new THREE.CanvasTexture(canvas);\n  tex.colorSpace = THREE.SRGBColorSpace;\n  tex.wrapS = THREE.RepeatWrapping;\n  tex.wrapT = THREE.RepeatWrapping;\n  tex.repeat.set(14, 14);\n  tex.anisotropy = maxAnisotropy;\n  tex.needsUpdate = true;\n  return tex;\n}\n\n// Shared composite stage plinth (bottom-center pivot at y = 0)\nfunction buildStagePlinth(accentHex: number, castShadow: boolean): THREE.Group {\n  const g = new THREE.Group();\n  const baseMat = new THREE.MeshStandardMaterial({\n    color: 0xffffff,\n    roughness: 0.42,\n    metalness: 0.08,\n  });\n  const trimMat = new THREE.MeshStandardMaterial({\n    color: accentHex,\n    roughness: 0.28,\n    metalness: 0.55,\n  });\n  const darkRimMat = new THREE.MeshStandardMaterial({\n    color: 0x334155,\n    roughness: 0.38,\n    metalness: 0.65,\n  });\n\n  const lower = new THREE.Mesh(new THREE.CylinderGeometry(2.05, 2.22, 0.22, 32), darkRimMat);\n  lower.position.y = 0.11;\n  lower.castShadow = castShadow;\n  lower.receiveShadow = true;\n  g.add(lower);\n\n  const deck = new THREE.Mesh(new THREE.CylinderGeometry(1.92, 1.98, 0.24, 32), baseMat);\n  deck.position.y = 0.34;\n  deck.receiveShadow = true;\n  g.add(deck);\n\n  const ring = new THREE.Mesh(new THREE.TorusGeometry(1.94, 0.045, 10, 48), trimMat);\n  ring.rotation.x = Math.PI / 2;\n  ring.position.y = 0.46;\n  g.add(ring);\n\n  return g;\n}\n\n// Stage 1: Composite 3D Live Commit Activity Skyline\nfunction buildCommitsStage(\n  velocityCommits: number[],\n  castShadow: boolean\n): { group: THREE.Group; bars: THREE.Mesh[] } {\n  const group = new THREE.Group();\n  group.add(buildStagePlinth(0xff5a5f, castShadow));\n\n  const bars: THREE.Mesh[] = [];\n  const counts = velocityCommits.slice(-7);\n  while (counts.length < 7) counts.unshift(1);\n  const maxVal = Math.max(1, ...counts);\n\n  const barMat = new THREE.MeshStandardMaterial({\n    color: 0xff5a5f,\n    roughness: 0.32,\n    metalness: 0.18,\n  });\n  const capMat = new THREE.MeshStandardMaterial({\n    color: 0xfff1f2,\n    emissive: 0xff5a5f,\n    emissiveIntensity: 0.35,\n    roughness: 0.2,\n    metalness: 0.4,\n  });\n  const railMat = new THREE.MeshStandardMaterial({\n    color: 0xe2e8f0,\n    roughness: 0.4,\n    metalness: 0.7,\n  });\n\n  // Elevated bar rack\n  const rack = new THREE.Mesh(new THREE.BoxGeometry(2.65, 0.12, 0.72), railMat);\n  rack.position.set(0, 0.52, 0);\n  rack.receiveShadow = true;\n  group.add(rack);\n\n  counts.forEach((val, idx) => {\n    const h = 0.45 + (val / maxVal) * 2.15;\n    const x = -1.08 + idx * 0.36;\n    const bar = new THREE.Mesh(new THREE.BoxGeometry(0.24, h, 0.42), barMat);\n    bar.position.set(x, 0.58 + h / 2, 0);\n    bar.castShadow = castShadow;\n    bar.receiveShadow = true;\n    bar.userData = { baseY: 0.58 + h / 2, phase: idx * 0.65 };\n    group.add(bar);\n    bars.push(bar);\n\n    const cap = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.08, 0.44), capMat);\n    cap.position.set(x, 0.58 + h + 0.04, 0);\n    group.add(cap);\n  });\n\n  // Floating glass status halo above the skyline\n  const halo = new THREE.Mesh(\n    new THREE.TorusGeometry(1.15, 0.025, 8, 36),\n    new THREE.MeshStandardMaterial({\n      color: 0xff5a5f,\n      emissive: 0xff5a5f,\n      emissiveIntensity: 0.35,\n      roughness: 0.25,\n    })\n  );\n  halo.rotation.x = Math.PI / 2;\n  halo.position.y = 3.05;\n  group.add(halo);\n\n  return { group, bars };\n}\n\n// Stage 2: Composite Branch-Merge Archway Gate (explains Merged PRs visually!)\nfunction buildMergedPrStage(prCount: number, castShadow: boolean): { group: THREE.Group; scanner: THREE.Mesh } {\n  const group = new THREE.Group();\n  group.add(buildStagePlinth(0x0d9488, castShadow));\n\n  const frameMat = new THREE.MeshStandardMaterial({\n    color: 0x0f172a,\n    roughness: 0.35,\n    metalness: 0.75,\n  });\n  const tealMat = new THREE.MeshStandardMaterial({\n    color: 0x0d9488,\n    roughness: 0.28,\n    metalness: 0.35,\n  });\n  const branchCoralMat = new THREE.MeshStandardMaterial({\n    color: 0xff5a5f,\n    emissive: 0xff5a5f,\n    emissiveIntensity: 0.25,\n    roughness: 0.3,\n  });\n  const mergedGlowMat = new THREE.MeshStandardMaterial({\n    color: 0x14b8a6,\n    emissive: 0x0d9488,\n    emissiveIntensity: 0.5,\n    roughness: 0.22,\n  });\n\n  // Left & Right architectural gate pillars + curved arch beam\n  const pillarGeo = new THREE.BoxGeometry(0.28, 2.25, 0.45);\n  const leftPillar = new THREE.Mesh(pillarGeo, frameMat);\n  leftPillar.position.set(0, 1.58, -1.12);\n  leftPillar.castShadow = castShadow;\n  group.add(leftPillar);\n\n  const rightPillar = new THREE.Mesh(pillarGeo, frameMat);\n  rightPillar.position.set(0, 1.58, 1.12);\n  rightPillar.castShadow = castShadow;\n  group.add(rightPillar);\n\n  const topBeam = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.28, 2.65), tealMat);\n  topBeam.position.set(0, 2.78, 0);\n  topBeam.castShadow = castShadow;\n  group.add(topBeam);\n\n  // Two converging Git branch tubes merging smoothly into one unified trunk!\n  const branchA = new THREE.CatmullRomCurve3([\n    new THREE.Vector3(-1.55, 0.78, -0.78),\n    new THREE.Vector3(-0.65, 0.92, -0.52),\n    new THREE.Vector3(0.05, 1.02, 0),\n    new THREE.Vector3(1.55, 1.02, 0),\n  ]);\n  const branchB = new THREE.CatmullRomCurve3([\n    new THREE.Vector3(-1.55, 0.78, 0.78),\n    new THREE.Vector3(-0.65, 0.92, 0.52),\n    new THREE.Vector3(0.05, 1.02, 0),\n  ]);\n\n  const tubeA = new THREE.Mesh(new THREE.TubeGeometry(branchA, 28, 0.08, 10, false), mergedGlowMat);\n  group.add(tubeA);\n  const tubeB = new THREE.Mesh(new THREE.TubeGeometry(branchB, 20, 0.07, 10, false), branchCoralMat);\n  group.add(tubeB);\n\n  // Merge hub sphere where branches unite\n  const mergeNode = new THREE.Mesh(new THREE.SphereGeometry(0.24, 16, 16), mergedGlowMat);\n  mergeNode.position.set(0.05, 1.02, 0);\n  group.add(mergeNode);\n\n  // Stacked approved PR badge plates on top of arch\n  const stackCount = Math.min(5, Math.max(2, Math.ceil(prCount / 2)));\n  for (let i = 0; i < stackCount; i++) {\n    const plate = new THREE.Mesh(\n      new THREE.BoxGeometry(0.42, 0.1, 0.72),\n      i % 2 === 0 ? tealMat : mergedGlowMat\n    );\n    plate.position.set(0, 2.98 + i * 0.13, 0);\n    plate.castShadow = castShadow;\n    group.add(plate);\n  }\n\n  // Translucent inspection scanner pane inside the gate\n  const scanner = new THREE.Mesh(\n    new THREE.PlaneGeometry(0.18, 1.95),\n    new THREE.MeshBasicMaterial({\n      color: 0x2dd4bf,\n      transparent: true,\n      opacity: 0.35,\n      side: THREE.DoubleSide,\n      depthWrite: false,\n    })\n  );\n  scanner.rotation.y = Math.PI / 2;\n  scanner.position.set(0, 1.62, 0);\n  group.add(scanner);\n\n  return { group, scanner };\n}\n\n// Stage 3: Composite Community Velocity Gyroscope + Contributor Monument Columns\nfunction buildCommunityStage(\n  contributions: number[],\n  castShadow: boolean\n): { group: THREE.Group; outerRing: THREE.Mesh; innerRing: THREE.Mesh } {\n  const group = new THREE.Group();\n  group.add(buildStagePlinth(0x0284c7, castShadow));\n\n  const brassMat = new THREE.MeshStandardMaterial({\n    color: 0xf59e0b,\n    roughness: 0.24,\n    metalness: 0.85,\n  });\n  const tealMetalMat = new THREE.MeshStandardMaterial({\n    color: 0x0d9488,\n    roughness: 0.26,\n    metalness: 0.75,\n  });\n  const coreMat = new THREE.MeshStandardMaterial({\n    color: 0x38bdf8,\n    emissive: 0x0284c7,\n    emissiveIntensity: 0.45,\n    roughness: 0.18,\n    metalness: 0.35,\n  });\n\n  // Central pedestal + kinetic gyroscope turbine\n  const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.34, 0.85, 12), tealMetalMat);\n  stem.position.y = 0.88;\n  stem.castShadow = castShadow;\n  group.add(stem);\n\n  const outerRing = new THREE.Mesh(new THREE.TorusGeometry(0.92, 0.06, 12, 36), brassMat);\n  outerRing.position.y = 2.05;\n  outerRing.castShadow = castShadow;\n  group.add(outerRing);\n\n  const innerRing = new THREE.Mesh(new THREE.TorusGeometry(0.64, 0.05, 10, 32), tealMetalMat);\n  innerRing.position.y = 2.05;\n  innerRing.rotation.x = Math.PI / 3;\n  group.add(innerRing);\n\n  const core = new THREE.Mesh(new THREE.OctahedronGeometry(0.32, 1), coreMat);\n  core.position.y = 2.05;\n  group.add(core);\n\n  // Contributor pillars arrayed around the engine perimeter\n  const top5 = contributions.slice(0, 5);\n  while (top5.length < 5) top5.push(10);\n  const maxC = Math.max(1, ...top5);\n  const colColors = [0xf59e0b, 0xff5a5f, 0x0d9488, 0x0284c7, 0x64748b];\n\n  top5.forEach((val, idx) => {\n    const angle = (idx / 5) * Math.PI * 2 + 0.3;\n    const h = 0.45 + (val / maxC) * 1.15;\n    const colMat = new THREE.MeshStandardMaterial({\n      color: colColors[idx % colColors.length],\n      roughness: 0.35,\n      metalness: 0.25,\n    });\n    const col = new THREE.Mesh(new THREE.CylinderGeometry(0.15, 0.19, h, 10), colMat);\n    col.position.set(Math.cos(angle) * 1.42, 0.46 + h / 2, Math.sin(angle) * 1.42);\n    col.castShadow = castShadow;\n    group.add(col);\n  });\n\n  return { group, outerRing, innerRing };\n}\n\n// Stage 4: Composite Shipped Release Podium + 3D Milestone Progress Arc Ring\nfunction buildReleaseStage(\n  progressPct: number,\n  castShadow: boolean\n): { group: THREE.Group; beaconCore: THREE.Mesh } {\n  const group = new THREE.Group();\n  group.add(buildStagePlinth(0xf59e0b, castShadow));\n\n  const whiteMat = new THREE.MeshStandardMaterial({\n    color: 0xffffff,\n    roughness: 0.4,\n    metalness: 0.1,\n  });\n  const trackMat = new THREE.MeshStandardMaterial({\n    color: 0xe2e8f0,\n    roughness: 0.5,\n    metalness: 0.35,\n  });\n  const progressMat = new THREE.MeshStandardMaterial({\n    color: 0xff5a5f,\n    emissive: 0xff5a5f,\n    emissiveIntensity: 0.4,\n    roughness: 0.22,\n    metalness: 0.4,\n  });\n  const goldMat = new THREE.MeshStandardMaterial({\n    color: 0xf59e0b,\n    emissive: 0xf59e0b,\n    emissiveIntensity: 0.55,\n    roughness: 0.18,\n    metalness: 0.72,\n  });\n\n  // Stepped launch pedestal\n  const step1 = new THREE.Mesh(new THREE.CylinderGeometry(1.15, 1.32, 0.36, 16), whiteMat);\n  step1.position.y = 0.64;\n  step1.castShadow = castShadow;\n  group.add(step1);\n\n  const spireBase = new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.54, 1.05, 12), whiteMat);\n  spireBase.position.y = 1.34;\n  spireBase.castShadow = castShadow;\n  group.add(spireBase);\n\n  // Full background progress ring + real milestoneProgressPct glowing arc!\n  const bgRing = new THREE.Mesh(new THREE.TorusGeometry(1.38, 0.08, 12, 48), trackMat);\n  bgRing.position.set(0, 2.25, 0);\n  group.add(bgRing);\n\n  const arcRadians = Math.max(0.4, (Math.min(100, Math.max(15, progressPct)) / 100) * Math.PI * 2);\n  const progressArc = new THREE.Mesh(\n    new THREE.TorusGeometry(1.38, 0.115, 14, 48, arcRadians),\n    progressMat\n  );\n  progressArc.position.set(0, 2.25, 0);\n  progressArc.rotation.z = Math.PI / 2;\n  progressArc.castShadow = castShadow;\n  group.add(progressArc);\n\n  // Radiant launch beacon crystal at the center of the milestone ring\n  const beaconCore = new THREE.Mesh(new THREE.OctahedronGeometry(0.42, 0), goldMat);\n  beaconCore.position.set(0, 2.25, 0);\n  beaconCore.scale.set(1, 1.35, 1);\n  beaconCore.castShadow = castShadow;\n  group.add(beaconCore);\n\n  return { group, beaconCore };\n}\n\nexport function ProjectLifecycle3D({\n  snapshot,\n  digest,\n  isAiLoading,\n  celebrationSignal,\n  onAskAboutStage,\n}: ProjectLifecycle3DProps) {\n  const mountRef = useRef<HTMLDivElement | null>(null);\n  const labelRefs = useRef<Record<LifecycleStageId, HTMLButtonElement | null>>({\n    commits: null,\n    prs: null,\n    community: null,\n    release: null,\n  });\n\n  const [selectedStageId, setSelectedStageId] = useState<LifecycleStageId | null>(null);\n  const [activePreset, setActivePreset] = useState<CameraPresetId>(\'overview\');\n  const [autoRotate, setAutoRotate] = useState(false);\n  const [dockCollapsed, setDockCollapsed] = useState(false);\n  const [webglUnavailable, setWebglUnavailable] = useState(false);\n\n  const autoRotateRef = useRef(autoRotate);\n  const cameraGoalRef = useRef<{\n    active: boolean;\n    pos: [number, number, number];\n    target: [number, number, number];\n  }>({\n    active: false,\n    pos: CAMERA_PRESETS.overview.pos,\n    target: CAMERA_PRESETS.overview.target,\n  });\n  const burstTriggerRef = useRef<() => void>(() => {});\n  const selectStageRef = useRef<(id: LifecycleStageId) => void>(() => {});\n\n  useEffect(() => {\n    autoRotateRef.current = autoRotate;\n  }, [autoRotate]);\n\n  const stages = useMemo<LifecycleStageInfo[]>(() => {\n    const latestRel = snapshot.releases[0];\n    const progressPct = digest?.milestoneProgressPct ?? 68;\n    const briefs = digest?.lifecycleStageBriefs;\n\n    return [\n      {\n        id: \'commits\',\n        stepNumber: 1,\n        label: \'Active Coding\',\n        metricText: `${snapshot.commits.length} recent commits`,\n        emoji: \'\342\232\241\',\n        whatThisStageMeans:\n          \'Every time a developer saves an improvement, bug fix, or speedup, it enters this stage as a commit.\',\n        liveSummary:\n          briefs?.commits ||\n          (isAiLoading\n            ? \'AI is summarizing what developers have been crafting in recent commits...\'\n            : `Latest updates pushed ${formatRelativeTime(snapshot.repo.pushedAt)} on the ${snapshot.repo.defaultBranch} branch.`),\n        url: `${snapshot.repo.htmlUrl}/commits`,\n        cameraPos: CAMERA_PRESETS.commits.pos,\n        lookAt: CAMERA_PRESETS.commits.target,\n        worldAnchor: [STAGE_X.commits, 3.65, 0],\n      },\n      {\n        id: \'prs\',\n        stepNumber: 2,\n        label: \'Reviewed & Merged\',\n        metricText: `${snapshot.mergedPRs.length} merged PRs`,\n        emoji: \'\360\237\224\200\',\n        whatThisStageMeans:\n          \'Pull Requests (PRs) are proposed changes reviewed by maintainers before being safely merged into the main product.\',\n        liveSummary:\n          briefs?.prs ||\n          (isAiLoading\n            ? \'AI is translating recently merged pull requests into plain English...\'\n            : `${snapshot.mergedPRs.length} reviewed improvements have recently passed inspection and merged cleanly.`),\n        url: `${snapshot.repo.htmlUrl}/pulls?q=is%3Apr+is%3Amerged`,\n        cameraPos: CAMERA_PRESETS.prs.pos,\n        lookAt: CAMERA_PRESETS.prs.target,\n        worldAnchor: [STAGE_X.prs, 3.75, 0],\n      },\n      {\n        id: \'community\',\n        stepNumber: 3,\n        label: \'Community Engine\',\n        metricText: `${snapshot.contributors.length} top builders`,\n        emoji: \'\360\237\244\235\',\n        whatThisStageMeans:\n          \'Open-source thrives on teamwork\342\200\224this flywheel spins with the combined energy of contributors worldwide.\',\n        liveSummary:\n          briefs?.community ||\n          (isAiLoading\n            ? \'AI is highlighting how contributors are driving momentum...\'\n            : `Powered by ${formatCompactNumber(snapshot.repo.stars)} stars, ${formatCompactNumber(snapshot.repo.forks)} forks, and active builders like @${snapshot.contributors[0]?.login || snapshot.repo.owner}.`),\n        url: `${snapshot.repo.htmlUrl}/graphs/contributors`,\n        cameraPos: CAMERA_PRESETS.community.pos,\n        lookAt: CAMERA_PRESETS.community.target,\n        worldAnchor: [STAGE_X.community, 3.65, 0],\n      },\n      {\n        id: \'release\',\n        stepNumber: 4,\n        label: \'Shipped Release\',\n        metricText: latestRel ? `${latestRel.tagName} \302\267 ${progressPct}%` : `${progressPct}% to milestone`,\n        emoji: \'\360\237\232\200\',\n        whatThisStageMeans:\n          \'When tested improvements are bundled together for everyone to use, they ship as an official public release.\',\n        liveSummary:\n          briefs?.release ||\n          (isAiLoading\n            ? \'AI is summarizing the latest release milestone...\'\n            : latestRel\n              ? `Version ${latestRel.tagName} shipped ${formatRelativeTime(latestRel.publishedAt)}, with momentum building toward the next update.`\n              : \'Improvements ship continuously on the main branch as the team marches toward the next milestone.\'),\n        url: latestRel?.htmlUrl || `${snapshot.repo.htmlUrl}/releases`,\n        cameraPos: CAMERA_PRESETS.release.pos,\n        lookAt: CAMERA_PRESETS.release.target,\n        worldAnchor: [STAGE_X.release, 3.95, 0],\n      },\n    ];\n  }, [snapshot, digest, isAiLoading]);\n\n  const stagesRef = useRef(stages);\n  useEffect(() => {\n    stagesRef.current = stages;\n  }, [stages]);\n\n  const focusStage = (id: LifecycleStageId) => {\n    setSelectedStageId(id);\n    setActivePreset(id);\n    const preset = CAMERA_PRESETS[id];\n    cameraGoalRef.current = {\n      active: true,\n      pos: preset.pos,\n      target: preset.target,\n    };\n  };\n\n  useEffect(() => {\n    selectStageRef.current = focusStage;\n  });\n\n  useEffect(() => {\n    if (celebrationSignal > 0) {\n      burstTriggerRef.current();\n    }\n  }, [celebrationSignal]);\n\n  const selectedStage = selectedStageId\n    ? stages.find((s) => s.id === selectedStageId) || null\n    : null;\n\n  // Mount Three.js 3D Lifecycle Pipeline Scene\n  useEffect(() => {\n    const container = mountRef.current;\n    if (!container) return;\n\n    // 1. Software-WebGL guard\n    const isSoftwareGl = (() => {\n      try {\n        const probe = document.createElement(\'canvas\');\n        const gl = probe.getContext(\'webgl2\');\n        if (!gl) return true;\n        const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\n        const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\n        const gpu = String(gl.getParameter(param) || \'\');\n        gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\n        return /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\n      } catch {\n        return true;\n      }\n    })();\n\n    let renderer: THREE.WebGLRenderer;\n    try {\n      renderer = new THREE.WebGLRenderer({\n        antialias: !isSoftwareGl,\n        powerPreference: \'high-performance\',\n      });\n    } catch {\n      setWebglUnavailable(true);\n      return;\n    }\n\n    setWebglUnavailable(false);\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.06;\n    renderer.setPixelRatio(isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 2));\n    renderer.shadowMap.enabled = !isSoftwareGl;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n\n    let width = container.clientWidth || 900;\n    let height = container.clientHeight || 480;\n    renderer.setSize(width, height);\n    container.innerHTML = \'\';\n    container.appendChild(renderer.domElement);\n\n    const handleContextLost = (e: Event) => e.preventDefault();\n    renderer.domElement.addEventListener(\'webglcontextlost\', handleContextLost);\n\n    // 2. Daylight Architectural Studio Scene & RoomEnvironment\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(0xf1f5f9);\n    scene.fog = new THREE.FogExp2(0xf1f5f9, 0.018);\n\n    const pmrem = new THREE.PMREMGenerator(renderer);\n    const envTex = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;\n    scene.environment = envTex;\n    pmrem.dispose();\n\n    // 3. Camera & OrbitControls\n    const camera = new THREE.PerspectiveCamera(40, width / height, 0.2, 140);\n    camera.position.set(...CAMERA_PRESETS.overview.pos);\n\n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.target.set(...CAMERA_PRESETS.overview.target);\n    controls.enableDamping = !isSoftwareGl;\n    controls.dampingFactor = 0.06;\n    controls.minDistance = 6.5;\n    controls.maxDistance = 30;\n    controls.maxPolarAngle = Math.PI * 0.47;\n    controls.minPolarAngle = 0.25;\n    controls.update();\n\n    const onControlStart = () => {\n      cameraGoalRef.current.active = false;\n    };\n    controls.addEventListener(\'start\', onControlStart);\n\n    // 4. Balanced 3-Point Daylight Studio Lighting\n    const hemi = new THREE.HemisphereLight(0xffffff, 0xcbd5e1, 0.9);\n    scene.add(hemi);\n\n    const keyLight = new THREE.DirectionalLight(0xfff6e8, 1.7);\n    keyLight.position.set(10, 18, 12);\n    keyLight.castShadow = !isSoftwareGl;\n    keyLight.shadow.mapSize.width = 1024;\n    keyLight.shadow.mapSize.height = 1024;\n    keyLight.shadow.camera.near = 2;\n    keyLight.shadow.camera.far = 48;\n    keyLight.shadow.camera.left = -16;\n    keyLight.shadow.camera.right = 16;\n    keyLight.shadow.camera.top = 12;\n    keyLight.shadow.camera.bottom = -12;\n    keyLight.shadow.bias = -0.0005;\n    keyLight.shadow.normalBias = 0.02;\n    scene.add(keyLight);\n\n    const rimLight = new THREE.DirectionalLight(0x99f6e4, 0.55);\n    rimLight.position.set(-12, 8, -10);\n    scene.add(rimLight);\n\n    // 5. Blueprint Architectural Floor\n    const maxAniso = renderer.capabilities.getMaxAnisotropy();\n    const gridTex = createStudioGridTexture(maxAniso);\n    const floorMat = new THREE.MeshStandardMaterial({\n      map: gridTex,\n      roughness: 0.88,\n      metalness: 0.02,\n      polygonOffset: true,\n      polygonOffsetFactor: 1,\n      polygonOffsetUnits: 1,\n    });\n    const floor = new THREE.Mesh(new THREE.PlaneGeometry(90, 90), floorMat);\n    floor.rotation.x = -Math.PI / 2;\n    floor.position.y = -0.02;\n    floor.receiveShadow = true;\n    scene.add(floor);\n\n    // 6. Luminous Lifecycle Pipeline Connector Track (Left -> Right)\n    const pipelineCurve = new THREE.CatmullRomCurve3([\n      new THREE.Vector3(STAGE_X.commits, 0.42, 0),\n      new THREE.Vector3(STAGE_X.prs, 0.42, 0),\n      new THREE.Vector3(STAGE_X.community, 0.42, 0),\n      new THREE.Vector3(STAGE_X.release, 0.42, 0),\n    ]);\n    const trackTube = new THREE.Mesh(\n      new THREE.TubeGeometry(pipelineCurve, 48, 0.14, 12, false),\n      new THREE.MeshStandardMaterial({\n        color: 0xe2e8f0,\n        roughness: 0.25,\n        metalness: 0.72,\n      })\n    );\n    trackTube.receiveShadow = true;\n    scene.add(trackTube);\n\n    // Directional flow chevron markers between stages\n    const chevronGeo = new THREE.ConeGeometry(0.22, 0.46, 3);\n    const chevronMat = new THREE.MeshStandardMaterial({\n      color: 0x0d9488,\n      emissive: 0x0d9488,\n      emissiveIntensity: 0.3,\n      roughness: 0.3,\n    });\n    const midXs = [-5.2, 0, 5.2];\n    midXs.forEach((mx) => {\n      const arrow = new THREE.Mesh(chevronGeo, chevronMat);\n      arrow.rotation.z = -Math.PI / 2;\n      arrow.position.set(mx, 0.44, 0.48);\n      scene.add(arrow);\n    });\n\n    // Animated Data Packets gliding smoothly across the 4-stage pipeline\n    const packetGeo = new THREE.CapsuleGeometry(0.11, 0.22, 6, 12);\n    const packetColors = [0xff5a5f, 0x0d9488, 0x0284c7, 0xf59e0b];\n    const packets: { mesh: THREE.Mesh; progress: number; speed: number }[] = [];\n    for (let i = 0; i < 8; i++) {\n      const pMat = new THREE.MeshStandardMaterial({\n        color: packetColors[i % packetColors.length],\n        emissive: packetColors[i % packetColors.length],\n        emissiveIntensity: 0.55,\n        roughness: 0.2,\n      });\n      const m = new THREE.Mesh(packetGeo, pMat);\n      m.rotation.z = Math.PI / 2;\n      scene.add(m);\n      packets.push({ mesh: m, progress: i / 8, speed: 0.13 });\n    }\n\n    // 7. Build All 4 Composite 3D Lifecycle Stages\n    const commitsBuilt = buildCommitsStage(\n      snapshot.velocitySeries.map((v) => v.commits),\n      !isSoftwareGl\n    );\n    commitsBuilt.group.position.set(STAGE_X.commits, 0, 0);\n    scene.add(commitsBuilt.group);\n\n    const prsBuilt = buildMergedPrStage(snapshot.mergedPRs.length, !isSoftwareGl);\n    prsBuilt.group.position.set(STAGE_X.prs, 0, 0);\n    scene.add(prsBuilt.group);\n\n    const communityBuilt = buildCommunityStage(\n      snapshot.contributors.map((c) => c.contributions),\n      !isSoftwareGl\n    );\n    communityBuilt.group.position.set(STAGE_X.community, 0, 0);\n    scene.add(communityBuilt.group);\n\n    const releaseBuilt = buildReleaseStage(digest?.milestoneProgressPct ?? 68, !isSoftwareGl);\n    releaseBuilt.group.position.set(STAGE_X.release, 0, 0);\n    scene.add(releaseBuilt.group);\n\n    // 8. Layer-1 Raycast Proxy Spheres for Snap Stage Selection\n    const clickProxies: THREE.Mesh[] = [];\n    const proxyMat = new THREE.MeshBasicMaterial({ visible: false });\n    ([\'commits\', \'prs\', \'community\', \'release\'] as LifecycleStageId[]).forEach((stageId) => {\n      const proxy = new THREE.Mesh(new THREE.CylinderGeometry(2.2, 2.2, 3.6, 12), proxyMat);\n      proxy.position.set(STAGE_X[stageId], 1.8, 0);\n      proxy.layers.set(1);\n      proxy.userData = { stageId };\n      scene.add(proxy);\n      clickProxies.push(proxy);\n    });\n\n    // 9. Milestone Celebration Confetti Pool above Stage 4 (Release)\n    const PARTICLE_COUNT = 56;\n    const confettiGeo = new THREE.BoxGeometry(0.15, 0.15, 0.04);\n    const confettiMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.3 });\n    const confettiInst = new THREE.InstancedMesh(confettiGeo, confettiMat, PARTICLE_COUNT);\n    confettiInst.frustumCulled = false;\n    confettiInst.visible = false;\n    const particles: {\n      pos: THREE.Vector3;\n      vel: THREE.Vector3;\n      rot: THREE.Euler;\n      life: number;\n    }[] = [];\n    for (let i = 0; i < PARTICLE_COUNT; i++) {\n      particles.push({\n        pos: new THREE.Vector3(STAGE_X.release, 3.2, 0),\n        vel: new THREE.Vector3(),\n        rot: new THREE.Euler(),\n        life: 0,\n      });\n      _color.setHex(packetColors[i % packetColors.length]);\n      confettiInst.setColorAt(i, _color);\n    }\n    if (confettiInst.instanceColor) confettiInst.instanceColor.needsUpdate = true;\n    scene.add(confettiInst);\n\n    let celebrationActive = false;\n    burstTriggerRef.current = () => {\n      celebrationActive = true;\n      confettiInst.visible = true;\n      for (let i = 0; i < PARTICLE_COUNT; i++) {\n        const p = particles[i];\n        p.pos.set(STAGE_X.release, 3.1, 0);\n        const theta = Math.random() * Math.PI * 2;\n        const speed = 2.0 + Math.random() * 4.0;\n        p.vel.set(Math.cos(theta) * speed, 4.0 + Math.random() * 4.2, Math.sin(theta) * speed);\n        p.rot.set(Math.random() * 3, Math.random() * 3, Math.random() * 3);\n        p.life = 1.5 + Math.random() * 1.0;\n      }\n    };\n\n    // 10. Pointer Raycasting\n    const raycaster = new THREE.Raycaster();\n    raycaster.layers.set(1);\n    const pointerNdc = new THREE.Vector2();\n    let hovered: THREE.Mesh | null = null;\n    let lastMoveTs = 0;\n    let downX = 0;\n    let downY = 0;\n\n    const updatePointer = (ev: PointerEvent) => {\n      const rect = renderer.domElement.getBoundingClientRect();\n      pointerNdc.x = ((ev.clientX - rect.left) / rect.width) * 2 - 1;\n      pointerNdc.y = -((ev.clientY - rect.top) / rect.height) * 2 + 1;\n    };\n\n    const handlePointerMove = (ev: PointerEvent) => {\n      const now = performance.now();\n      if (now - lastMoveTs < 45) return;\n      lastMoveTs = now;\n      updatePointer(ev);\n      raycaster.setFromCamera(pointerNdc, camera);\n      const hits = raycaster.intersectObjects(clickProxies, false);\n      const hit = hits.length > 0 ? (hits[0].object as THREE.Mesh) : null;\n      if (hit !== hovered) {\n        hovered = hit;\n        renderer.domElement.style.cursor = hit ? \'pointer\' : \'grab\';\n      }\n    };\n\n    const handlePointerDown = (ev: PointerEvent) => {\n      downX = ev.clientX;\n      downY = ev.clientY;\n    };\n\n    const handlePointerUp = (ev: PointerEvent) => {\n      if (Math.hypot(ev.clientX - downX, ev.clientY - downY) > 6) return;\n      updatePointer(ev);\n      raycaster.setFromCamera(pointerNdc, camera);\n      const hits = raycaster.intersectObjects(clickProxies, false);\n      if (hits.length > 0) {\n        const stageId = hits[0].object.userData.stageId as LifecycleStageId;\n        if (stageId) selectStageRef.current(stageId);\n      }\n    };\n\n    renderer.domElement.style.cursor = \'grab\';\n    renderer.domElement.addEventListener(\'pointermove\', handlePointerMove);\n    renderer.domElement.addEventListener(\'pointerdown\', handlePointerDown);\n    renderer.domElement.addEventListener(\'pointerup\', handlePointerUp);\n\n    if (!isSoftwareGl) {\n      renderer.compile(scene, camera);\n    }\n\n    const resizeObserver = new ResizeObserver((entries) => {\n      const entry = entries[0];\n      if (!entry) return;\n      width = Math.max(240, Math.floor(entry.contentRect.width));\n      height = Math.max(260, Math.floor(entry.contentRect.height));\n      camera.aspect = width / height;\n      camera.updateProjectionMatrix();\n      renderer.setSize(width, height);\n    });\n    resizeObserver.observe(container);\n\n    // 11. Animation Loop with Projected 3D-to-2D Stage Labels & Software-WebGL Pacing\n    const clock = new THREE.Clock();\n    const spinSpeedFactor = Math.min(2.2, 0.7 + snapshot.commits.length * 0.08);\n    let frameId = 0;\n    let disposed = false;\n\n    function afterDraw(cb: () => void) {\n      const gl = renderer.getContext() as WebGL2RenderingContext;\n      if (!gl || typeof gl.fenceSync !== \'function\') {\n        frameId = window.setTimeout(cb, 85);\n        return;\n      }\n      const sync = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0);\n      gl.flush();\n      const poll = () => {\n        if (disposed) {\n          if (sync) gl.deleteSync(sync);\n          return;\n        }\n        const state = sync && gl.getSyncParameter(sync, gl.SYNC_STATUS);\n        if (state === gl.UNSIGNALED) {\n          frameId = window.setTimeout(poll, 5);\n        } else {\n          if (sync) gl.deleteSync(sync);\n          frameId = window.setTimeout(cb, 80);\n        }\n      };\n      frameId = window.setTimeout(poll, 5);\n    }\n\n    function updateProjectedLabels() {\n      const list = stagesRef.current;\n      for (let i = 0; i < list.length; i++) {\n        const st = list[i];\n        const el = labelRefs.current[st.id];\n        if (!el) continue;\n        _projVec.set(...st.worldAnchor).project(camera);\n        const visible = _projVec.z < 1 && _projVec.z > -1;\n        if (!visible) {\n          el.style.opacity = \'0\';\n          el.style.pointerEvents = \'none\';\n          continue;\n        }\n        const sx = ((_projVec.x + 1) / 2) * width;\n        const sy = ((-_projVec.y + 1) / 2) * height;\n        el.style.opacity = \'1\';\n        el.style.pointerEvents = \'auto\';\n        el.style.transform = `translate3d(${sx.toFixed(1)}px, ${sy.toFixed(1)}px, 0) translate(-50%, -100%)`;\n      }\n    }\n\n    function tick() {\n      if (disposed) return;\n      const delta = Math.min(0.08, clock.getDelta());\n      const elapsed = clock.getElapsedTime();\n\n      // Subtle living pulse on Stage 1 commit bars\n      for (let i = 0; i < commitsBuilt.bars.length; i++) {\n        const b = commitsBuilt.bars[i];\n        b.scale.y = 1 + Math.sin(elapsed * 2.1 + (b.userData.phase || 0)) * 0.04;\n      }\n\n      // Stage 2 merge gate subtle shimmer\n      prsBuilt.scanner.position.x = Math.sin(elapsed * 2.2) * 0.14;\n\n      // Stage 3 kinetic community gyroscope\n      communityBuilt.outerRing.rotation.y += delta * 0.7 * spinSpeedFactor;\n      communityBuilt.outerRing.rotation.x = Math.sin(elapsed * 0.8) * 0.22;\n      communityBuilt.innerRing.rotation.z -= delta * 1.15 * spinSpeedFactor;\n\n      // Stage 4 release beacon crystal gentle hover & rotation\n      releaseBuilt.beaconCore.rotation.y += delta * 0.9;\n      releaseBuilt.beaconCore.position.y = 2.25 + Math.sin(elapsed * 2.0) * 0.12;\n\n      // Flowing data packets along pipeline from Commits -> PRs -> Community -> Release\n      for (let i = 0; i < packets.length; i++) {\n        const pkt = packets[i];\n        pkt.progress = (pkt.progress + delta * pkt.speed) % 1;\n        pipelineCurve.getPointAt(pkt.progress, _dummyPos);\n        pkt.mesh.position.set(_dummyPos.x, _dummyPos.y + 0.18, _dummyPos.z);\n      }\n\n      // Celebration confetti physics\n      if (celebrationActive) {\n        let alive = 0;\n        for (let i = 0; i < PARTICLE_COUNT; i++) {\n          const p = particles[i];\n          if (p.life > 0) {\n            alive++;\n            p.life -= delta;\n            p.vel.y -= 9.0 * delta;\n            p.pos.addScaledVector(p.vel, delta);\n            p.rot.x += delta * 5.0;\n            p.rot.y += delta * 4.2;\n            const s = Math.max(0.01, Math.min(1, p.life));\n            _dummyQuat.setFromEuler(p.rot);\n            _dummyScale.set(s, s, s);\n            _dummyMatrix.compose(p.pos, _dummyQuat, _dummyScale);\n            confettiInst.setMatrixAt(i, _dummyMatrix);\n          } else {\n            _dummyScale.set(0, 0, 0);\n            _dummyMatrix.compose(p.pos, _dummyQuat, _dummyScale);\n            confettiInst.setMatrixAt(i, _dummyMatrix);\n          }\n        }\n        confettiInst.instanceMatrix.needsUpdate = true;\n        if (alive === 0) {\n          celebrationActive = false;\n          confettiInst.visible = false;\n        }\n      }\n\n      // Smooth damped camera preset transitions\n      if (cameraGoalRef.current.active) {\n        _camGoalPos.set(...cameraGoalRef.current.pos);\n        _camGoalTarget.set(...cameraGoalRef.current.target);\n        camera.position.x = THREE.MathUtils.damp(camera.position.x, _camGoalPos.x, 4.8, delta);\n        camera.position.y = THREE.MathUtils.damp(camera.position.y, _camGoalPos.y, 4.8, delta);\n        camera.position.z = THREE.MathUtils.damp(camera.position.z, _camGoalPos.z, 4.8, delta);\n\n        controls.target.x = THREE.MathUtils.damp(controls.target.x, _camGoalTarget.x, 4.8, delta);\n        controls.target.y = THREE.MathUtils.damp(controls.target.y, _camGoalTarget.y, 4.8, delta);\n        controls.target.z = THREE.MathUtils.damp(controls.target.z, _camGoalTarget.z, 4.8, delta);\n\n        if (\n          camera.position.distanceTo(_camGoalPos) < 0.08 &&\n          controls.target.distanceTo(_camGoalTarget) < 0.08\n        ) {\n          cameraGoalRef.current.active = false;\n        }\n      } else if (autoRotateRef.current && !isSoftwareGl) {\n        controls.autoRotate = true;\n        controls.autoRotateSpeed = 0.55;\n      } else {\n        controls.autoRotate = false;\n      }\n\n      controls.update();\n      renderer.render(scene, camera);\n      updateProjectedLabels();\n\n      if (isSoftwareGl) {\n        afterDraw(tick);\n      } else {\n        frameId = requestAnimationFrame(tick);\n      }\n    }\n\n    tick();\n\n    return () => {\n      disposed = true;\n      cancelAnimationFrame(frameId);\n      clearTimeout(frameId);\n      resizeObserver.disconnect();\n      controls.removeEventListener(\'start\', onControlStart);\n      controls.dispose();\n      renderer.domElement.removeEventListener(\'webglcontextlost\', handleContextLost);\n      renderer.domElement.removeEventListener(\'pointermove\', handlePointerMove);\n      renderer.domElement.removeEventListener(\'pointerdown\', handlePointerDown);\n      renderer.domElement.removeEventListener(\'pointerup\', handlePointerUp);\n\n      scene.traverse((obj) => {\n        if ((obj as THREE.Mesh).isMesh) {\n          const m = obj as THREE.Mesh;\n          m.geometry?.dispose();\n          if (Array.isArray(m.material)) {\n            m.material.forEach((mat) => mat.dispose());\n          } else {\n            m.material?.dispose();\n          }\n        }\n      });\n      gridTex.dispose();\n      envTex.dispose();\n      renderer.dispose();\n    };\n  }, [\n    snapshot.repo.fullName,\n    snapshot.commits.length,\n    snapshot.mergedPRs.length,\n    snapshot.contributors.length,\n    digest?.milestoneProgressPct,\n  ]);\n\n  const handlePresetClick = (presetId: CameraPresetId) => {\n    setActivePreset(presetId);\n    const preset = CAMERA_PRESETS[presetId];\n    cameraGoalRef.current = {\n      active: true,\n      pos: preset.pos,\n      target: preset.target,\n    };\n    setSelectedStageId(presetId === \'overview\' ? null : presetId);\n  };\n\n  return (\n    <div className=\"relative h-[440px] sm:h-[500px] lg:h-[540px] w-full overflow-hidden rounded-3xl border border-slate-200 bg-[#F1F5F9]\">\n      {/* Isolated WebGL Mount */}\n      {!webglUnavailable ? (\n        <div\n          ref={mountRef}\n          className=\"h-full w-full\"\n          aria-label=\"Interactive 3D Project Lifecycle Pipeline\"\n        />\n      ) : (\n        <div className=\"flex h-full w-full flex-col items-center justify-center p-8 text-center\">\n          <span className=\"text-4xl\" aria-hidden=\"true\">\n            \360\237\232\200\n          </span>\n          <h3 className=\"mt-3 font-display text-xl font-bold text-[#0F172A]\">\n            3D Lifecycle Pipeline Unavailable\n          </h3>\n          <p className=\"mt-1.5 max-w-md text-sm text-slate-600\">\n            WebGL is unavailable in this browser environment, but all AI progress chapters, velocity\n            charts, and chat features remain fully active.\n          </p>\n        </div>\n      )}\n\n      {/* Live 3D-Projected Interactive Stage Labels (Zero-Lag Direct Transform) */}\n      {!webglUnavailable && (\n        <div className=\"pointer-events-none absolute inset-0 z-10 overflow-hidden\">\n          {stages.map((st) => {\n            const isSelected = selectedStageId === st.id;\n            return (\n              <button\n                key={st.id}\n                ref={(el) => {\n                  labelRefs.current[st.id] = el;\n                }}\n                type=\"button\"\n                onClick={() => focusStage(st.id)}\n                style={{ opacity: 0 }}\n                className={`absolute top-0 left-0 flex flex-col items-center rounded-xl border px-3 py-1.5 text-center shadow-sm transition-colors cursor-pointer ${\n                  isSelected\n                    ? \'border-[#FF5A5F] bg-[#0F172A] text-white\'\n                    : \'border-slate-200 bg-white text-[#0F172A] hover:border-[#0D9488]\'\n                }`}\n              >\n                <span className=\"font-display text-xs font-bold whitespace-nowrap\">\n                  {st.stepNumber}. {st.label}\n                </span>\n                <span\n                  className={`font-mono text-[10px] font-semibold tabular-nums whitespace-nowrap ${\n                    isSelected ? \'text-[#FF5A5F]\' : \'text-[#0D9488]\'\n                  }`}\n                >\n                  {st.metricText}\n                </span>\n              </button>\n            );\n          })}\n        </div>\n      )}\n\n      {/* Minimal Top-Left Scene Legend */}\n      <div className=\"pointer-events-none absolute top-4 left-4 z-10 max-w-[calc(100%-2rem)]\">\n        <div className=\"inline-flex flex-wrap items-center gap-x-2.5 gap-y-1 rounded-xl border border-slate-200 bg-white px-3.5 py-2 shadow-sm\">\n          <span className=\"font-display text-sm font-bold text-[#0F172A]\">\n            {snapshot.repo.name} Lifecycle Pipeline\n          </span>\n          <span className=\"text-slate-300\" aria-hidden=\"true\">\n            \302\267\n          </span>\n          <span className=\"text-xs text-slate-600\">\n            Click any stage to learn what&apos;s happening in plain English\n          </span>\n        </div>\n      </div>\n\n      {/* Selected Stage Plain-English AI Explainer Card (Clean Solid Surface\342\200\224No backdrop-blur over WebGL) */}\n      {selectedStage && (\n        <div className=\"absolute top-16 left-4 z-20 w-[calc(100%-2rem)] max-w-sm rounded-2xl border border-slate-200 bg-white p-4 shadow-lg shadow-slate-900/10\">\n          <div className=\"flex items-start justify-between gap-2\">\n            <div className=\"flex items-center gap-2.5 min-w-0\">\n              <span className=\"text-xl shrink-0\" aria-hidden=\"true\">\n                {selectedStage.emoji}\n              </span>\n              <div className=\"min-w-0\">\n                <h4 className=\"font-display text-sm font-bold text-[#0F172A] truncate\">\n                  Stage {selectedStage.stepNumber}: {selectedStage.label}\n                </h4>\n                <p className=\"font-mono text-[11px] font-semibold text-[#0D9488] tabular-nums\">\n                  {selectedStage.metricText}\n                </p>\n              </div>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => handlePresetClick(\'overview\')}\n              aria-label=\"Close stage explainer\"\n              className=\"rounded-lg p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700 cursor-pointer\"\n            >\n              <X className=\"h-4 w-4\" />\n            </button>\n          </div>\n\n          <p className=\"mt-2.5 text-xs leading-relaxed text-[#0F172A] font-medium\">\n            {selectedStage.liveSummary}\n          </p>\n          <p className=\"mt-2 rounded-xl bg-slate-50 px-3 py-2 text-[11px] leading-relaxed text-slate-600 border border-slate-100\">\n            <strong className=\"text-slate-800\">What this stage means:</strong>{\' \'}\n            {selectedStage.whatThisStageMeans}\n          </p>\n\n          <div className=\"mt-3 flex items-center gap-2 pt-2 border-t border-slate-100\">\n            <button\n              type=\"button\"\n              onClick={() =>\n                onAskAboutStage(\n                  `Tell me more about Stage ${selectedStage.stepNumber} (${selectedStage.label}) for ${snapshot.repo.fullName}. What has been happening here recently in simple terms?`,\n                  `Stage ${selectedStage.stepNumber}: ${selectedStage.label}`\n                )\n              }\n              className=\"inline-flex flex-1 items-center justify-center gap-1.5 rounded-lg bg-[#FF5A5F] px-3 py-1.5 text-xs font-semibold text-white hover:bg-[#E0484D] transition-colors whitespace-nowrap cursor-pointer\"\n            >\n              <MessageCircle className=\"h-3.5 w-3.5\" />\n              <span>Ask AI About This Stage</span>\n            </button>\n            <a\n              href={selectedStage.url}\n              target=\"_blank\"\n              rel=\"noreferrer\"\n              className=\"inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-100 transition-colors whitespace-nowrap\"\n            >\n              <span>GitHub</span>\n              <ExternalLink className=\"h-3 w-3\" />\n            </a>\n          </div>\n        </div>\n      )}\n\n      {/* Unified Collapsible Bottom Control Dock */}\n      <div className=\"absolute bottom-3 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center max-w-[95%]\">\n        <button\n          type=\"button\"\n          onClick={() => setDockCollapsed((v) => !v)}\n          className=\"mb-1.5 inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-semibold text-slate-600 shadow-sm hover:text-[#0F172A] transition-colors cursor-pointer\"\n        >\n          {dockCollapsed ? (\n            <>\n              <ChevronUp className=\"h-3.5 w-3.5\" />\n              <span>Show Pipeline Controls</span>\n            </>\n          ) : (\n            <>\n              <ChevronDown className=\"h-3.5 w-3.5\" />\n              <span>Hide Controls</span>\n            </>\n          )}\n        </button>\n\n        {!dockCollapsed && (\n          <div className=\"flex flex-wrap items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white p-1.5 shadow-md shadow-slate-900/8\">\n            {(Object.keys(CAMERA_PRESETS) as CameraPresetId[]).map((presetId) => {\n              const active = activePreset === presetId;\n              return (\n                <button\n                  key={presetId}\n                  type=\"button\"\n                  onClick={() => handlePresetClick(presetId)}\n                  className={`rounded-xl px-3 py-1.5 text-xs font-semibold transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                    active\n                      ? \'bg-[#0F172A] text-white\'\n                      : \'text-slate-600 hover:bg-slate-100 hover:text-[#0F172A]\'\n                  }`}\n                >\n                  {CAMERA_PRESETS[presetId].label}\n                </button>\n              );\n            })}\n\n            <div className=\"mx-1 hidden h-5 w-px bg-slate-200 sm:block\" aria-hidden=\"true\" />\n\n            <button\n              type=\"button\"\n              onClick={() => setAutoRotate((v) => !v)}\n              className={`inline-flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-semibold transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                autoRotate\n                  ? \'bg-[#0D9488]/12 text-[#0D9488]\'\n                  : \'text-slate-600 hover:bg-slate-100\'\n              }`}\n            >\n              <RotateCw className=\"h-3.5 w-3.5\" />\n              <span>{autoRotate ? \'Orbit On\' : \'Orbit Off\'}</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => burstTriggerRef.current()}\n              className=\"inline-flex items-center gap-1.5 rounded-xl bg-[#FF5A5F]/12 px-3 py-1.5 text-xs font-semibold text-[#FF5A5F] hover:bg-[#FF5A5F]/20 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n            >\n              <PartyPopper className=\"h-3.5 w-3.5\" />\n              <span>Celebrate</span>\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"
