              text: "    const handlePointerUp = (ev: PointerEvent) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (Math.hypot(ev.clientX - downX, ev.clientY - downY) > 6) return;"
