            lines {
              text: "    const pointerNdc = new THREE.Vector2();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let hoveredProxy: THREE.Mesh | null = null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let lastMoveTs = 0;"
