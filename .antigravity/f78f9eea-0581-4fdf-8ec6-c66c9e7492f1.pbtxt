  planner_response {
    thinking: "**Composing a New Feature**\n\nI\'m currently focused on the `ActivityFeed.tsx` component, specifically the \"Latest Release Spotlight\" and a jargon-free stream of commits and merged PRs. I\'m working to implement segmented filter tabs for \"All,\" \"Commits,\" and \"Merged PRs,\" alongside a live search filter. Each entry will expand to show the original technical message and a GitHub link.\n\n\n**Refining UX Details**\n\nI\'ve been meticulously refining UX details, especially concerning the \"Explain with AI\" action, ensuring zero-pill metadata discipline with unboxed metadata and clean visual separation. I\'m also developing the `CommunityChatDrawer.tsx` to handle a streaming SSE Gemini AI Chat interface, grounded in the active repository, complete with error recovery. Further, the full interactive dashboard is coming together, orchestrating the 3-zone Top Bar Contract and real-time syncing.\n\n\n"
    message_id: "PMgCa6LTCc6YzLEPl9D2qAg"
    tool_calls {
      id: "call_16442137170944379808"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useMemo, useState } from \'react\';\\nimport {\\n  ChevronDown,\\n  ChevronUp,\\n  Code2,\\n  ExternalLink,\\n  GitCommitHorizontal,\\n  GitMerge,\\n  MessageCircle,\\n  Search,\\n  Sparkles,\\n  Tag,\\n} from \'lucide-react\';\\nimport type { AiDigest, RepoSnapshot } from \'../types\';\\nimport { formatRelativeTime, formatShortDate } from \'../utils/format\';\\n\\ninterface ActivityFeedProps {\\n  snapshot: RepoSnapshot;\\n  digest: AiDigest | null;\\n  isAiLoading: boolean;\\n  onAskAboutItem: (prompt: string, contextLabel: string) => void;\\n}\\n\\ntype FeedTab = \'all\' | \'commits\' | \'prs\';\\n\\ninterface FeedEntry {\\n  id: string;\\n  kind: \'commit\' | \'pr\';\\n  emoji: string;\\n  plainTitle: string;\\n  whyItMatters: string;\\n  category: string;\\n  rawTitle: string;\\n  rawCodeLabel: string;\\n  author: string;\\n  authorAvatar: string;\\n  timestamp: string;\\n  url: string;\\n  isTranslated: boolean;\\n}\\n\\nexport function ActivityFeed({\\n  snapshot,\\n  digest,\\n  isAiLoading,\\n  onAskAboutItem,\\n}: ActivityFeedProps) {\\n  const [activeTab, setActiveTab] = useState<FeedTab>(\'all\');\\n  const [query, setQuery] = useState(\'\');\\n  const [expandedTechIds, setExpandedTechIds] = useState<Record<string, boolean>>({});\\n  const [showRawRelease, setShowRawRelease] = useState(false);\\n\\n  const toggleTechDetails = (id: string) => {\\n    setExpandedTechIds((prev) => ({ ...prev, [id]: !prev[id] }));\\n  };\\n\\n  const latestRelease = snapshot.releases[0] || null;\\n  const releaseAi = digest?.releaseTranslation || null;\\n\\n  const entries = useMemo<FeedEntry[]>(() => {\\n    const commitMap = new Map(\\n      (digest?.commitTranslations || []).map((t) => [t.sha.toLowerCase(), t])\\n    );\\n    const prMap = new Map((digest?.prTranslations || []).map((t) => [t.number, t]));\\n\\n    const commitEntries: FeedEntry[] = snapshot.commits.slice(0, 10).map((c) => {\\n      const tr = commitMap.get(c.shortSha.toLowerCase());\\n      return {\\n        id: `commit-${c.sha}`,\\n        kind: \'commit\',\\n        emoji: tr?.emoji || \'\360\237\224\247\',\\n        plainTitle: tr?.plainTitle || c.firstLine,\\n        whyItMatters:\\n          tr?.whyItMatters ||\\n          (isAiLoading\\n            ? \'Translating this engineering update into plain English...\'\\n            : `Committed to ${snapshot.repo.defaultBranch} by @${c.authorLogin}.`),\\n        category: tr?.category || \'Update\',\\n        rawTitle: c.firstLine,\\n        rawCodeLabel: `commit ${c.shortSha}`,\\n        author: c.authorLogin,\\n        authorAvatar: c.authorAvatar,\\n        timestamp: c.date,\\n        url: c.htmlUrl,\\n        isTranslated: Boolean(tr),\\n      };\\n    });\\n\\n    const prEntries: FeedEntry[] = snapshot.mergedPRs.slice(0, 8).map((p) => {\\n      const tr = prMap.get(p.number);\\n      return {\\n        id: `pr-${p.number}`,\\n        kind: \'pr\',\\n        emoji: tr?.emoji || \'\360\237\216\211\',\\n        plainTitle: tr?.plainTitle || p.title,\\n        whyItMatters:\\n          tr?.whyItMatters ||\\n          (isAiLoading\\n            ? \'Translating this merged pull request for the community...\'\\n            : `Reviewed and merged into the project by @${p.userLogin}.`),\\n        category: tr?.category || \'Merged PR\',\\n        rawTitle: p.title,\\n        rawCodeLabel: `PR #${p.number}`,\\n        author: p.userLogin,\\n        authorAvatar: p.userAvatar,\\n        timestamp: p.mergedAt,\\n        url: p.htmlUrl,\\n        isTranslated: Boolean(tr),\\n      };\\n    });\\n\\n    return [...prEntries, ...commitEntries].sort(\\n      (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()\\n    );\\n  }, [snapshot, digest, isAiLoading]);\\n\\n  const filteredEntries = useMemo(() => {\\n    const q = query.trim().toLowerCase();\\n    return entries.filter((item) => {\\n      if (activeTab === \'commits\' && item.kind !== \'commit\') return false;\\n      if (activeTab === \'prs\' && item.kind !== \'pr\') return false;\\n      if (!q) return true;\\n      return (\\n        item.plainTitle.toLowerCase().includes(q) ||\\n        item.whyItMatters.toLowerCase().includes(q) ||\\n        item.rawTitle.toLowerCase().includes(q) ||\\n        item.author.toLowerCase().includes(q)\\n      );\\n    });\\n  }, [entries, activeTab, query]);\\n\\n  return (\\n    <section id=\\\"updates\\\" className=\\\"grid grid-cols-1 gap-6 lg:grid-cols-12 items-start\\\">\\n      {/* Left Column: Latest Release Notes Spotlight */}\\n      <div className=\\\"rounded-3xl border border-slate-200 bg-white p-6 lg:col-span-5\\\">\\n        <div className=\\\"flex items-center justify-between gap-3\\\">\\n          <div>\\n            <h2 className=\\\"font-display text-xl font-bold text-[#0F172A]\\\">\\n              Latest Release Notes\\n            </h2>\\n            <p className=\\\"mt-1 text-sm text-slate-600\\\">\\n              Big-picture highlights translated without developer jargon.\\n            </p>\\n          </div>\\n          <Tag className=\\\"h-5 w-5 text-[#FF5A5F] shrink-0\\\" />\\n        </div>\\n\\n        {!latestRelease ? (\\n          <div className=\\\"mt-6 rounded-2xl bg-slate-50 p-6 text-center\\\">\\n            <span className=\\\"text-2xl\\\" aria-hidden=\\\"true\\\">\\n              \360\237\214\261\\n            </span>\\n            <h3 className=\\\"mt-2 font-display text-base font-bold text-[#0F172A]\\\">\\n              No tagged releases published yet\\n            </h3>\\n            <p className=\\\"mt-1 text-sm text-slate-600\\\">\\n              This community ships continuously via commits and pull requests\342\200\224check the live feed\\n              right next door!\\n            </p>\\n          </div>\\n        ) : (\\n          <div className=\\\"mt-5\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs font-medium text-slate-500\\\">\\n              <span className=\\\"font-mono font-semibold text-[#FF5A5F]\\\">\\n                {latestRelease.tagName}\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>Published {formatShortDate(latestRelease.publishedAt)}</span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>by @{latestRelease.authorLogin}</span>\\n            </div>\\n\\n            {isAiLoading && !releaseAi ? (\\n              <div className=\\\"mt-4 space-y-3 animate-pulse\\\">\\n                <div className=\\\"h-6 w-3/4 rounded-lg bg-slate-100\\\" />\\n                <div className=\\\"h-4 w-full rounded-lg bg-slate-100\\\" />\\n                <div className=\\\"h-4 w-5/6 rounded-lg bg-slate-100\\\" />\\n              </div>\\n            ) : (\\n              <>\\n                <h3 className=\\\"mt-3 font-display text-lg font-bold text-[#0F172A]\\\">\\n                  {releaseAi?.cheerfulTitle || latestRelease.name}\\n                </h3>\\n                <p className=\\\"mt-2 text-sm leading-relaxed text-slate-600\\\">\\n                  {releaseAi?.summary ||\\n                    latestRelease.body.slice(0, 260) ||\\n                    `New version ${latestRelease.tagName} is out for the community!`}\\n                </p>\\n\\n                {releaseAi && releaseAi.highlights.length > 0 && (\\n                  <ul className=\\\"mt-4 space-y-2.5 border-t border-slate-100 pt-4\\\">\\n                    {releaseAi.highlights.map((hl, idx) => (\\n                      <li key={idx} className=\\\"flex items-start gap-2.5 text-sm text-slate-700\\\">\\n                        <span className=\\\"mt-0.5 text-base shrink-0\\\" aria-hidden=\\\"true\\\">\\n                          {hl.emoji}\\n                        </span>\\n                        <span className=\\\"leading-snug\\\">{hl.text}</span>\\n                      </li>\\n                    ))}\\n                  </ul>\\n                )}\\n              </>\\n            )}\\n\\n            <div className=\\\"mt-5 flex flex-wrap items-center gap-2.5 border-t border-slate-100 pt-4\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() =>\\n                  onAskAboutItem(\\n                    `Break down the latest release ${latestRelease.tagName} (${latestRelease.name}) for a non-technical user. What are the coolest improvements?`,\\n                    `Release ${latestRelease.tagName}`\\n                  )\\n                }\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl bg-[#FF5A5F] px-3.5 py-2 text-xs font-semibold text-white hover:bg-[#E0484D] transition-colors whitespace-nowrap cursor-pointer\\\"\\n              >\\n                <MessageCircle className=\\\"h-3.5 w-3.5\\\" />\\n                <span>Ask AI about {latestRelease.tagName}</span>\\n              </button>\\n\\n              {latestRelease.body && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowRawRelease((v) => !v)}\\n                  className=\\\"inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors whitespace-nowrap cursor-pointer\\\"\\n                >\\n                  <Code2 className=\\\"h-3.5 w-3.5 text-slate-400\\\" />\\n                  <span>{showRawRelease ? \'Hide Raw Notes\' : \'Original Notes\'}</span>\\n                </button>\\n              )}\\n\\n              <a\\n                href={latestRelease.htmlUrl}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noreferrer\\\"\\n                className=\\\"ml-auto inline-flex items-center gap-1 text-xs font-semibold text-[#0D9488] hover:text-[#0F172A] transition-colors whitespace-nowrap\\\"\\n              >\\n                <span>View on GitHub</span>\\n                <ExternalLink className=\\\"h-3.5 w-3.5\\\" />\\n              </a>\\n            </div>\\n\\n            {showRawRelease && latestRelease.body && (\\n              <pre className=\\\"mt-4 max-h-56 overflow-y-auto whitespace-pre-wrap rounded-xl bg-slate-50 p-3.5 font-mono text-xs leading-relaxed text-slate-600 border border-slate-200/80\\\">\\n                {latestRelease.body}\\n              </pre>\\n            )}\\n\\n            {/* Previous Releases Compact List */}\\n            {snapshot.releases.length > 1 && (\\n              <div className=\\\"mt-6 border-t border-slate-100 pt-4\\\">\\n                <p className=\\\"text-xs font-semibold text-slate-500 mb-2.5\\\">Earlier Milestones</p>\\n                <div className=\\\"space-y-2\\\">\\n                  {snapshot.releases.slice(1, 4).map((rel) => (\\n                    <a\\n                      key={rel.id}\\n                      href={rel.htmlUrl}\\n                      target=\\\"_blank\\\"\\n                      rel=\\\"noreferrer\\\"\\n                      className=\\\"flex items-center justify-between gap-3 rounded-xl px-2.5 py-2 -mx-2.5 text-xs hover:bg-slate-50 transition-colors\\\"\\n                    >\\n                      <span className=\\\"font-mono font-semibold text-[#0F172A] truncate\\\">\\n                        {rel.tagName}\\n                      </span>\\n                      <span className=\\\"text-slate-500 shrink-0 tabular-nums\\\">\\n                        {formatRelativeTime(rel.publishedAt)}\\n                      </span>\\n                    </a>\\n                  ))}\\n                </div>\\n              </div>\\n            )}\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Right Column: Jargon-Free Commits & Merged PRs Stream */}\\n      <div className=\\\"rounded-3xl border border-slate-200 bg-white p-6 lg:col-span-7\\\">\\n        <div className=\\\"flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between\\\">\\n          <div>\\n            <h2 className=\\\"font-display text-xl font-bold text-[#0F172A]\\\">\\n              Plain-English Activity Stream\\n            </h2>\\n            <p className=\\\"mt-1 text-sm text-slate-600\\\">\\n              Recent commits and merged PRs simplified so anyone can follow along.\\n            </p>\\n          </div>\\n\\n          {/* Interactive Segmented Filter Tabs */}\\n          <div\\n            role=\\\"tablist\\\"\\n            aria-label=\\\"Filter repository updates\\\"\\n            className=\\\"inline-flex items-center gap-1 self-start rounded-xl bg-slate-100 p-1\\\"\\n          >\\n            {(\\n              [\\n                { id: \'all\', label: \'All\' },\\n                { id: \'prs\', label: `Merged PRs (${snapshot.mergedPRs.length})` },\\n                { id: \'commits\', label: `Commits (${snapshot.commits.slice(0, 10).length})` },\\n              ] as const\\n            ).map((tab) => (\\n              <button\\n                key={tab.id}\\n                role=\\\"tab\\\"\\n                type=\\\"button\\\"\\n                aria-selected={activeTab === tab.id}\\n                onClick={() => setActiveTab(tab.id)}\\n                className={`rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                  activeTab === tab.id\\n                    ? \'bg-white text-[#0F172A] shadow-xs\'\\n                    : \'text-slate-600 hover:text-[#0F172A]\'\\n                }`}\\n              >\\n                {tab.label}\\n              </button>\\n            ))}\\n          </div>\\n        </div>\\n\\n        {/* Search Input */}\\n        <div className=\\\"mt-4 flex items-center gap-2.5 rounded-xl border border-slate-200 bg-[#F8FAFC] px-3.5 py-2 focus-within:border-[#0D9488] focus-within:bg-white transition-colors\\\">\\n          <Search className=\\\"h-4 w-4 text-slate-400 shrink-0\\\" />\\n          <input\\n            type=\\\"text\\\"\\n            value={query}\\n            onChange={(e) => setQuery(e.target.value)}\\n            placeholder=\\\"Filter updates by topic, feature, or contributor...\\\"\\n            aria-label=\\\"Filter recent commits and pull requests\\\"\\n            className=\\\"w-full bg-transparent text-sm text-[#0F172A] placeholder:text-slate-400 focus:outline-none\\\"\\n          />\\n          {query && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setQuery(\'\')}\\n              className=\\\"text-xs font-semibold text-slate-500 hover:text-[#0F172A] cursor-pointer\\\"\\n            >\\n              Clear\\n            </button>\\n          )}\\n        </div>\\n\\n        {/* Entries List (Hairline dividers, zero card-within-card nesting) */}\\n        <div className=\\\"mt-4 divide-y divide-slate-100\\\">\\n          {filteredEntries.length === 0 ? (\\n            <div className=\\\"py-12 text-center\\\">\\n              <p className=\\\"font-display text-base font-bold text-[#0F172A]\\\">\\n                No matching updates found\\n              </p>\\n              <p className=\\\"mt-1 text-sm text-slate-500\\\">\\n                Try switching tabs or clearing your search filter.\\n              </p>\\n            </div>\\n          ) : (\\n            filteredEntries.map((item) => {\\n              const isTechOpen = Boolean(expandedTechIds[item.id]);\\n              return (\\n                <article key={item.id} className=\\\"py-4 first:pt-2 last:pb-1\\\">\\n                  <div className=\\\"flex items-start gap-3.5\\\">\\n                    <div\\n                      className={`mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-lg ${\\n                        item.kind === \'pr\' ? \'bg-[#0D9488]/10\' : \'bg-[#FF5A5F]/10\'\\n                      }`}\\n                    >\\n                      <span aria-hidden=\\\"true\\\">{item.emoji}</span>\\n                    </div>\\n\\n                    <div className=\\\"min-w-0 flex-1\\\">\\n                      <h3 className=\\\"font-display text-[15px] font-bold leading-snug text-[#0F172A]\\\">\\n                        {item.plainTitle}\\n                      </h3>\\n                      <p className=\\\"mt-1 text-sm leading-relaxed text-slate-600\\\">\\n                        {item.whyItMatters}\\n                      </p>\\n\\n                      {/* Clean unboxed metadata row */}\\n                      <div className=\\\"mt-2.5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-slate-500\\\">\\n                        <span className=\\\"inline-flex items-center gap-1 font-medium text-slate-700\\\">\\n                          {item.kind === \'pr\' ? (\\n                            <GitMerge className=\\\"h-3.5 w-3.5 text-[#0D9488]\\\" />\\n                          ) : (\\n                            <GitCommitHorizontal className=\\\"h-3.5 w-3.5 text-[#FF5A5F]\\\" />\\n                          )}\\n                          {item.kind === \'pr\' ? \'Merged PR\' : \'Commit\'}\\n                        </span>\\n                        <span aria-hidden=\\\"true\\\">\302\267</span>\\n                        <span className=\\\"font-medium text-[#0D9488]\\\">{item.category}</span>\\n                        <span aria-hidden=\\\"true\\\">\302\267</span>\\n                        <span>@{item.author}</span>\\n                        <span aria-hidden=\\\"true\\\">\302\267</span>\\n                        <span className=\\\"tabular-nums\\\">{formatRelativeTime(item.timestamp)}</span>\\n                        {item.isTranslated && (\\n                          <>\\n                            <span aria-hidden=\\\"true\\\">\302\267</span>\\n                            <span className=\\\"inline-flex items-center gap-1 text-slate-400\\\">\\n                              <Sparkles className=\\\"h-3 w-3 text-[#F59E0B]\\\" />\\n                              Simplified\\n                            </span>\\n                          </>\\n                        )}\\n                      </div>\\n\\n                      {/* Item Actions */}\\n                      <div className=\\\"mt-2.5 flex flex-wrap items-center gap-3 text-xs\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            onAskAboutItem(\\n                              `Explain this ${item.kind === \'pr\' ? \'merged pull request\' : \'commit\'} in simple terms without any jargon: \\\"${item.rawTitle}\\\" (${item.rawCodeLabel} by @${item.author}). Why does it matter?`,\\n                              item.plainTitle\\n                            )\\n                          }\\n                          className=\\\"inline-flex items-center gap-1 font-semibold text-[#FF5A5F] hover:text-[#E0484D] transition-colors cursor-pointer\\\"\\n                        >\\n                          <MessageCircle className=\\\"h-3.5 w-3.5\\\" />\\n                          <span>Explain with AI</span>\\n                        </button>\\n\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => toggleTechDetails(item.id)}\\n                          className=\\\"inline-flex items-center gap-1 font-medium text-slate-500 hover:text-[#0F172A] transition-colors cursor-pointer\\\"\\n                        >\\n                          {isTechOpen ? (\\n                            <ChevronUp className=\\\"h-3.5 w-3.5\\\" />\\n                          ) : (\\n                            <ChevronDown className=\\\"h-3.5 w-3.5\\\" />\\n                          )}\\n                          <span>{isTechOpen ? \'Hide Technical Title\' : \'See Technical Title\'}</span>\\n                        </button>\\n\\n                        <a\\n                          href={item.url}\\n                          target=\\\"_blank\\\"\\n                          rel=\\\"noreferrer\\\"\\n                          className=\\\"inline-flex items-center gap-1 font-medium text-slate-500 hover:text-[#0D9488] transition-colors\\\"\\n                        >\\n                          <span className=\\\"font-mono\\\">{item.rawCodeLabel}</span>\\n                          <ExternalLink className=\\\"h-3 w-3\\\" />\\n                        </a>\\n                      </div>\\n\\n                      {isTechOpen && (\\n                        <div className=\\\"mt-2.5 rounded-xl bg-slate-50 px-3 py-2 font-mono text-xs text-slate-600 border border-slate-200/70\\\">\\n                          {item.rawTitle}\\n                        </div>\\n                      )}\\n                    </div>\\n                  </div>\\n                </article>\\n              );\\n            })\\n          )}\\n        </div>\\n      </div>\\n    </section>\\n  );\\n}\\n\", \"Description\":\"Create ActivityFeed with plain-English release notes spotlight, segmented commit/PR filters, live search, technical title toggle, and Ask AI triggers.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ActivityFeed.tsx\"}"
      thinking_signature: "\022\374\021\n\371\021\001i\024}\023\252H\215q\a\273\225\265\377\345t\212\n6\t\344c\301\307(\235t\312\263\353\357\f\360\344\210\326\231\321\215{%\321[Qj\301\331\004S\022z-7\215Yf\222%\305\225\241\265\260Oa\b\n\016\357\1776ib\225W\246ca\330p\312\250v\ay\335\275<\206\336a\000\005K\340\307\246L[F@\204\314\206\303\020\211{ \216\0232\001\'\253\024\t\237\000r\333\316\fO(\332\250IG\005\202\316;8JO\255\323\036\377\370\263\335\273@\206\327\205\300\334\206x8\313\225\375Mo\b+\327\304\fX\341\200R\373v\nZF\376\216ju\217J.D;\252\211\265T:\354\274\352H\242\311\303F\372(\3335\234\365!\267\267\277|k\322\363\351\243\311,\000?\262I\024\275\032PD\377\230\266\306~S\3612dC(\\\264\333\200\004\237\346\276\263L\334m\216\313\341\255\231y-\273\204\215n\312~\274/\337O\252F\341\352\"~\235\227[\302\227\270\265\260\360bI\277\247\255\n\234\341&\332\311\340y (\032`\251JU\300\031\030\262<-\2325 \333\374\215l\351\021\223\177\332\230\324\310\02514n\222}\366\355\330\262\035\236\230\312\337^\225\277\203\241\342g\252\310k/\335H]\251\240\244.sq&\034\024Hv\302\317\342\333s\272sH\t[\2443\350\371w\020s}\225\214c\262?\215\032Vr\322\220~\377tw\331\315\022\222\211\313\200\310N\327\322\373\313\020)=\267S\357:\343\345\250Y\215\024\316BI)\330m^<@Io61\330\315;\242\000\277\364\236\267\352Y\320*\324\b\265F\241\241\244K \233g!\300\210o\003\304r\027\2635\001\213\230$\257\275\365\234\205h6\033\343\225\033F\352/\316gZ\314,\037\275\372\026.f\322l\037w\274\220\326\207I\372\002\030\313\004X\211\327\215\3419$\211/\273\035\fl\241\025\016\2175N[\323\202\\\302\2056F\302\331\365\2620\331\245s|%\203M8\327\336\263\353\033}\226+\256[-IsKh.\204\020\322\340\2373\335\345\361\367\253\377\214\364\346\r\271VN,\034\210I\357\247\334\327\302\355\354\\\263K\202\302|o\231KH\325G\241\307\rN/\027\036L\243\0234\325\363\300\215\025\227\371\017\210E\311c\330k\f\347\231\023Es\356\t\241~\260\233y\317\243\314\211\204\300x\033\353o;S\271\036\235\2513F\215\331\034\242\003jC%\334\030\237\377-\260\\\356\375\203\220\351\236\363\rF/\303Kw\260\354\003\344\336\262m\265[_\016\246Q\002\310\006\322\364\371b\200N\332g\367K\207\267\251K\313\342X\260\325\224%\367#\217\345e\206\322\376\f\rm\276\205\217\304\337\212\315\037\243/I\320\031\263\375\214\242\367\v\371\342\263?\370\366)\346\036}h?\253a\307\217\345I\255\310\004\310\363\225V\036QCE\233\337\274\253r\247\256\325pE\253\206\036\033m<\231\304jT\356=\b0\342v`\270^\t\364+\253\307 \234\235\352ui1<!\313\251\363\361\2517\276\317\023\2508A\205B\253\3776|\336\364\373\303\357nQ\362s\027\222\225\334f\373H\225\211<`\322\377l\225\361X\332\341i\250\313\225\372\224\351L\300\225c\355\323\r(.\350*\324\260\322B\036\020|H\325 \331\262cS\024\267\332\240\033S\214\030\251\t%[\240k\vAu\276\316\302\226\313\"\265\033\3303\342\035\213\374\256\004\032\255\337L$\210I\320w\215g\205\335{\n\226~\3646\fo\361\233\247\235\211\275\2047}\303\2522\027\006\237l\221\255~H\211V\266\245\315\301\214Bta\377\262\216FMj\032%\314\310LK\311\032o<\315\210\362\244\231\3637G\344\326?[\274\002\265x]1\331\364\n1\263?\216:\242\230\335\0160\305\301\025\322\312\254Q\216\263\3370<\321i5\230+\003\345Lk\353`$\352\356NL\230zirJJ\317a\365L\027\364\243\274\272\357\301]P\343\252\363%\210\262\213\027\217\f\"\324#[\324\377\035\222\352a\314\374x*\177\203J\021\315h\220g\2336 \352E\250\317B\206\264\212[\320\365[\375a\361\017\267t\223\303\241\354P \217\306\253\214\365}z\003{\233|\300\210\031\330j\371\333\024yF \"R\'L\320\354?1\v\346\035\026=.$\367j-\331\351\213\347\304\321\377:\351PG#E\367ge\2078\372\250\214\001,\357LiZ\3420\f\237\257\353\2756j\006\231\316\030\336\333\256\262d\266V\220\231\311.\251l\256f\374\335\312]&\002\024\035:l6\335a\333\205\310\000w \216\320GU~H\257\306\333\221\2229\277*+\240\337V\233\207\0317\242Z\027\263\'\303\354\310\261\"\246\331\323\274K1w,0\357\352@i`c_x\346\254]\305;\223\300\237m\314\221+(\a\267Xx\307!\263\335q\356\273\367\300\2275\252\326\002F\345\264u\231,F\304\247U\266\300+_\310h\252:g\203\3311\001UD\334,3=\221\326\263\202\260\265e\'\265\266O\370>h*g4Y7\373\f\356\2653\306\025W>\210QT\025\327\2407\027\324\363\363\030=\000\240\031\026\306\275\017KBb\341\231*\264\334],\351\353\377\252S\202\0049N\212yY\n\300\222\327\372\247\002\206\247\255\317\250+\320hi\032\003\254\2308\3106\032\312\204v\b\3029\357Kpo\nj/\257\250\315Q\274W\254.I\250F\322\n!\006\270=\336\310\031\333r\361\373\036\323\'\262\035I\303\343\b\032\357I\233m@)\v\002P\214\351][\347\000\026x\021\263\021\270\374\357v*\264;\205\032\257x\\\225\033#Z@\246\017\360\021\031`\364+\025\370\341\006\346l\377z\240\217+&\021Z\f\313\216\016=v\030\207\356\3523\235qFm\\J\300\"8R\027\202d\227.\233\253\'$\a\025Ua\255\247\361q\222fA\272\362Cn\265L8*$\211(\004\243\313\006\221\347\262\307\213\355x\356\037\302__\016u\266sK\355!\307xu\025\n=u\3131LS\250\037\316k\336)\353=\313\274\311e\241T\302m@\251\r\227\271\016\203\226OJ\226\316a\257dV$\301\355\242\345\360\365\t\253\376nYY\2615\326\356f\f\242\244\366i\367\372\325\343\317:i\334b\032\345\001\321+\224,\202\370\212&\331Z7\377\000\342\316\252\270x|\303{\271\214\311?D\210!\320\365\376hM\026I,\016\320\306\370\3201\341\342\351i9>f\335>/!\336\363\372\302\320 3QZ\360<\364~\201I\301-8\333\302jI\376\350\363.\2058\377-RD>\346\374\334\236\'\371\237]\t\347VH\b\3134yo\271{Man\356\357\037\204\221\030\205R\212\3630\277\3314r2\271\337\322\314-\262\200\205\325\036A\034\'i\374l\202\270\2717\220z0O!\351\000\214\226\vIAEo0\274\254\316\342\314\f\312\n\245\024\240_\377\376\2651\340\022\320\001\372\274\243\220\272\313R\306dQ\307\353\333C28Rb\275\226\366\231q!B8p\307\210\215\333\3411^\246\376\327s\023M\254R7=\271\004\334\351\254w\265r\017\354\027\311\304\232;\225G\367\364\"\213\372-?W\t\226\305\3412\371\336i\207\377\n\274\225\261\260?\262\263\n\"\204\355#K\352\357?\324&\033P\202K\323\310\235zE\244w\006\370\333\341\227\204\307t\267\035\206\304S+\322\370\036\222\277v\255\230\251\343\367\254fq\005\a\364\342q\033\2165\203\242\343\265*{X\277V\266\315\225aA\035\306\300$.\025\021\277\276^pu\274iP\205(x\3527\232/\026\037\202D\355\333\233N_\317\001\230\245e\326Xb:\221\337J!\321\321o\207{\177g\311\242>\357\272\275C\317\257\275\307\272\203#/\002\2733x({\227s\307_j\320\202\321\361\314>\243\250%/x\035x\315\025`G\310\276\364\303\336\267%\320S\320\'G1\310\336b\325\263x\357VjRe\307e\320\2243\357T\327\361\210\036\a8\336?\0027\016I\363\002\253\037x\212\032\313#\002l\023kR\344\001\fv\343j\207\332\364\312\342W<\324\021r\334n\032\227{\"X+\'n\325\006\006Q2\251K\300\025\303\361:\371\341\266pf\tb\217[ \213\346\2076\312\021\323\204FV\301|\264}.\370\361\360\267abn\202\330\036\240\037\226\000(.\030i\032C6\030\305\037z`\256"
      original_name: "write_to_file"
