    tool_calls {
      id: "call_16442137170944377341"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useRef, useState, type FormEvent } from \'react\';\\nimport { AnimatePresence, motion } from \'motion/react\';\\nimport { MessageCircle, RotateCcw, Send, Sparkles, X } from \'lucide-react\';\\nimport type { AiDigest, ChatMessage, RepoSnapshot } from \'../types\';\\n\\ninterface CommunityChatDrawerProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  snapshot: RepoSnapshot;\\n  digest: AiDigest | null;\\n  pendingPrompt: { text: string; contextLabel: string; seq: number } | null;\\n}\\n\\nconst STARTER_QUESTIONS = [\\n  \\\"What\'s the biggest win in this repo recently?\\\",\\n  \'Explain the latest release like I am brand new to tech\',\\n  \'What are contributors working hardest on right now?\',\\n  \'Is this project healthy and moving fast?\',\\n];\\n\\nfunction renderFormattedText(content: string) {\\n  const lines = content.split(\'\\\\n\');\\n  return lines.map((line, idx) => {\\n    const trimmed = line.trim();\\n    if (!trimmed) return <div key={idx} className=\\\"h-2\\\" />;\\n\\n    // Format bold **text** cleanly\\n    const parts = line.split(/(\\\\*\\\\*[^*]+\\\\*\\\\*)/g).map((part, pIdx) => {\\n      if (part.startsWith(\'**\') && part.endsWith(\'**\')) {\\n        return (\\n          <strong key={pIdx} className=\\\"font-semibold text-[#0F172A]\\\">\\n            {part.slice(2, -2)}\\n          </strong>\\n        );\\n      }\\n      return <span key={pIdx}>{part}</span>;\\n    });\\n\\n    if (trimmed.startsWith(\'- \') || trimmed.startsWith(\'* \')) {\\n      return (\\n        <div key={idx} className=\\\"flex items-start gap-2 pl-1 my-1\\\">\\n          <span className=\\\"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#0D9488]\\\" />\\n          <p className=\\\"leading-relaxed\\\">{parts.map((el, i) => (i === 0 && typeof el.props.children === \'string\' ? el.props.children.replace(/^[-*]\\\\s+/, \'\') : el))}</p>\\n        </div>\\n      );\\n    }\\n\\n    return (\\n      <p key={idx} className=\\\"leading-relaxed\\\">\\n        {parts}\\n      </p>\\n    );\\n  });\\n}\\n\\nexport function CommunityChatDrawer({\\n  isOpen,\\n  onClose,\\n  snapshot,\\n  digest,\\n  pendingPrompt,\\n}: CommunityChatDrawerProps) {\\n  const [messages, setMessages] = useState<ChatMessage[]>([]);\\n  const [input, setInput] = useState(\'\');\\n  const [isStreaming, setIsStreaming] = useState(false);\\n  const [chatError, setChatError] = useState<string | null>(null);\\n  const scrollEndRef = useRef<HTMLDivElement | null>(null);\\n  const lastHandledSeqRef = useRef<number>(0);\\n\\n  // Reset chat cleanly when switching to a different repository\\n  useEffect(() => {\\n    setMessages([\\n      {\\n        id: `welcome-${snapshot.repo.fullName}`,\\n        role: \'assistant\',\\n        content: `Hey there! \360\237\221\213 I\'m your PulseIsle tour guide for **${snapshot.repo.fullName}**. Ask me anything about recent commits, merged pull requests, release highlights, or how this project\'s development cycle works\342\200\224no tech jargon required!`,\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      },\\n    ]);\\n    setChatError(null);\\n  }, [snapshot.repo.fullName]);\\n\\n  // Auto-scroll on new tokens\\n  useEffect(() => {\\n    scrollEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\\n  }, [messages, isStreaming]);\\n\\n  const sendMessage = async (text: string, contextLabel?: string) => {\\n    const clean = text.trim();\\n    if (!clean || isStreaming) return;\\n\\n    setChatError(null);\\n    const nowLabel = new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' });\\n    const userMsg: ChatMessage = {\\n      id: `user-${Date.now()}`,\\n      role: \'user\',\\n      content: clean,\\n      timestamp: nowLabel,\\n      contextLabel,\\n    };\\n    const assistantId = `assistant-${Date.now() + 1}`;\\n    const placeholderAssistant: ChatMessage = {\\n      id: assistantId,\\n      role: \'assistant\',\\n      content: \'\',\\n      timestamp: nowLabel,\\n    };\\n\\n    const nextHistory = [...messages, userMsg];\\n    setMessages([...nextHistory, placeholderAssistant]);\\n    setInput(\'\');\\n    setIsStreaming(true);\\n\\n    try {\\n      const resp = await fetch(\'/api/ai/chat\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          snapshot,\\n          digest,\\n          messages: nextHistory.map((m) => ({ role: m.role, content: m.content })),\\n        }),\\n      });\\n\\n      if (!resp.ok) {\\n        const errBody = (await resp.json().catch(() => ({}))) as { error?: string };\\n        throw new Error(errBody.error || `Chat server returned ${resp.status}`);\\n      }\\n\\n      const reader = resp.body?.getReader();\\n      if (!reader) {\\n        throw new Error(\'Streaming connection unavailable.\');\\n      }\\n\\n      const decoder = new TextDecoder();\\n      let buffer = \'\';\\n\\n      while (true) {\\n        const { done, value } = await reader.read();\\n        if (done) break;\\n        buffer += decoder.decode(value, { stream: true });\\n        const events = buffer.split(\'\\\\n\\\\n\');\\n        buffer = events.pop() || \'\';\\n\\n        for (const ev of events) {\\n          const line = ev.trim();\\n          if (!line.startsWith(\'data:\')) continue;\\n          const payload = line.slice(5).trim();\\n          if (payload === \'[DONE]\') continue;\\n          try {\\n            const parsed = JSON.parse(payload) as { text?: string; error?: string };\\n            if (parsed.error) {\\n              throw new Error(parsed.error);\\n            }\\n            if (parsed.text) {\\n              setMessages((prev) =>\\n                prev.map((m) =>\\n                  m.id === assistantId ? { ...m, content: m.content + parsed.text } : m\\n                )\\n              );\\n            }\\n          } catch (parseErr) {\\n            if (parseErr instanceof Error && parseErr.message !== \'Unexpected end of JSON input\') {\\n              throw parseErr;\\n            }\\n          }\\n        }\\n      }\\n    } catch (err: unknown) {\\n      const errMsg = err instanceof Error ? err.message : \'Something went wrong while chatting.\';\\n      setChatError(errMsg);\\n      setMessages((prev) => prev.filter((m) => m.id !== assistantId || m.content.length > 0));\\n    } finally {\\n      setIsStreaming(false);\\n    }\\n  };\\n\\n  // Handle \\\"Explain with AI\\\" triggers from commits, releases, or 3D landmarks\\n  useEffect(() => {\\n    if (\\n      isOpen &&\\n      pendingPrompt &&\\n      pendingPrompt.seq > lastHandledSeqRef.current &&\\n      !isStreaming\\n    ) {\\n      lastHandledSeqRef.current = pendingPrompt.seq;\\n      void sendMessage(pendingPrompt.text, pendingPrompt.contextLabel);\\n    }\\n  }, [isOpen, pendingPrompt, isStreaming]);\\n\\n  const handleSubmit = (e: FormEvent) => {\\n    e.preventDefault();\\n    void sendMessage(input);\\n  };\\n\\n  const handleReset = () => {\\n    setMessages([\\n      {\\n        id: `reset-${Date.now()}`,\\n        role: \'assistant\',\\n        content: `Fresh chat started for **${snapshot.repo.fullName}**! \360\237\214\237 What part of the project journey would you like explained?`,\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      },\\n    ]);\\n    setChatError(null);\\n  };\\n\\n  return (\\n    <AnimatePresence>\\n      {isOpen && (\\n        <>\\n          {/* Subtle backdrop on mobile & desktop */}\\n          <motion.div\\n            initial={{ opacity: 0 }}\\n            animate={{ opacity: 1 }}\\n            exit={{ opacity: 0 }}\\n            onClick={onClose}\\n            className=\\\"fixed inset-0 z-40 bg-slate-900/25\\\"\\n          />\\n\\n          <motion.aside\\n            role=\\\"dialog\\\"\\n            aria-label=\\\"Community AI Chat Guide\\\"\\n            initial={{ x: \'100%\' }}\\n            animate={{ x: 0 }}\\n            exit={{ x: \'100%\' }}\\n            transition={{ duration: 0.25, ease: [0.16, 1, 0.3, 1] }}\\n            className=\\\"fixed top-0 right-0 z-50 flex h-full w-full max-w-md flex-col border-l border-slate-200 bg-white shadow-2xl\\\"\\n          >\\n            {/* Header */}\\n            <div className=\\\"flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4\\\">\\n              <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n                <div className=\\\"flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FF5A5F]/12 text-[#FF5A5F]\\\">\\n                  <MessageCircle className=\\\"h-5 w-5\\\" />\\n                </div>\\n                <div className=\\\"min-w-0\\\">\\n                  <h2 className=\\\"font-display text-base font-bold text-[#0F172A] truncate\\\">\\n                    PulseIsle AI Guide\\n                  </h2>\\n                  <p className=\\\"text-xs text-slate-500 truncate\\\">\\n                    Grounded in {snapshot.repo.fullName}\\n                  </p>\\n                </div>\\n              </div>\\n              <div className=\\\"flex items-center gap-1 shrink-0\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleReset}\\n                  title=\\\"Start fresh conversation\\\"\\n                  aria-label=\\\"Reset chat\\\"\\n                  className=\\\"rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-[#0F172A] transition-colors cursor-pointer\\\"\\n                >\\n                  <RotateCcw className=\\\"h-4 w-4\\\" />\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onClose}\\n                  aria-label=\\\"Close AI chat\\\"\\n                  className=\\\"rounded-lg p-2 text-slate-500 hover:bg-slate-100 hover:text-[#0F172A] transition-colors cursor-pointer\\\"\\n                >\\n                  <X className=\\\"h-5 w-5\\\" />\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* Messages Area */}\\n            <div className=\\\"flex-1 overflow-y-auto px-5 py-4 space-y-4 bg-[#F8FAFC]\\\">\\n              {messages.map((msg) => {\\n                const isUser = msg.role === \'user\';\\n                return (\\n                  <div\\n                    key={msg.id}\\n                    className={`flex flex-col ${isUser ? \'items-end\' : \'items-start\'}`}\\n                  >\\n                    {msg.contextLabel && (\\n                      <span className=\\\"mb-1 text-[11px] font-medium text-[#0D9488]\\\">\\n                        Asking about: {msg.contextLabel}\\n                      </span>\\n                    )}\\n                    <div\\n                      className={`max-w-[88%] rounded-2xl px-4 py-3 text-sm ${\\n                        isUser\\n                          ? \'bg-[#0F172A] text-white\'\\n                          : \'border border-slate-200 bg-white text-slate-700\'\\n                      }`}\\n                    >\\n                      {msg.content ? (\\n                        isUser ? (\\n                          <p className=\\\"leading-relaxed\\\">{msg.content}</p>\\n                        ) : (\\n                          <div className=\\\"space-y-1\\\">{renderFormattedText(msg.content)}</div>\\n                        )\\n                      ) : (\\n                        <div className=\\\"flex items-center gap-2 text-xs text-slate-500\\\">\\n                          <Sparkles className=\\\"h-3.5 w-3.5 text-[#FF5A5F]\\\" />\\n                          <span>Reading repo activity...</span>\\n                        </div>\\n                      )}\\n                    </div>\\n                    <span className=\\\"mt-1 px-1 text-[10px] font-mono text-slate-400\\\">\\n                      {msg.timestamp}\\n                    </span>\\n                  </div>\\n                );\\n              })}\\n\\n              {chatError && (\\n                <div\\n                  role=\\\"alert\\\"\\n                  className=\\\"rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-700\\\"\\n                >\\n                  <p className=\\\"font-semibold\\\">Couldn&apos;t reach the AI guide</p>\\n                  <p className=\\\"mt-0.5\\\">{chatError}</p>\\n                </div>\\n              )}\\n\\n              {/* Quick Starter Question Buttons */}\\n              {messages.length <= 2 && !isStreaming && (\\n                <div className=\\\"pt-2\\\">\\n                  <p className=\\\"mb-2 text-xs font-semibold text-slate-500\\\">\\n                    Try asking one of these:\\n                  </p>\\n                  <div className=\\\"flex flex-col gap-2\\\">\\n                    {STARTER_QUESTIONS.map((q) => (\\n                      <button\\n                        key={q}\\n                        type=\\\"button\\\"\\n                        onClick={() => void sendMessage(q)}\\n                        className=\\\"rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-left text-xs font-medium text-slate-700 hover:border-[#0D9488] hover:text-[#0F172A] transition-colors cursor-pointer\\\"\\n                      >\\n                        {q}\\n                      </button>\\n                    ))}\\n                  </div>\\n                </div>\\n              )}\\n\\n              <div ref={scrollEndRef} />\\n            </div>\\n\\n            {/* Composer */}\\n            <form\\n              onSubmit={handleSubmit}\\n              className=\\\"border-t border-slate-200 bg-white p-4\\\"\\n            >\\n              <div className=\\\"flex items-center gap-2 rounded-2xl border border-slate-200 bg-[#F8FAFC] p-1.5 focus-within:border-[#FF5A5F] focus-within:bg-white transition-colors\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  value={input}\\n                  onChange={(e) => setInput(e.target.value)}\\n                  placeholder=\\\"Ask about commits, releases, or dev terms...\\\"\\n                  aria-label=\\\"Ask PulseIsle AI a question\\\"\\n                  disabled={isStreaming}\\n                  className=\\\"flex-1 bg-transparent px-3 py-2 text-sm text-[#0F172A] placeholder:text-slate-400 focus:outline-none\\\"\\n                />\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={isStreaming || !input.trim()}\\n                  aria-label=\\\"Send question\\\"\\n                  className=\\\"inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#FF5A5F] text-white hover:bg-[#E0484D] disabled:opacity-45 transition-colors cursor-pointer\\\"\\n                >\\n                  <Send className=\\\"h-4 w-4\\\" />\\n                </button>\\n              </div>\\n            </form>\\n          </motion.aside>\\n        </>\\n      )}\\n    </AnimatePresence>\\n  );\\n}\\n\", \"Description\":\"Create streaming SSE CommunityChatDrawer grounded in the active repository snapshot with starter questions and mobile/desktop responsiveness.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/CommunityChatDrawer.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16442137170944378970"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useCallback, useEffect, useRef, useState, type FormEvent } from \'react\';\\nimport { motion } from \'motion/react\';\\nimport {\\n  ArrowLeft,\\n  Bell,\\n  BellRing,\\n  ExternalLink,\\n  GitFork,\\n  MessageCircle,\\n  PartyPopper,\\n  Pause,\\n  Play,\\n  RefreshCw,\\n  Search,\\n  Sparkles,\\n  Star,\\n  AlertCircle,\\n} from \'lucide-react\';\\nimport type { AiDigest, MilestoneAlert, RepoSnapshot } from \'./types\';\\nimport {\\n  formatCompactNumber,\\n  formatRelativeTime,\\n  normalizeRepoInput,\\n} from \'./utils/format\';\\nimport { RepoLauncher } from \'./components/RepoLauncher\';\\nimport { FloatingIsland3D } from \'./components/FloatingIsland3D\';\\nimport { VelocityAndContributors } from \'./components/VelocityAndContributors\';\\nimport { ActivityFeed } from \'./components/ActivityFeed\';\\nimport { CommunityChatDrawer } from \'./components/CommunityChatDrawer\';\\nimport {\\n  getBrowserNotificationState,\\n  NotificationToastStack,\\n  requestBrowserNotifications,\\n  sendBrowserPushNotification,\\n  type BrowserNotificationState,\\n} from \'./components/NotificationCenter\';\\n\\nconst SYNC_INTERVAL_SECONDS = 60;\\nconst RECENT_REPOS_STORAGE_KEY = \'pulseisle_recent_repos_v1\';\\n\\nfunction loadRecentRepos(): string[] {\\n  try {\\n    const raw = localStorage.getItem(RECENT_REPOS_STORAGE_KEY);\\n    if (!raw) return [];\\n    const parsed = JSON.parse(raw);\\n    return Array.isArray(parsed) ? parsed.slice(0, 5) : [];\\n  } catch {\\n    return [];\\n  }\\n}\\n\\nfunction saveRecentRepo(fullName: string): string[] {\\n  const existing = loadRecentRepos().filter(\\n    (r) => r.toLowerCase() !== fullName.toLowerCase()\\n  );\\n  const next = [fullName, ...existing].slice(0, 5);\\n  try {\\n    localStorage.setItem(RECENT_REPOS_STORAGE_KEY, JSON.stringify(next));\\n  } catch {\\n    // Ignore storage restrictions\\n  }\\n  return next;\\n}\\n\\nexport default function App() {\\n  const [recentRepos, setRecentRepos] = useState<string[]>(() => loadRecentRepos());\\n  const [snapshot, setSnapshot] = useState<RepoSnapshot | null>(null);\\n  const [digest, setDigest] = useState<AiDigest | null>(null);\\n  const [isLoadingRepo, setIsLoadingRepo] = useState(false);\\n  const [isLoadingAi, setIsLoadingAi] = useState(false);\\n  const [isSyncing, setIsSyncing] = useState(false);\\n  const [repoError, setRepoError] = useState<string | null>(null);\\n  const [aiError, setAiError] = useState<string | null>(null);\\n\\n  // Quick switcher inline form inside dashboard\\n  const [switcherOpen, setSwitcherOpen] = useState(false);\\n  const [switcherInput, setSwitcherInput] = useState(\'\');\\n  const [switcherError, setSwitcherError] = useState<string | null>(null);\\n\\n  // Real-time 60s auto-sync & notifications state\\n  const [autoSyncEnabled, setAutoSyncEnabled] = useState(true);\\n  const [secondsToSync, setSecondsToSync] = useState(SYNC_INTERVAL_SECONDS);\\n  const [notifState, setNotifState] = useState<BrowserNotificationState>(() =>\\n    getBrowserNotificationState()\\n  );\\n  const [alerts, setAlerts] = useState<MilestoneAlert[]>([]);\\n  const [celebrationSignal, setCelebrationSignal] = useState(0);\\n\\n  // Interactive Community AI Chat state\\n  const [chatOpen, setChatOpen] = useState(false);\\n  const [pendingChatPrompt, setPendingChatPrompt] = useState<{\\n    text: string;\\n    contextLabel: string;\\n    seq: number;\\n  } | null>(null);\\n\\n  // Track latest commit SHA & release tag to detect real new milestones during auto-sync\\n  const lastSeenRef = useRef<{\\n    repo: string;\\n    commitSha: string | null;\\n    releaseTag: string | null;\\n    prNumber: number | null;\\n  }>({\\n    repo: \'\',\\n    commitSha: null,\\n    releaseTag: null,\\n    prNumber: null,\\n  });\\n\\n  const pushMilestoneAlert = useCallback(\\n    (alert: Omit<MilestoneAlert, \'id\' | \'timestamp\'>, triggerCelebration = true) => {\\n      const id = `alert-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`;\\n      const timestamp = new Date().toLocaleTimeString([], {\\n        hour: \'2-digit\',\\n        minute: \'2-digit\',\\n      });\\n      const entry: MilestoneAlert = { ...alert, id, timestamp };\\n      setAlerts((prev) => [entry, ...prev].slice(0, 3));\\n      if (triggerCelebration) {\\n        setCelebrationSignal((n) => n + 1);\\n      }\\n      sendBrowserPushNotification(`${alert.emoji} ${alert.title}`, alert.body);\\n\\n      window.setTimeout(() => {\\n        setAlerts((prev) => prev.filter((a) => a.id !== id));\\n      }, 8500);\\n    },\\n    []\\n  );\\n\\n  const dismissAlert = useCallback((id: string) => {\\n    setAlerts((prev) => prev.filter((a) => a.id !== id));\\n  }, []);\\n\\n  const fetchAiSummary = useCallback(async (repoSnap: RepoSnapshot) => {\\n    setIsLoadingAi(true);\\n    setAiError(null);\\n    try {\\n      const resp = await fetch(\'/api/ai/summarize\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ snapshot: repoSnap }),\\n      });\\n      const data = (await resp.json()) as AiDigest & { error?: string };\\n      if (!resp.ok) {\\n        throw new Error(data.error || \'Could not generate AI summary.\');\\n      }\\n      setDigest(data);\\n    } catch (err: unknown) {\\n      setAiError(err instanceof Error ? err.message : \'AI summary temporarily unavailable.\');\\n    } finally {\\n      setIsLoadingAi(false);\\n    }\\n  }, []);\\n\\n  const loadRepository = useCallback(\\n    async (repoInput: string, options?: { isBackgroundSync?: boolean }) => {\\n      const isBg = Boolean(options?.isBackgroundSync);\\n      if (isBg) {\\n        setIsSyncing(true);\\n      } else {\\n        setIsLoadingRepo(true);\\n        setRepoError(null);\\n        setAiError(null);\\n      }\\n\\n      try {\\n        const url = `/api/github/repo?repo=${encodeURIComponent(repoInput)}${isBg ? \'&sync=1\' : \'\'}`;\\n        const resp = await fetch(url);\\n        const data = (await resp.json()) as RepoSnapshot & { error?: string };\\n\\n        if (!resp.ok) {\\n          throw new Error(data.error || \'Failed to load repository.\');\\n        }\\n\\n        const latestSha = data.commits[0]?.sha || null;\\n        const latestTag = data.releases[0]?.tagName || null;\\n        const latestPr = data.mergedPRs[0]?.number || null;\\n\\n        const prev = lastSeenRef.current;\\n        const isSameRepo = prev.repo.toLowerCase() === data.repo.fullName.toLowerCase();\\n\\n        // Check for real new activity on background sync!\\n        if (isBg && isSameRepo) {\\n          let detectedNewActivity = false;\\n          if (latestTag && prev.releaseTag && latestTag !== prev.releaseTag) {\\n            detectedNewActivity = true;\\n            pushMilestoneAlert({\\n              type: \'release\',\\n              emoji: \'\360\237\232\200\',\\n              title: `New Release ${latestTag} Shipped!`,\\n              body: `${data.repo.name} just published ${latestTag}. Refreshing your plain-English highlights now!`,\\n            });\\n          } else if (latestPr && prev.prNumber && latestPr !== prev.prNumber) {\\n            detectedNewActivity = true;\\n            pushMilestoneAlert({\\n              type: \'pr\',\\n              emoji: \'\360\237\216\211\',\\n              title: `Fresh PR #${latestPr} Merged!`,\\n              body: `${data.mergedPRs[0].title} just landed in ${data.repo.name}.`,\\n            });\\n          } else if (latestSha && prev.commitSha && latestSha !== prev.commitSha) {\\n            detectedNewActivity = true;\\n            pushMilestoneAlert({\\n              type: \'commit\',\\n              emoji: \'\342\232\241\',\\n              title: `New Commit Landed in ${data.repo.name}`,\\n              body: `@${data.commits[0].authorLogin} pushed: \\\"${data.commits[0].firstLine}\\\"`,\\n            });\\n          }\\n\\n          setSnapshot(data);\\n          if (detectedNewActivity) {\\n            void fetchAiSummary(data);\\n          }\\n        } else {\\n          // Fresh repository load\\n          setSnapshot(data);\\n          setDigest(null);\\n          setSwitcherOpen(false);\\n          setSwitcherInput(\'\');\\n          setSwitcherError(null);\\n          setRecentRepos(saveRecentRepo(data.repo.fullName));\\n          void fetchAiSummary(data);\\n        }\\n\\n        lastSeenRef.current = {\\n          repo: data.repo.fullName,\\n          commitSha: latestSha,\\n          releaseTag: latestTag,\\n          prNumber: latestPr,\\n        };\\n        setSecondsToSync(SYNC_INTERVAL_SECONDS);\\n      } catch (err: unknown) {\\n        const message = err instanceof Error ? err.message : \'Unable to fetch GitHub repository.\';\\n        if (!isBg) {\\n          setRepoError(message);\\n        }\\n      } finally {\\n        setIsLoadingRepo(false);\\n        setIsSyncing(false);\\n      }\\n    },\\n    [fetchAiSummary, pushMilestoneAlert]\\n  );\\n\\n  // Automatic 60-second real-time sync loop\\n  useEffect(() => {\\n    if (!snapshot || !autoSyncEnabled) return;\\n\\n    const timer = window.setInterval(() => {\\n      setSecondsToSync((prev) => {\\n        if (prev <= 1) {\\n          void loadRepository(snapshot.repo.fullName, { isBackgroundSync: true });\\n          return SYNC_INTERVAL_SECONDS;\\n        }\\n        return prev - 1;\\n      });\\n    }, 1000);\\n\\n    return () => window.clearInterval(timer);\\n  }, [snapshot, autoSyncEnabled, loadRepository]);\\n\\n  const handleEnableNotifications = async () => {\\n    const result = await requestBrowserNotifications();\\n    setNotifState(result);\\n    if (result === \'granted\' && snapshot) {\\n      pushMilestoneAlert(\\n        {\\n          type: \'celebration\',\\n          emoji: \'\360\237\224\224\',\\n          title: \'Milestone Alerts Active!\',\\n          body: `You\'ll get instant browser & dashboard alerts whenever ${snapshot.repo.name} ships new commits, merged PRs, or releases.`,\\n        },\\n        false\\n      );\\n    }\\n  };\\n\\n  const handleTestMilestoneAlert = () => {\\n    if (!snapshot) return;\\n    const latestRel = snapshot.releases[0]?.tagName;\\n    const latestAuthor = snapshot.commits[0]?.authorLogin || \'community\';\\n    pushMilestoneAlert({\\n      type: \'celebration\',\\n      emoji: \'\360\237\216\212\',\\n      title: `Milestone Celebration: ${snapshot.repo.name}`,\\n      body: latestRel\\n        ? `Tracking live momentum past ${latestRel} \342\200\224 @${latestAuthor} and ${snapshot.contributors.length}+ builders are keeping the island glowing!`\\n        : `Live tracker active! @${latestAuthor} and the community are pushing steady updates to ${snapshot.repo.name}.`,\\n      isSimulated: true,\\n    });\\n  };\\n\\n  const handleAskAboutItem = (prompt: string, contextLabel: string) => {\\n    setChatOpen(true);\\n    setPendingChatPrompt((prev) => ({\\n      text: prompt,\\n      contextLabel,\\n      seq: (prev?.seq || 0) + 1,\\n    }));\\n  };\\n\\n  const handleSwitcherSubmit = (e: FormEvent) => {\\n    e.preventDefault();\\n    const normalized = normalizeRepoInput(switcherInput);\\n    if (!normalized) {\\n      setSwitcherError(\'Enter a valid GitHub link or owner/repo handle.\');\\n      return;\\n    }\\n    setSwitcherError(null);\\n    void loadRepository(normalized);\\n  };\\n\\n  // Phase 1 Confirmed Arrival View: Clean search launcher with curated repo cards\\n  if (!snapshot) {\\n    return (\\n      <>\\n        <RepoLauncher\\n          onSelectRepo={(repo) => void loadRepository(repo)}\\n          recentRepos={recentRepos}\\n          initialError={repoError}\\n          isLoading={isLoadingRepo}\\n        />\\n        <NotificationToastStack alerts={alerts} onDismiss={dismissAlert} />\\n      </>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#F8FAFC] text-[#0F172A]\\\">\\n      {/* Strict 3-Zone Top Bar Contract (compact sticky header, <= 15% mobile viewport) */}\\n      <header className=\\\"sticky top-0 z-30 border-b border-slate-200/85 bg-white/95\\\">\\n        <div className=\\\"mx-auto flex max-w-7xl items-center justify-between gap-8 px-4 py-3.5 sm:px-6\\\">\\n          {/* Zone 1: Single-line brand wordmark */}\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setSnapshot(null);\\n              setDigest(null);\\n              setRepoError(null);\\n            }}\\n            className=\\\"font-display text-xl font-extrabold tracking-tight text-[#0F172A] hover:text-[#FF5A5F] transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            PulseIsle\\n          </button>\\n\\n          {/* Zone 2: Clean single-line text nav links */}\\n          <nav className=\\\"hidden md:flex items-center gap-7 text-sm font-medium text-slate-600\\\">\\n            <a\\n              href=\\\"#overview\\\"\\n              className=\\\"hover:text-[#0F172A] transition-colors whitespace-nowrap shrink-0\\\"\\n            >\\n              Overview\\n            </a>\\n            <a\\n              href=\\\"#island-roadmap\\\"\\n              className=\\\"hover:text-[#0F172A] transition-colors whitespace-nowrap shrink-0\\\"\\n            >\\n              3D Roadmap\\n            </a>\\n            <a\\n              href=\\\"#updates\\\"\\n              className=\\\"hover:text-[#0F172A] transition-colors whitespace-nowrap shrink-0\\\"\\n            >\\n              Updates\\n            </a>\\n            <a\\n              href=\\\"#community\\\"\\n              className=\\\"hover:text-[#0F172A] transition-colors whitespace-nowrap shrink-0\\\"\\n            >\\n              Velocity\\n            </a>\\n          </nav>\\n\\n          {/* Zone 3: Single Primary Action */}\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setChatOpen(true)}\\n            className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#FF5A5F] px-4 py-2 text-sm font-semibold text-white hover:bg-[#E0484D] transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            <MessageCircle className=\\\"h-4 w-4\\\" />\\n            <span>Ask AI Guide</span>\\n          </button>\\n        </div>\\n      </header>\\n\\n      <main className=\\\"mx-auto max-w-7xl space-y-8 px-4 pt-6 pb-20 sm:px-6\\\">\\n        {/* Contextual Repo Controls & Live 60s Sync Bar (below top bar) */}\\n        <section\\n          id=\\\"overview\\\"\\n          className=\\\"flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white px-4 py-3.5 sm:px-5 lg:flex-row lg:items-center lg:justify-between\\\"\\n        >\\n          <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setSnapshot(null);\\n                setDigest(null);\\n              }}\\n              className=\\\"inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 hover:text-[#0F172A] transition-colors whitespace-nowrap cursor-pointer\\\"\\n            >\\n              <ArrowLeft className=\\\"h-3.5 w-3.5\\\" />\\n              <span>All Repos</span>\\n            </button>\\n\\n            <span className=\\\"text-slate-300\\\" aria-hidden=\\\"true\\\">\\n              /\\n            </span>\\n\\n            <div className=\\\"flex items-center gap-2.5\\\">\\n              {snapshot.repo.avatarUrl && (\\n                <img\\n                  src={snapshot.repo.avatarUrl}\\n                  alt={`${snapshot.repo.owner} avatar`}\\n                  referrerPolicy=\\\"no-referrer\\\"\\n                  className=\\\"h-6 w-6 rounded-full border border-slate-200 object-cover\\\"\\n                />\\n              )}\\n              <a\\n                href={snapshot.repo.htmlUrl}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noreferrer\\\"\\n                className=\\\"inline-flex items-center gap-1 font-display text-sm font-bold text-[#0F172A] hover:text-[#FF5A5F] transition-colors\\\"\\n              >\\n                <span>{snapshot.repo.fullName}</span>\\n                <ExternalLink className=\\\"h-3.5 w-3.5 text-slate-400\\\" />\\n              </a>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setSwitcherOpen((v) => !v)}\\n              className=\\\"inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-[#F8FAFC] px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-[#0D9488] transition-colors whitespace-nowrap cursor-pointer\\\"\\n            >\\n              <Search className=\\\"h-3 w-3 text-[#0D9488]\\\" />\\n              <span>Switch Repo</span>\\n            </button>\\n          </div>\\n\\n          {/* Real-time 60s Auto-Sync + Push Notification Controls */}\\n          <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n            <div className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#F8FAFC] border border-slate-200/80 px-3 py-1.5 text-xs text-slate-600\\\">\\n              <span className=\\\"font-medium\\\">\\n                {isSyncing\\n                  ? \'Syncing...\'\\n                  : autoSyncEnabled\\n                    ? \'Auto-sync in\'\\n                    : \'Auto-sync paused\'}\\n              </span>\\n              {autoSyncEnabled && !isSyncing && (\\n                <span className=\\\"font-mono font-semibold tabular-nums text-[#0D9488]\\\">\\n                  {secondsToSync}s\\n                </span>\\n              )}\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setAutoSyncEnabled((v) => !v)}\\n              aria-label={autoSyncEnabled ? \'Pause auto-sync\' : \'Resume auto-sync\'}\\n              className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors whitespace-nowrap cursor-pointer\\\"\\n            >\\n              {autoSyncEnabled ? (\\n                <>\\n                  <Pause className=\\\"h-3.5 w-3.5 text-slate-500\\\" />\\n                  <span>Pause</span>\\n                </>\\n              ) : (\\n                <>\\n                  <Play className=\\\"h-3.5 w-3.5 text-[#0D9488]\\\" />\\n                  <span>Resume</span>\\n                </>\\n              )}\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => void loadRepository(snapshot.repo.fullName, { isBackgroundSync: true })}\\n              disabled={isSyncing}\\n              className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-50 transition-colors whitespace-nowrap cursor-pointer\\\"\\n            >\\n              <RefreshCw className={`h-3.5 w-3.5 text-[#0D9488] ${isSyncing ? \'animate-spin\' : \'\'}`} />\\n              <span>Sync Now</span>\\n            </button>\\n\\n            {notifState !== \'unsupported\' && notifState !== \'granted\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => void handleEnableNotifications()}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-[#0D9488]/30 bg-[#0D9488]/10 px-3 py-1.5 text-xs font-semibold text-[#0D9488] hover:bg-[#0D9488]/16 transition-colors whitespace-nowrap cursor-pointer\\\"\\n              >\\n                <Bell className=\\\"h-3.5 w-3.5\\\" />\\n                <span>{notifState === \'denied\' ? \'Alerts Blocked\' : \'Enable Push Alerts\'}</span>\\n              </button>\\n            )}\\n\\n            {notifState === \'granted\' && (\\n              <span className=\\\"inline-flex items-center gap-1.5 px-2 py-1 text-xs font-semibold text-[#0D9488] whitespace-nowrap\\\">\\n                <BellRing className=\\\"h-3.5 w-3.5\\\" />\\n                <span>Push Alerts On</span>\\n              </span>\\n            )}\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleTestMilestoneAlert}\\n              className=\\\"inline-flex items-center gap-1.5 rounded-xl bg-[#FF5A5F]/12 px-3 py-1.5 text-xs font-semibold text-[#FF5A5F] hover:bg-[#FF5A5F]/20 transition-colors whitespace-nowrap cursor-pointer\\\"\\n            >\\n              <PartyPopper className=\\\"h-3.5 w-3.5\\\" />\\n              <span>Test Milestone Alert</span>\\n            </button>\\n          </div>\\n        </section>\\n\\n        {/* Expandable Quick Repo Switcher */}\\n        {switcherOpen && (\\n          <motion.form\\n            initial={{ opacity: 0, y: -8 }}\\n            animate={{ opacity: 1, y: 0 }}\\n            onSubmit={handleSwitcherSubmit}\\n            className=\\\"rounded-2xl border border-slate-200 bg-white p-4 shadow-sm\\\"\\n          >\\n            <div className=\\\"flex flex-col gap-3 sm:flex-row\\\">\\n              <input\\n                type=\\\"text\\\"\\n                value={switcherInput}\\n                onChange={(e) => {\\n                  setSwitcherInput(e.target.value);\\n                  if (switcherError) setSwitcherError(null);\\n                }}\\n                placeholder=\\\"Paste any GitHub URL or owner/repo (e.g. tailwindlabs/tailwindcss)\\\"\\n                className=\\\"flex-1 rounded-xl border border-slate-200 bg-[#F8FAFC] px-4 py-2.5 text-sm text-[#0F172A] focus:border-[#FF5A5F] focus:bg-white focus:outline-none\\\"\\n              />\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={isLoadingRepo}\\n                className=\\\"rounded-xl bg-[#0F172A] px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 disabled:opacity-60 whitespace-nowrap cursor-pointer\\\"\\n              >\\n                {isLoadingRepo ? \'Loading...\' : \'Load Repo\'}\\n              </button>\\n            </div>\\n            {(switcherError || repoError) && (\\n              <p className=\\\"mt-2 text-xs font-medium text-red-600\\\">\\n                {switcherError || repoError}\\n              </p>\\n            )}\\n          </motion.form>\\n        )}\\n\\n        {/* Hero Community AI Briefing + Key Metrics Strip */}\\n        <section className=\\\"rounded-3xl border border-slate-200 bg-white p-6 sm:p-8\\\">\\n          <div className=\\\"flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between\\\">\\n            <div className=\\\"max-w-3xl\\\">\\n              <div className=\\\"flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs font-semibold text-[#0D9488]\\\">\\n                <span className=\\\"inline-flex items-center gap-1.5\\\">\\n                  <Sparkles className=\\\"h-3.5 w-3.5 text-[#FF5A5F]\\\" />\\n                  AI Community Briefing\\n                </span>\\n                <span aria-hidden=\\\"true\\\" className=\\\"text-slate-300\\\">\\n                  \302\267\\n                </span>\\n                <span className=\\\"text-slate-600\\\">\\n                  {digest\\n                    ? `${digest.momentumEmoji} ${digest.momentumMood}`\\n                    : `${snapshot.repo.language}`}\\n                </span>\\n                <span aria-hidden=\\\"true\\\" className=\\\"text-slate-300\\\">\\n                  \302\267\\n                </span>\\n                <span className=\\\"text-slate-500\\\">\\n                  Last pushed {formatRelativeTime(snapshot.repo.pushedAt)}\\n                </span>\\n              </div>\\n\\n              {isLoadingAi && !digest ? (\\n                <div className=\\\"mt-4 space-y-3 animate-pulse\\\">\\n                  <div className=\\\"h-9 w-4/5 rounded-xl bg-slate-100\\\" />\\n                  <div className=\\\"h-4 w-full rounded-lg bg-slate-100\\\" />\\n                  <div className=\\\"h-4 w-2/3 rounded-lg bg-slate-100\\\" />\\n                </div>\\n              ) : (\\n                <>\\n                  <h1 className=\\\"mt-3 font-display text-2xl font-extrabold tracking-tight text-[#0F172A] sm:text-3xl lg:text-4xl leading-tight\\\">\\n                    {digest?.headline || `Live Community Pulse for ${snapshot.repo.name}`}\\n                  </h1>\\n                  <p className=\\\"mt-3 text-base leading-relaxed text-slate-600\\\">\\n                    {digest?.playfulSummary || snapshot.repo.description}\\n                  </p>\\n                </>\\n              )}\\n\\n              {aiError && (\\n                <div className=\\\"mt-4 flex flex-wrap items-center gap-3 rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2.5 text-xs text-amber-900\\\">\\n                  <AlertCircle className=\\\"h-4 w-4 shrink-0 text-amber-600\\\" />\\n                  <span className=\\\"flex-1\\\">{aiError}</span>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => void fetchAiSummary(snapshot)}\\n                    className=\\\"font-semibold underline underline-offset-2 cursor-pointer\\\"\\n                  >\\n                    Retry AI Summary\\n                  </button>\\n                </div>\\n              )}\\n            </div>\\n\\n            <div className=\\\"flex shrink-0 flex-wrap items-center gap-3\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setChatOpen(true)}\\n                className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#0F172A] px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 transition-colors whitespace-nowrap cursor-pointer\\\"\\n              >\\n                <MessageCircle className=\\\"h-4 w-4 text-[#FF5A5F]\\\" />\\n                <span>Chat About Progress</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Full-width 4-Column KPI Strip below the Hero Split */}\\n          <div className=\\\"mt-7 grid grid-cols-2 gap-4 border-t border-slate-100 pt-6 sm:grid-cols-4\\\">\\n            <div>\\n              <p className=\\\"text-xs font-medium text-slate-500\\\">Community Stars</p>\\n              <p className=\\\"mt-1 flex items-center gap-1.5 font-mono text-2xl font-bold tabular-nums text-[#0F172A]\\\">\\n                <Star className=\\\"h-5 w-5 text-[#F59E0B] fill-[#F59E0B]\\\" />\\n                {formatCompactNumber(snapshot.repo.stars)}\\n              </p>\\n            </div>\\n\\n            <div>\\n              <p className=\\\"text-xs font-medium text-slate-500\\\">Forks &amp; Remixes</p>\\n              <p className=\\\"mt-1 flex items-center gap-1.5 font-mono text-2xl font-bold tabular-nums text-[#0F172A]\\\">\\n                <GitFork className=\\\"h-5 w-5 text-[#0D9488]\\\" />\\n                {formatCompactNumber(snapshot.repo.forks)}\\n              </p>\\n            </div>\\n\\n            <div>\\n              <p className=\\\"text-xs font-medium text-slate-500\\\">Latest Release</p>\\n              <p className=\\\"mt-1 font-mono text-2xl font-bold tabular-nums text-[#FF5A5F] truncate\\\">\\n                {snapshot.releases[0]?.tagName || \'Rolling\'}\\n              </p>\\n            </div>\\n\\n            <div>\\n              <p className=\\\"text-xs font-medium text-slate-500\\\">Active Open Issues</p>\\n              <p className=\\\"mt-1 font-mono text-2xl font-bold tabular-nums text-[#0F172A]\\\">\\n                {formatCompactNumber(snapshot.repo.openIssues)}\\n              </p>\\n            </div>\\n          </div>\\n        </section>\\n\\n        {/* Interactive 3D Three.js Floating Island Roadmap */}\\n        <section id=\\\"island-roadmap\\\" className=\\\"space-y-3\\\">\\n          <div className=\\\"flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between\\\">\\n            <div>\\n              <h2 className=\\\"font-display text-2xl font-bold text-[#0F172A]\\\">\\n                Interactive 3D Floating Island Roadmap\\n              </h2>\\n              <p className=\\\"text-sm text-slate-600\\\">\\n                Releases glow as lighthouses, merged PRs form coastal workshops, and recent commits\\n                orbit the frontier.\\n              </p>\\n            </div>\\n            <span className=\\\"text-xs font-medium text-slate-500\\\">\\n              Click any 3D station to inspect or ask AI\\n            </span>\\n          </div>\\n\\n          <FloatingIsland3D\\n            snapshot={snapshot}\\n            digest={digest}\\n            celebrationSignal={celebrationSignal}\\n            onAskAboutStation={handleAskAboutItem}\\n          />\\n        </section>\\n\\n        {/* Plain-English Release Notes & Commits/PRs Activity Stream */}\\n        <ActivityFeed\\n          snapshot={snapshot}\\n          digest={digest}\\n          isAiLoading={isLoadingAi}\\n          onAskAboutItem={handleAskAboutItem}\\n        />\\n\\n        {/* Animated Velocity Charts & Community Contributors */}\\n        <VelocityAndContributors snapshot={snapshot} digest={digest} />\\n      </main>\\n\\n      {/* Clean Footer */}\\n      <footer className=\\\"border-t border-slate-200 bg-white\\\">\\n        <div className=\\\"mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-5 text-xs text-slate-500 sm:px-6\\\">\\n          <span>\\n            PulseIsle \302\267 Tracking <strong className=\\\"text-[#0F172A]\\\">{snapshot.repo.fullName}</strong>\\n          </span>\\n          <span className=\\\"tabular-nums\\\">\\n            Last synced {formatRelativeTime(snapshot.syncedAt)}\\n          </span>\\n        </div>\\n      </footer>\\n\\n      {/* Floating Chat Trigger for Mobile Convenience */}\\n      {!chatOpen && (\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setChatOpen(true)}\\n          aria-label=\\\"Open Community AI Chat\\\"\\n          className=\\\"fixed bottom-5 right-5 z-30 inline-flex h-13 items-center gap-2 rounded-full bg-[#0F172A] px-5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 hover:bg-slate-800 transition-transform hover:-translate-y-0.5 md:hidden cursor-pointer\\\"\\n        >\\n          <MessageCircle className=\\\"h-4 w-4 text-[#FF5A5F]\\\" />\\n          <span>Ask AI</span>\\n        </button>\\n      )}\\n\\n      {/* Streaming Community AI Chat Drawer */}\\n      <CommunityChatDrawer\\n        isOpen={chatOpen}\\n        onClose={() => setChatOpen(false)}\\n        snapshot={snapshot}\\n        digest={digest}\\n        pendingPrompt={pendingChatPrompt}\\n      />\\n\\n      {/* Real-time Milestone Push Notification Toast Stack */}\\n      <NotificationToastStack alerts={alerts} onDismiss={dismissAlert} />\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Build the full PulseIsle dashboard orchestrating RepoLauncher, 60s real-time auto-sync, Browser & in-app push notifications, Gemini AI briefing, Three.js Floating Island Roadmap, ActivityFeed, VelocityAndContributors, and streaming CommunityChatDrawer.\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 118
      nanos: 698320898
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "PMgCa6LTCc6YzLEPl9D2qAg"
  }
