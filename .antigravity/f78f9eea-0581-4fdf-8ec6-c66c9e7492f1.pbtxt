              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // --- 8. Animation Loop with Software-WebGL fenceSync Pacing ---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const clock = new THREE.Clock();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let frameId = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let disposed = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    function afterDraw(cb: () => void) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const gl = renderer.getContext() as WebGL2RenderingContext;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!gl || typeof gl.fenceSync !== \'function\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        frameId = window.setTimeout(cb, 85);"
