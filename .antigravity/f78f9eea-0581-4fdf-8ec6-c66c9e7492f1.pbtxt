            lines {
              text: "    // --- 7. Responsive ResizeObserver ---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const resizeObserver = new ResizeObserver((entries) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const entry = entries[0];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!entry) return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const w = Math.max(200, Math.floor(entry.contentRect.width));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const h = Math.max(240, Math.floor(entry.contentRect.height));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.aspect = w / h;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.updateProjectionMatrix();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      renderer.setSize(w, h);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
