      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Render AiProviderSelector below the launcher search input so users can pick Gemini, OpenAI, Anthropic, NVIDIA, Groq, OpenRouter, or Local LLM right from the home screen.\", \"EndLine\":150, \"Instruction\":\"Add AI Provider row above recent repos in RepoLauncher.tsx\", \"ReplacementContent\":\"          {/* AI Engine Picker & Recently Tracked Quick Links */}\\n          <div className=\\\"mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2.5 text-xs text-slate-500\\\">\\n            <div className=\\\"inline-flex items-center gap-2\\\">\\n              <span className=\\\"font-medium text-slate-500\\\">AI Summarizer:</span>\\n              <AiProviderSelector\\n                config={aiConfig}\\n                onApply={onChangeAiConfig}\\n                align=\\\"left\\\"\\n                compact\\n              />\\n            </div>\\n\\n            {recentRepos.length > 0 && (\\n              <>\\n                <span className=\\\"text-slate-300 hidden sm:inline\\\" aria-hidden=\\\"true\\\">\\n                  \302\267\\n                </span>\\n                <span className=\\\"inline-flex items-center gap-1.5 font-medium text-slate-500\\\">\\n                  <History className=\\\"h-3.5 w-3.5\\\" />\\n                  Recent:\\n                </span>\\n              </>\\n            )}\\n          </div>\\n\\n          {recentRepos.length > 0 && (\\n            <div className=\\\"mt-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-xs\\\">\\n              {recentRepos.map((repo) => (\", \"StartLine\":143, \"TargetContent\":\"          {/* Recently Tracked Quick Links */}\\n          {recentRepos.length > 0 && (\\n            <div className=\\\"mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-slate-500\\\">\\n              <span className=\\\"inline-flex items-center gap-1.5 font-medium text-slate-500\\\">\\n               