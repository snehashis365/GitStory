      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { AiDigest, AiProviderConfig, AiProviderId, RepoSnapshot } from \'../types\';\\n\\nexport interface ProviderPreset {\\n  id: AiProviderId;\\n  name: string;\\n  shortName: string;\\n  emoji: string;\\n  badge: string;\\n  requiresApiKey: boolean;\\n  isLocal: boolean;\\n  defaultModel: string;\\n  models: { id: string; label: string }[];\\n  defaultBaseUrl?: string;\\n  keyPlaceholder?: string;\\n  helperNote: string;\\n}\\n\\nexport const AI_PROVIDERS: ProviderPreset[] = [\\n  {\\n    id: \'gemini\',\\n    name: \'Google Gemini (Built-in)\',\\n    shortName: \'Gemini\',\\n    emoji: \'\342\234\250\',\\n    badge: \'Built-in\',\\n    requiresApiKey: false,\\n    isLocal: false,\\n    defaultModel: \'gemini-4-hydrogen\',\\n    models: [{ id: \'gemini-4-hydrogen\', label: \'Gemini 4 Hydrogen (Default)\' }],\\n    helperNote: \'Uses the app\342\200\231s built-in server key automatically\342\200\224no API key entry needed.\',\\n  },\\n  {\\n    id: \'gemini-lite\',\\n    name: \'Gemini Flash Lite (Built-in)\',\\n    shortName: \'Gemini Lite\',\\n    emoji: \'\342\232\241\',\\n    badge: \'Higher Quota\',\\n    requiresApiKey: false,\\n    isLocal: false,\\n    defaultModel: \'gemini-3.1-flash-lite\',\\n    models: [{ id: \'gemini-3.1-flash-lite\', label: \'Gemini 3.1 Flash Lite\' }],\\n    helperNote: \'Lighter built-in Gemini model ideal when standard quota is busy.\',\\n  },\\n  {\\n    id: \'openai\',\\n    name: \'OpenAI\',\\n    shortName: \'OpenAI\',\\n    emoji: \'\360\237\244\226\',\\n    badge: \'Cloud API\',\\n    requiresApiKey: true,\\n    isLocal: false,\\n    defaultModel: \'gpt-4o-mini\',\\n    models: [\\n      { id: \'gpt-4o-mini\', label: \'GPT-4o Mini (Fast)\' },\\n      { id: \'gpt-4o\', label: \'GPT-4o\' },\\n      { id: \'gpt-4.1-mini\', label: \'GPT-4.1 Mini\' },\\n    ],\\n    defaultBaseUrl: \'https://api.openai.com/v1\',\\n    keyPlaceholder: \'sk-...\',\\n    helperNote: \'Provide your OpenAI API key. Sent only to our server proxy during requests.\',\\n  },\\n  {\\n    id: \'anthropic\',\\n    name: \'Anthropic Claude\',\\n    shortName: \'Claude\',\\n    emoji: \'\360\237\247\240\',\\n    badge: \'Cloud API\',\\n    requiresApiKey: true,\\n    isLocal: false,\\n    defaultModel: \'claude-3-5-haiku-latest\',\\n    models: [\\n      { id: \'claude-3-5-haiku-latest\', label: \'Claude 3.5 Haiku (Fast)\' },\\n      { id: \'claude-3-7-sonnet-latest\', label: \'Claude 3.7 Sonnet\' },\\n      { id: \'claude-sonnet-4-20250514\', label: \'Claude Sonnet 4\' },\\n    ],\\n    keyPlaceholder: \'sk-ant-...\',\\n    helperNote: \'Provide your Anthropic API key for warm, crisp community explanations.\',\\n  },\\n  {\\n    id: \'nvidia\',\\n    name: \'NVIDIA NIM\',\\n    shortName: \'NVIDIA\',\\n    emoji: \'\360\237\222\232\',\\n    badge: \'Cloud API\',\\n    requiresApiKey: true,\\n    isLocal: false,\\n    defaultModel: \'meta/llama-3.3-70b-instruct\',\\n    models: [\\n      { id: \'meta/llama-3.3-70b-instruct\', label: \'Llama 3.3 70B Instruct\' },\\n      { id: \'nvidia/llama-3.1-nemotron-70b-instruct\', label: \'Nemotron 70B Instruct\' },\\n      { id: \'mistralai/mistral-large-2-instruct\', label: \'Mistral Large 2\' },\\n    ],\\n    defaultBaseUrl: \'https://integrate.api.nvidia.com/v1\',\\n    keyPlaceholder: \'nvapi-...\',\\n    helperNote: \'Uses NVIDIA NIM cloud API (integrate.api.nvidia.com).\',\\n  },\\n  {\\n    id: \'groq\',\\n    name: \'Groq\',\\n    shortName: \'Groq\',\\n    emoji: \'\360\237\232\200\',\\n    badge: \'Ultra Fast\',\\n    requiresApiKey: true,\\n    isLocal: false,\\n    defaultModel: \'llama-3.3-70b-versatile\',\\n    models: [\\n      { id: \'llama-3.3-70b-versatile\', label: \'Llama 3.3 70B Versatile\' },\\n      { id: \'llama-3.1-8b-instant\', label: \'Llama 3.1 8B Instant\' },\\n    ],\\n    defaultBaseUrl: \'https://api.groq.com/openai/v1\',\\n    keyPlaceholder: \'gsk_...\',\\n    helperNote: \'Ultra-low-latency Llama inference via Groq Cloud.\',\\n  },\\n  {\\n    id: \'openrouter\',\\n    name: \'OpenRouter\',\\n    shortName: \'OpenRouter\',\\n    emoji: \'\360\237\214\220\',\\n    badge: \'Multi-Model\',\\n    requiresApiKey: true,\\n    isLocal: false,\\n    defaultModel: \'openai/gpt-4o-mini\',\\n    models: [\\n      { id: \'openai/gpt-4o-mini\', label: \'OpenAI GPT-4o Mini\' },\\n      { id: \'anthropic/claude-3.5-haiku\', label: \'Anthropic Claude 3.5 Haiku\' },\\n      { id: \'meta-llama/llama-3.3-70b-instruct:free\', label: \'Llama 3.3 70B (Free Tier)\' },\\n    ],\\n    defaultBaseUrl: \'https://openrouter.ai/api/v1\',\\n    keyPlaceholder: \'sk-or-...\',\\n    helperNote: \'Access dozens of cloud models through a single OpenRouter key.\',\\n  },\\n  {\\n    id: \'local\',\\n    name: \'Local LLM (Ollama / LM Studio)\',\\n    shortName: \'Local LLM\',\\n    emoji: \'\360\237\222\273\',\\n    badge: \'No Key Needed\',\\n    requiresApiKey: false,\\n    isLocal: true,\\n    defaultModel: \'llama3.2\',\\n    models: [\\n      { id: \'llama3.2\', label: \'llama3.2 (Ollama)\' },\\n      { id: \'qwen2.5:7b\', label: \'qwen2.5:7b (Ollama)\' },\\n      { id: \'mistral\', label: \'mistral (Ollama)\' },\\n      { id: \'gemma3\', label: \'gemma3 (Ollama)\' },\\n    ],\\n    defaultBaseUrl: \'http://localhost:11434/v1\',\\n    helperNote:\\n      \'Runs directly against your local Ollama (port 11434) or LM Studio (port 1234) with no API key.\',\\n  },\\n];\\n\\nexport function getProviderPreset(id: AiProviderId): ProviderPreset {\\n  return AI_PROVIDERS.find((p) => p.id === id) || AI_PROVIDERS[0];\\n}\\n\\nconst PROVIDER_STORAGE_KEY = \'pulseisle_ai_provider_v1\';\\nconst KEYS_STORAGE_KEY = \'pulseisle_ai_keys_v1\';\\n\\nexport function loadSavedProviderConfig(): AiProviderConfig {\\n  try {\\n    const raw = localStorage.getItem(PROVIDER_STORAGE_KEY);\\n    if (!raw) {\\n      return { provider: \'gemini\', model: \'gemini-4-hydrogen\' };\\n    }\\n    const parsed = JSON.parse(raw) as Partial<AiProviderConfig>;\\n    const preset = getProviderPreset((parsed.provider as AiProviderId) || \'gemini\');\\n    const savedKeys = loadSavedKeysMap();\\n    return {\\n      provider: preset.id,\\n      model: parsed.model || preset.defaultModel,\\n      baseUrl: parsed.baseUrl || preset.defaultBaseUrl,\\n      apiKey: preset.requiresApiKey ? savedKeys[preset.id] || \'\' : undefined,\\n    };\\n  } catch {\\n    return { provider: \'gemini\', model: \'gemini-4-hydrogen\' };\\n  }\\n}\\n\\nexport function loadSavedKeysMap(): Record<string, string> {\\n  try {\\n    const raw = localStorage.getItem(KEYS_STORAGE_KEY);\\n    return raw ? (JSON.parse(raw) as Record<string, string>) : {};\\n  } catch {\\n    return {};\\n  }\\n}\\n\\nexport function saveProviderConfig(config: AiProviderConfig) {\\n  try {\\n    localStorage.setItem(\\n      PROVIDER_STORAGE_KEY,\\n      JSON.stringify({\\n        provider: config.provider,\\n        model: config.model,\\n        baseUrl: config.baseUrl,\\n      })\\n    );\\n    const keys = loadSavedKeysMap();\\n    if (config.apiKey !== undefined) {\\n      if (config.apiKey.trim()) {\\n        keys[config.provider] = config.apiKey.trim();\\n      } else {\\n        delete keys[config.provider];\\n      }\\n      localStorage.setItem(KEYS_STORAGE_KEY, JSON.stringify(keys));\\n    }\\n  } catch {\\n    // Ignore storage restrictions\\n  }\\n}\\n\\nfunction extractJsonObject(raw: string): Record<string, unknown> {\\n  const trimmed = raw.trim();\\n  const fenced = trimmed.match(/```(?:json)?\\\\s*([\\\\s\\\\S]*?)```/i);\\n  const candidate = fenced ? fenced[1].trim() : trimmed;\\n  const start = candidate.indexOf(\'{\');\\n  const end = candidate.lastIndexOf(\'}\');\\n  if (start === -1 || end === -1) {\\n    throw new Error(\'Local model did not return valid JSON. Try a stronger instruct model like llama3.2 or qwen2.5.\');\\n  }\\n  return JSON.parse(candidate.slice(start, end + 1)) as Record<string, unknown>;\\n}\\n\\n// Direct browser call for Local LLM (Ollama / LM Studio) so localhost works even when app is cloud-hosted\\nexport async function summarizeWithLocalLlm(\\n  snapshot: RepoSnapshot,\\n  config: AiProviderConfig\\n): Promise<AiDigest> {\\n  const baseUrl = (config.baseUrl || \'http://localhost:11434/v1\').replace(/\\\\/+$/, \'\');\\n  const model = config.model || \'llama3.2\';\\n\\n  const commitsPayload = snapshot.commits.slice(0, 8).map((c) => ({\\n    sha: c.shortSha,\\n    author: c.authorLogin,\\n    message: c.firstLine,\\n  }));\\n  const prsPayload = snapshot.mergedPRs.slice(0, 6).map((p) => ({\\n    number: p.number,\\n    title: p.title,\\n    author: p.userLogin,\\n  }));\\n  const latestRelease = snapshot.releases[0]\\n    ? {\\n        tagName: snapshot.releases[0].tagName,\\n        name: snapshot.releases[0].name,\\n        notes: snapshot.releases[0].body.slice(0, 900),\\n      }\\n    : null;\\n\\n  const systemPrompt =\\n    \'You are PulseIsle, a playful open-source storyteller translating GitHub activity into plain English for non-developers. Return ONLY a valid JSON object matching this exact structure: { \\\"headline\\\": string, \\\"playfulSummary\\\": string, \\\"momentumMood\\\": string, \\\"momentumEmoji\\\": string, \\\"nextMilestoneEstimate\\\": string, \\\"milestoneProgressPct\\\": number, \\\"progressChapters\\\": [{ \\\"emoji\\\": string, \\\"title\\\": string, \\\"summary\\\": string, \\\"impactLabel\\\": string, \\\"keyWins\\\": string[], \\\"relatedCount\\\": number }], \\\"jargonDecoder\\\": [{ \\\"term\\\": string, \\\"plainMeaning\\\": string, \\\"emoji\\\": string }], \\\"lifecycleStageBriefs\\\": { \\\"commits\\\": string, \\\"prs\\\": string, \\\"community\\\": string, \\\"release\\\": string }, \\\"releaseTranslation\\\": null | { \\\"tagName\\\": string, \\\"cheerfulTitle\\\": string, \\\"summary\\\": string, \\\"highlights\\\": [{ \\\"emoji\\\": string, \\\"text\\\": string }] }, \\\"commitTranslations\\\": [{ \\\"sha\\\": string, \\\"emoji\\\": string, \\\"plainTitle\\\": string, \\\"whyItMatters\\\": string, \\\"category\\\": \\\"Feature\\\"|\\\"Fix\\\"|\\\"Speed\\\"|\\\"Docs\\\"|\\\"Polish\\\" }], \\\"prTranslations\\\": [{ \\\"number\\\": number, \\\"emoji\\\": string, \\\"plainTitle\\\": string, \\\"whyItMatters\\\": string, \\\"category\\\": \\\"Feature\\\"|\\\"Fix\\\"|\\\"Speed\\\"|\\\"Docs\\\"|\\\"Polish\\\" }] }. Never copy raw developer jargon verbatim.\';\\n\\n  const userPrompt = `Repository: ${snapshot.repo.fullName} \342\200\224 ${snapshot.repo.description}\\\\nRecent commits: ${JSON.stringify(commitsPayload)}\\\\nMerged PRs: ${JSON.stringify(prsPayload)}\\\\nLatest release: ${JSON.stringify(latestRelease)}\\\\nSynthesize 3 thematic progressChapters, 3 jargonDecoder entries, 4 lifecycleStageBriefs, and plain-English commit/PR translations.`;\\n\\n  let resp: Response;\\n  try {\\n    resp = await fetch(`${baseUrl}/chat/completions`, {\\n      method: \'POST\',\\n      headers: { \'Content-Type\': \'application/json\' },\\n      body: JSON.stringify({\\n        model,\\n        response_format: { type: \'json_object\' },\\n        messages: [\\n          { role: \'system\', content: systemPrompt },\\n          { role: \'user\', content: userPrompt },\\n        ],\\n      }),\\n    });\\n  } catch {\\n    throw new Error(\\n      `Could not reach Local LLM at ${baseUrl}. Make sure Ollama or LM Studio is running locally with CORS enabled (e.g. OLLAMA_ORIGINS=\\\"*\\\").`\\n    );\\n  }\\n\\n  if (!resp.ok) {\\n    const errText = await resp.text().catch(() => \'\');\\n    throw new Error(\\n      `Local LLM returned ${resp.status}${errText ? `: ${errText.slice(0, 140)}` : \'\'}. Check that model \\\"${model}\\\" is installed.`\\n    );\\n  }\\n\\n  const data = (await resp.json()) as {\\n    choices?: { message?: { content?: string } }[];\\n  };\\n  const content = data.choices?.[0]?.message?.content || \'\';\\n  const parsed = extractJsonObject(content) as unknown as Partial<AiDigest>;\\n\\n  return {\\n    headline: parsed.headline || `Community Progress Update for ${snapshot.repo.name}`,\\n    playfulSummary: parsed.playfulSummary || snapshot.repo.description,\\n    momentumMood: parsed.momentumMood || \'Building Steadily\',\\n    momentumEmoji: parsed.momentumEmoji || \'\360\237\232\200\',\\n    nextMilestoneEstimate:\\n      parsed.nextMilestoneEstimate || \'Moving steadily toward the next community milestone.\',\\n    milestoneProgressPct: Math.min(98, Math.max(15, Number(parsed.milestoneProgressPct) || 68)),\\n    progressChapters: Array.isArray(parsed.progressChapters) ? parsed.progressChapters : [],\\n    jargonDecoder: Array.isArray(parsed.jargonDecoder) ? parsed.jargonDecoder : [],\\n    lifecycleStageBriefs: parsed.lifecycleStageBriefs || {\\n      commits: \'Developers are actively pushing improvements.\',\\n      prs: \'Reviewed community changes are merging cleanly.\',\\n      community: \'Contributors are keeping momentum strong.\',\\n      release: \'Preparing tested features for everyone.\',\\n    },\\n    releaseTranslation: latestRelease ? parsed.releaseTranslation ?? null : null,\\n    commitTranslations: Array.isArray(parsed.commitTranslations) ? parsed.commitTranslations : [],\\n    prTranslations: Array.isArray(parsed.prTranslations) ? parsed.prTranslations : [],\\n    generatedAt: new Date().toISOString(),\\n  };\\n}\\n\\nexport async function streamChatWithLocalLlm(\\n  snapshot: RepoSnapshot,\\n  digest: AiDigest | null,\\n  messages: { role: \'user\' | \'assistant\'; content: string }[],\\n  config: AiProviderConfig,\\n  onChunk: (text: string) => void\\n): Promise<void> {\\n  const baseUrl = (config.baseUrl || \'http://localhost:11434/v1\').replace(/\\\\/+$/, \'\');\\n  const model = config.model || \'llama3.2\';\\n\\n  const systemPrompt = `You are PulseIsle\'s friendly open-source tour guide for ${snapshot.repo.fullName} (${snapshot.repo.description}). Answer non-technical community members in warm, playful, jargon-free English with helpful analogies.\\nStats: ${snapshot.repo.stars} stars, ${snapshot.repo.forks} forks, latest release: ${snapshot.releases[0]?.tagName || \'None\'}.\\nRecent commits: ${snapshot.commits.slice(0, 8).map((c) => `${c.shortSha}: ${c.firstLine}`).join(\' | \')}\\nMerged PRs: ${snapshot.mergedPRs.slice(0, 6).map((p) => `#${p.number}: ${p.title}`).join(\' | \')}\\n${digest ? `Briefing: ${digest.headline} \342\200\224 ${digest.playfulSummary}` : \'\'}`;\\n\\n  let resp: Response;\\n  try {\\n    resp = await fetch(`${baseUrl}/chat/completions`, {\\n      method: \'POST\',\\n      headers: { \'Content-Type\': \'application/json\' },\\n      body: JSON.stringify({\\n        model,\\n        stream: true,\\n        messages: [\\n          { role: \'system\', content: systemPrompt },\\n          ...messages.slice(-10),\\n        ],\\n      }),\\n    });\\n  } catch {\\n    throw new Error(\\n      `Could not connect to Local LLM at ${baseUrl}. Ensure Ollama/LM Studio is running with CORS enabled (OLLAMA_ORIGINS=\\\"*\\\").`\\n    );\\n  }\\n\\n  if (!resp.ok) {\\n    throw new Error(`Local LLM returned status ${resp.status}. Verify model \\\"${model}\\\" is loaded.`);\\n  }\\n\\n  const reader = resp.body?.getReader();\\n  if (!reader) throw new Error(\'Streaming unavailable from Local LLM.\');\\n\\n  const decoder = new TextDecoder();\\n  let buffer = \'\';\\n  while (true) {\\n    const { done, value } = await reader.read();\\n    if (done) break;\\n    buffer += decoder.decode(value, { stream: true });\\n    const lines = buffer.split(\'\\\\n\');\\n    buffer = lines.pop() || \'\';\\n    for (const rawLine of lines) {\\n      const line = rawLine.trim();\\n      if (!line.startsWith(\'data:\')) continue;\\n      const payload = line.slice(5).trim();\\n      if (payload === \'[DONE]\') continue;\\n      try {\\n        const parsed = JSON.parse(payload) as {\\n          choices?: { delta?: { content?: string } }[];\\n        };\\n        const token = parsed.choices?.[0]?.delta?.content;\\n        if (token) onChunk(token);\\n      } catch {\\n        // Ignore partial chunk\\n      }\\n    }\\n  }\\n}\\n\", \"Description\":\"Create AI provider registry (Gemini built-in, Gemini Flash Lite, OpenAI, Anthropic Claude, NVIDIA NIM, Groq, OpenRouter, Local LLM), browser persistence helpers, and direct Local LLM client helpers.\", \"Overwrite\":true, \"TargetFile\":\"/src/utils/aiProviders.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_7807434002180721750"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import \'dotenv/config\';\\nimport express, { type Request, type Response } from \'express\';\\nimport path from \'path\';\\nimport { fileURLToPath } from \'url\';\\nimport { GoogleGenAI, Type, ThinkingLevel } from \'@google/genai\';\\nimport type {\\n  AiDigest,\\n  AiProviderConfig,\\n  CommitItem,\\n  ContributorItem,\\n  PullRequestItem,\\n  ReleaseItem,\\n  RepoSnapshot,\\n  VelocityPoint,\\n} from \'./src/types.ts\';\\n\\nconst __filename = fileURLToPath(import.meta.url);\\nconst __dirname = path.dirname(__filename);\\n\\nconst PORT = Number(process.env.PORT) || 3000;\\nconst IS_PROD = process.env.NODE_ENV === \'production\';\\n\\nfunction createGeminiClient() {\\n  const apiKey = process.env.GEMINI_API_KEY;\\n  if (!apiKey) {\\n    throw new Error(\\n      \'Built-in Gemini API key is not configured. Check Settings > Secrets or pick another AI provider from the AI Provider menu.\'\\n    );\\n  }\\n  return new GoogleGenAI({\\n    apiKey,\\n    httpOptions: {\\n      headers: {\\n        \'User-Agent\': \'aistudio-build\',\\n      },\\n    },\\n  });\\n}\\n\\nfunction parseRepoInput(raw: string): { owner: string; repo: string } | null {\\n  const cleaned = raw.trim().replace(/^@/, \'\');\\n  if (!cleaned) return null;\\n\\n  const urlMatch = cleaned.match(\\n    /^(?:https?:\\\\/\\\\/)?(?:www\\\\.)?github\\\\.com\\\\/([A-Za-z0-9_.-]+)\\\\/([A-Za-z0-9_.-]+)(?:\\\\/.*)?$/i\\n  );\\n  if (urlMatch) {\\n    return {\\n      owner: urlMatch[1],\\n      repo: urlMatch[2].replace(/\\\\.git$/i, \'\'),\\n    };\\n  }\\n\\n  const shortMatch = cleaned.match(/^([A-Za-z0-9_.-]+)\\\\/([A-Za-z0-9_.-]+)$/);\\n  if (shortMatch) {\\n    return {\\n      owner: shortMatch[1],\\n      repo: shortMatch[2].replace(/\\\\.git$/i, \'\'),\\n    };\\n  }\\n\\n  return null;\\n}\\n\\n// Smart ETag + snapshot cache to protect unauthenticated GitHub rate limits\\ninterface CacheEntry<T> {\\n  etag?: string;\\n  data: T;\\n  fetchedAt: number;\\n  rateLimitRemaining: number | null;\\n}\\n\\nconst ghCache = new Map<string, CacheEntry<unknown>>();\\nconst snapshotCache = new Map<string, { snapshot: RepoSnapshot; fetchedAt: number }>();\\nconst digestCache = new Map<string, { digest: AiDigest; generatedAt: number }>();\\n\\nconst ENDPOINT_CACHE_TTL_MS = 180_000;\\nconst DIGEST_CACHE_TTL_MS = 600_000;\\n\\nasync function githubFetch<T>(\\n  url: string,\\n  forceConditionalCheck = false\\n): Promise<{ data: T; fromCache: boolean; notModified: boolean; rateLimitRemaining: number | null }> {\\n  const cached = ghCache.get(url) as CacheEntry<T> | undefined;\\n  const now = Date.now();\\n\\n  if (cached && !forceConditionalCheck && now - cached.fetchedAt < ENDPOINT_CACHE_TTL_MS) {\\n    return {\\n      data: cached.data,\\n      fromCache: true,\\n      notModified: false,\\n      rateLimitRemaining: cached.rateLimitRemaining,\\n    };\\n  }\\n\\n  const headers: Record<string, string> = {\\n    Accept: \'application/vnd.github+json\',\\n    \'User-Agent\': \'PulseIsle-Repo-Tracker\',\\n    \'X-GitHub-Api-Version\': \'2022-11-28\',\\n  };\\n\\n  if (process.env.GITHUB_TOKEN) {\\n    headers.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;\\n  }\\n  if (cached?.etag) {\\n    headers[\'If-None-Match\'] = cached.etag;\\n  }\\n\\n  const resp = await fetch(url, { headers });\\n  const remainingHeader = resp.headers.get(\'x-ratelimit-remaining\');\\n  const rateLimitRemaining = remainingHeader !== null ? Number(remainingHeader) : null;\\n\\n  if (resp.status === 304 && cached) {\\n    cached.fetchedAt = now;\\n    cached.rateLimitRemaining = rateLimitRemaining;\\n    return {\\n      data: cached.data,\\n      fromCache: true,\\n      notModified: true,\\n      rateLimitRemaining,\\n    };\\n  }\\n\\n  if (!resp.ok) {\\n    if (resp.status === 404) {\\n      const err = new Error(\\n        \'Repository not found or is private. Double-check the owner/repo name.\'\\n      ) as Error & { status?: number };\\n      err.status = 404;\\n      throw err;\\n    }\\n    if (resp.status === 403 || resp.status === 429) {\\n      if (cached) {\\n        return {\\n          data: cached.data,\\n          fromCache: true,\\n          notModified: false,\\n          rateLimitRemaining: 0,\\n        };\\n      }\\n      const err = new Error(\\n        \'GitHub API rate limit reached for this IP. Try again in a few minutes or configure GITHUB_TOKEN.\'\\n      ) as Error & { status?: number };\\n      err.status = 429;\\n      throw err;\\n    }\\n    const err = new Error(\\n      `GitHub returned status ${resp.status}. Please try again shortly.`\\n    ) as Error & { status?: number };\\n    err.status = resp.status;\\n    throw err;\\n  }\\n\\n  const data = (await resp.json()) as T;\\n  const etag = resp.headers.get(\'etag\') ?? undefined;\\n  ghCache.set(url, {\\n    etag,\\n    data,\\n    fetchedAt: now,\\n    rateLimitRemaining,\\n  });\\n\\n  return { data, fromCache: false, notModified: false, rateLimitRemaining };\\n}\\n\\nfunction buildVelocitySeries(commits: CommitItem[], mergedPRs: PullRequestItem[]): VelocityPoint[] {\\n  const countsByDay = new Map<string, { commits: number; mergedPRs: number }>();\\n\\n  const allDates: Date[] = [];\\n  for (const c of commits) {\\n    if (c.date) allDates.push(new Date(c.date));\\n  }\\n  for (const pr of mergedPRs) {\\n    if (pr.mergedAt) allDates.push(new Date(pr.mergedAt));\\n  }\\n\\n  const anchor =\\n    allDates.length > 0\\n      ? new Date(Math.max(...allDates.map((d) => d.getTime())))\\n      : new Date();\\n  anchor.setHours(0, 0, 0, 0);\\n\\n  const dayKeys: string[] = [];\\n  for (let i = 9; i >= 0; i--) {\\n    const d = new Date(anchor);\\n    d.setDate(anchor.getDate() - i);\\n    const key = d.toISOString().slice(0, 10);\\n    dayKeys.push(key);\\n    countsByDay.set(key, { commits: 0, mergedPRs: 0 });\\n  }\\n\\n  for (const c of commits) {\\n    const key = c.date?.slice(0, 10);\\n    if (key && countsByDay.has(key)) {\\n      countsByDay.get(key)!.commits += 1;\\n    }\\n  }\\n  for (const pr of mergedPRs) {\\n    const key = pr.mergedAt?.slice(0, 10);\\n    if (key && countsByDay.has(key)) {\\n      countsByDay.get(key)!.mergedPRs += 1;\\n    }\\n  }\\n\\n  const totalInWindow = Array.from(countsByDay.values()).reduce(\\n    (acc, v) => acc + v.commits + v.mergedPRs,\\n    0\\n  );\\n\\n  if (totalInWindow < 3 && allDates.length > 0) {\\n    const sparse = new Map<string, { commits: number; mergedPRs: number }>();\\n    for (const c of commits) {\\n      const k = c.date.slice(0, 10);\\n      const entry = sparse.get(k) ?? { commits: 0, mergedPRs: 0 };\\n      entry.commits += 1;\\n      sparse.set(k, entry);\\n    }\\n    for (const pr of mergedPRs) {\\n      const k = pr.mergedAt.slice(0, 10);\\n      const entry = sparse.get(k) ?? { commits: 0, mergedPRs: 0 };\\n      entry.mergedPRs += 1;\\n      sparse.set(k, entry);\\n    }\\n    return Array.from(sparse.entries())\\n      .sort(([a], [b]) => a.localeCompare(b))\\n      .slice(-10)\\n      .map(([date, vals]) => {\\n        const parsed = new Date(`${date}T12:00:00Z`);\\n        return {\\n          date,\\n          label: parsed.toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\' }),\\n          commits: vals.commits,\\n          mergedPRs: vals.mergedPRs,\\n        };\\n      });\\n  }\\n\\n  return dayKeys.map((date) => {\\n    const parsed = new Date(`${date}T12:00:00Z`);\\n    const vals = countsByDay.get(date)!;\\n    return {\\n      date,\\n      label: parsed.toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\' }),\\n      commits: vals.commits,\\n      mergedPRs: vals.mergedPRs,\\n    };\\n  });\\n}\\n\\n// --- Multi-Provider AI Helpers ---\\nconst OPENAI_COMPAT_BASE_URLS: Record<string, string> = {\\n  openai: \'https://api.openai.com/v1\',\\n  nvidia: \'https://integrate.api.nvidia.com/v1\',\\n  groq: \'https://api.groq.com/openai/v1\',\\n  openrouter: \'https://openrouter.ai/api/v1\',\\n};\\n\\nfunction extractJsonObject(raw: string): Record<string, unknown> {\\n  const trimmed = raw.trim();\\n  const fenced = trimmed.match(/```(?:json)?\\\\s*([\\\\s\\\\S]*?)```/i);\\n  const candidate = fenced ? fenced[1].trim() : trimmed;\\n  const start = candidate.indexOf(\'{\');\\n  const end = candidate.lastIndexOf(\'}\');\\n  if (start === -1 || end === -1) {\\n    throw new Error(\'The selected AI model returned an unexpected non-JSON format. Please retry.\');\\n  }\\n  return JSON.parse(candidate.slice(start, end + 1)) as Record<string, unknown>;\\n}\\n\\nfunction normalizeDigest(\\n  parsed: Partial<AiDigest>,\\n  snapshot: RepoSnapshot,\\n  hasLatestRelease: boolean\\n): AiDigest {\\n  return {\\n    headline: parsed.headline || `Community Progress Update for ${snapshot.repo.name}`,\\n    playfulSummary: parsed.playfulSummary || snapshot.repo.description,\\n    momentumMood: parsed.momentumMood || \'Moving Forward\',\\n    momentumEmoji: parsed.momentumEmoji || \'\360\237\232\200\',\\n    nextMilestoneEstimate:\\n      parsed.nextMilestoneEstimate || \'Building momentum toward the next milestone.\',\\n    milestoneProgressPct: Math.min(98, Math.max(15, Number(parsed.milestoneProgressPct) || 68)),\\n    progressChapters: Array.isArray(parsed.progressChapters) ? parsed.progressChapters : [],\\n    jargonDecoder: Array.isArray(parsed.jargonDecoder) ? parsed.jargonDecoder : [],\\n    lifecycleStageBriefs: parsed.lifecycleStageBriefs || {\\n      commits: \'Developers are actively crafting fresh improvements behind the scenes.\',\\n      prs: \'Reviewed community improvements are smoothly merging into the main project.\',\\n      community: \'Contributors are collaborating steadily to keep momentum high.\',\\n      release: \'Preparing the latest tested improvements for the wider community.\',\\n    },\\n    releaseTranslation: hasLatestRelease ? parsed.releaseTranslation ?? null : null,\\n    commitTranslations: Array.isArray(parsed.commitTranslations) ? parsed.commitTranslations : [],\\n    prTranslations: Array.isArray(parsed.prTranslations) ? parsed.prTranslations : [],\\n    generatedAt: new Date().toISOString(),\\n  };\\n}\\n\\nfunction formatFriendlyAiError(err: unknown, providerName: string): { status: number; message: string } {\\n  const error = err as Error & { status?: number };\\n  const rawMsg = error?.message || \'AI provider request failed.\';\\n  const lower = rawMsg.toLowerCase();\\n\\n  if (error?.status === 429 || lower.includes(\'resource_exhausted\') || lower.includes(\'quota\') || lower.includes(\'rate limit\')) {\\n    return {\\n      status: 429,\\n      message: `${providerName} quota is temporarily exhausted. Switch to Gemini Flash Lite, OpenAI, Anthropic, NVIDIA NIM, Groq, or a Local LLM using the AI Provider dropdown!`,\\n    };\\n  }\\n  if (error?.status === 401 || lower.includes(\'invalid api key\') || lower.includes(\'unauthorized\') || lower.includes(\'authentication\')) {\\n    return {\\n      status: 401,\\n      message: `${providerName} rejected the API key. Double-check your key in the AI Provider menu.`,\\n    };\\n  }\\n  return { status: error?.status || 500, message: rawMsg };\\n}\\n\\nfunction buildSummarizePrompts(snapshot: RepoSnapshot) {\\n  const commitsPayload = snapshot.commits.slice(0, 10).map((c) => ({\\n    sha: c.shortSha,\\n    author: c.authorLogin,\\n    message: c.firstLine,\\n    date: c.date.slice(0, 10),\\n  }));\\n\\n  const prsPayload = snapshot.mergedPRs.slice(0, 8).map((p) => ({\\n    number: p.number,\\n    title: p.title,\\n    author: p.userLogin,\\n    mergedAt: p.mergedAt.slice(0, 10),\\n  }));\\n\\n  const latestRelease = snapshot.releases[0]\\n    ? {\\n        tagName: snapshot.releases[0].tagName,\\n        name: snapshot.releases[0].name,\\n        publishedAt: snapshot.releases[0].publishedAt.slice(0, 10),\\n        notes: snapshot.releases[0].body.slice(0, 1500),\\n      }\\n    : null;\\n\\n  const systemInstruction =\\n    \'You are PulseIsle, a playful, warm community storyteller who transforms raw GitHub developer activity into clear, exciting, jargon-free progress reports for non-developers, project stakeholders, and fans. NEVER paste raw commit jargon, ticket IDs, or code syntax into headlines, chapter titles, or plain-English summaries. Always explain real-world user impact using friendly analogies, crisp everyday English, and cheerful emojis.\';\\n\\n  const userPrompt = `Repository: ${snapshot.repo.fullName}\\nDescription: ${snapshot.repo.description}\\nPrimary language: ${snapshot.repo.language}\\nStars: ${snapshot.repo.stars} | Forks: ${snapshot.repo.forks} | Open Issues: ${snapshot.repo.openIssues}\\nTop Contributors: ${snapshot.contributors.slice(0, 5).map((c) => `${c.login} (${c.contributions})`).join(\', \')}\\n\\nRecent Commits:\\n${JSON.stringify(commitsPayload, null, 2)}\\n\\nRecently Merged Pull Requests:\\n${JSON.stringify(prsPayload, null, 2)}\\n\\nLatest Release:\\n${latestRelease ? JSON.stringify(latestRelease, null, 2) : \'No formal GitHub releases yet.\'}\\n\\nYour job is to SYNTHESIZE all of this raw engineering work into an exciting, super clear, non-technical Community Progress Report:\\n1. Create 3 to 4 thematic \\\"progressChapters\\\" that group related commits & PRs into human stories (e.g., Speed Boosts, New Features, Bug Fixes & Stability, Clearer Docs) \342\200\224 do NOT just copy commit messages! Explain what changed in everyday language with 2-3 crisp \\\"keyWins\\\" per chapter.\\n2. Create 3 fun \\\"jargonDecoder\\\" entries translating actual technical words/acronyms seen in these commits/PRs/release notes into plain everyday English.\\n3. Write 4 short \\\"lifecycleStageBriefs\\\" (1-2 friendly sentences each) explaining what is happening right now at each stage of this repo\'s development lifecycle (commits, prs, community, release).\\n4. Also translate each individual commit (matching exact short sha) and each merged PR (matching exact PR number) into simple jargon-free English.`;\\n\\n  const jsonSchemaContract = `Return ONLY a valid JSON object matching this exact schema (no markdown commentary outside JSON):\\n{\\n  \\\"headline\\\": \\\"string (under 14 words)\\\",\\n  \\\"playfulSummary\\\": \\\"string (2-3 upbeat plain-English sentences)\\\",\\n  \\\"momentumMood\\\": \\\"string (2-3 words like Speeding Ahead)\\\",\\n  \\\"momentumEmoji\\\": \\\"string (single emoji)\\\",\\n  \\\"nextMilestoneEstimate\\\": \\\"string (1 sentence)\\\",\\n  \\\"milestoneProgressPct\\\": 72,\\n  \\\"progressChapters\\\": [\\n    {\\n      \\\"emoji\\\": \\\"\342\232\241\\\",\\n      \\\"title\\\": \\\"string\\\",\\n      \\\"summary\\\": \\\"string (1-2 sentences)\\\",\\n      \\\"impactLabel\\\": \\\"Major Win | Reliability Boost | Smooth Polish\\\",\\n      \\\"keyWins\\\": [\\\"string\\\", \\\"string\\\"],\\n      \\\"relatedCount\\\": 4\\n    }\\n  ],\\n  \\\"jargonDecoder\\\": [\\n    { \\\"term\\\": \\\"string\\\", \\\"plainMeaning\\\": \\\"string\\\", \\\"emoji\\\": \\\"\360\237\222\241\\\" }\\n  ],\\n  \\\"lifecycleStageBriefs\\\": {\\n    \\\"commits\\\": \\\"string\\\",\\n    \\\"prs\\\": \\\"string\\\",\\n    \\\"community\\\": \\\"string\\\",\\n    \\\"release\\\": \\\"string\\\"\\n  },\\n  \\\"releaseTranslation\\\": ${\\n    latestRelease\\n      ? \'{ \\\"tagName\\\": \\\"string\\\", \\\"cheerfulTitle\\\": \\\"string\\\", \\\"summary\\\": \\\"string\\\", \\\"highlights\\\": [{ \\\"emoji\\\": \\\"\360\237\216\211\\\", \\\"text\\\": \\\"string\\\" }] }\'\\n      : \'null\'\\n  },\\n  \\\"commitTranslations\\\": [\\n    { \\\"sha\\\": \\\"exact shortSha\\\", \\\"emoji\\\": \\\"\342\234\250\\\", \\\"plainTitle\\\": \\\"string\\\", \\\"whyItMatters\\\": \\\"string\\\", \\\"category\\\": \\\"Feature|Fix|Speed|Docs|Polish\\\" }\\n  ],\\n  \\\"prTranslations\\\": [\\n    { \\\"number\\\": 123, \\\"emoji\\\": \\\"\360\237\232\200\\\", \\\"plainTitle\\\": \\\"string\\\", \\\"whyItMatters\\\": \\\"string\\\", \\\"category\\\": \\\"Feature|Fix|Speed|Docs|Polish\\\" }\\n  ]\\n}`;\\n\\n  return { systemInstruction, userPrompt, jsonSchemaContract, hasLatestRelease: Boolean(latestRelease) };\\n}\\n\\nfunction buildChatSystemInstruction(snapshot: RepoSnapshot, digest: AiDigest | null): string {\\n  const repoContext = `ACTIVE REPOSITORY: ${snapshot.repo.fullName}\\nDescription: ${snapshot.repo.description}\\nStats: ${snapshot.repo.stars.toLocaleString()} stars, ${snapshot.repo.forks.toLocaleString()} forks, ${snapshot.repo.openIssues.toLocaleString()} open issues, primary language: ${snapshot.repo.language}.\\nLatest Release: ${snapshot.releases[0] ? `${snapshot.releases[0].tagName} (${snapshot.releases[0].name}) on ${snapshot.releases[0].publishedAt.slice(0, 10)}\\\\nNotes: ${snapshot.releases[0].body.slice(0, 900)}` : \'None published yet.\'}\\nTop Contributors: ${snapshot.contributors.map((c) => `${c.login} (${c.contributions} contributions)`).join(\', \')}\\nRecent Commits:\\n${snapshot.commits.slice(0, 12).map((c) => `- [${c.shortSha}] (${c.date.slice(0, 10)}) by ${c.authorLogin}: ${c.firstLine}`).join(\'\\\\n\')}\\nRecently Merged PRs:\\n${snapshot.mergedPRs.slice(0, 8).map((p) => `- #${p.number} (${p.mergedAt.slice(0, 10)}) by ${p.userLogin}: ${p.title}`).join(\'\\\\n\')}\\n${digest ? `Current AI Community Briefing: ${digest.headline} \342\200\224 ${digest.playfulSummary}` : \'\'}`;\\n\\n  return `You are PulseIsle\'s friendly open-source tour guide! Your job is to answer questions from non-technical community members, stakeholders, and curious fans about the GitHub repository below.\\n\\nStyle rules:\\n- Use a warm, playful, encouraging tone with tasteful emojis.\\n- Translate every technical term into simple everyday analogies (e.g., explain what a pull request, dependency bump, refactor, or compiler fix means in human terms).\\n- Stay strictly grounded in the live repository facts below. If asked about something not in the recent data, be transparent and explain what the recent activity *does* show.\\n- Keep answers concise, scannable, and easy to read (short paragraphs or crisp bullet points).\\n\\n${repoContext}`;\\n}\\n\\nasync function startServer() {\\n  const app = express();\\n  app.use(express.json({ limit: \'2mb\' }));\\n\\n  // 1. Live GitHub Repo Aggregator with 1-call ETag delta sync\\n  app.get(\'/api/github/repo\', async (req: Request, res: Response) => {\\n    try {\\n      const rawRepo = String(req.query.repo || \'\');\\n      const forceSync = req.query.sync === \'1\';\\n      const parsed = parseRepoInput(rawRepo);\\n\\n      if (!parsed) {\\n        res.status(400).json({\\n          error:\\n            \'Please enter a valid GitHub URL (https://github.com/owner/repo) or owner/repo handle.\',\\n        });\\n        return;\\n      }\\n\\n      const { owner, repo } = parsed;\\n      const cacheKey = `${owner}/${repo}`.toLowerCase();\\n      const base = `https://api.github.com/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}`;\\n      const existingSnap = snapshotCache.get(cacheKey);\\n\\n      if (existingSnap && !forceSync && Date.now() - existingSnap.fetchedAt < ENDPOINT_CACHE_TTL_MS) {\\n        res.json({ ...existingSnap.snapshot, cached: true });\\n        return;\\n      }\\n\\n      if (forceSync && existingSnap) {\\n        try {\\n          const headCheck = await githubFetch<Record<string, unknown>[]>(\\n            `${base}/commits?per_page=1`,\\n            true\\n          );\\n          const latestHeadSha = String(headCheck.data?.[0]?.sha || \'\');\\n          const prevHeadSha = existingSnap.snapshot.commits[0]?.sha || \'\';\\n          if (headCheck.notModified || (latestHeadSha && latestHeadSha === prevHeadSha)) {\\n            const refreshed: RepoSnapshot = {\\n              ...existingSnap.snapshot,\\n              syncedAt: new Date().toISOString(),\\n              rateLimitRemaining: headCheck.rateLimitRemaining,\\n              cached: true,\\n            };\\n            snapshotCache.set(cacheKey, { snapshot: refreshed, fetchedAt: Date.now() });\\n            res.json(refreshed);\\n            return;\\n          }\\n        } catch {\\n          res.json({\\n            ...existingSnap.snapshot,\\n            syncedAt: new Date().toISOString(),\\n            cached: true,\\n          });\\n          return;\\n        }\\n      }\\n\\n      const [repoRes, commitsRes, pullsRes, releasesRes, contribRes] = await Promise.all([\\n        githubFetch<Record<string, unknown>>(base, forceSync),\\n        githubFetch<Record<string, unknown>[]>(`${base}/commits?per_page=25`, forceSync).catch(\\n          () => ({\\n            data: [] as Record<string, unknown>[],\\n            fromCache: false,\\n            notModified: false,\\n            rateLimitRemaining: null,\\n          })\\n        ),\\n        githubFetch<Record<string, unknown>[]>(\\n          `${base}/pulls?state=closed&sort=updated&direction=desc&per_page=18`,\\n          forceSync\\n        ).catch(() => ({\\n          data: [] as Record<string, unknown>[],\\n          fromCache: false,\\n          notModified: false,\\n          rateLimitRemaining: null,\\n        })),\\n        githubFetch<Record<string, unknown>[]>(`${base}/releases?per_page=5`, forceSync).catch(\\n          () => ({\\n            data: [] as Record<string, unknown>[],\\n            fromCache: false,\\n            notModified: false,\\n            rateLimitRemaining: null,\\n          })\\n        ),\\n        githubFetch<Record<string, unknown>[]>(\\n          `${base}/contributors?per_page=8`,\\n          forceSync\\n        ).catch(() => ({\\n          data: [] as Record<string, unknown>[],\\n          fromCache: false,\\n          notModified: false,\\n          rateLimitRemaining: null,\\n        })),\\n      ]);\\n\\n      const r = repoRes.data;\\n      const ownerObj = (r.owner as Record<string, unknown>) || {};\\n      const licenseObj = (r.license as Record<string, unknown>) || null;\\n\\n      const allCommits: CommitItem[] = (commitsRes.data || []).map((item) => {\\n        const commitObj = (item.commit as Record<string, unknown>) || {};\\n        const commitAuthor = (commitObj.author as Record<string, unknown>) || {};\\n        const ghAuthor = (item.author as Record<string, unknown>) || {};\\n        const msg = String(commitObj.message || \'Update repository\');\\n        const sha = String(item.sha || \'\');\\n        return {\\n          sha,\\n          shortSha: sha.slice(0, 7),\\n          message: msg,\\n          firstLine: msg.split(\'\\\\n\')[0].trim(),\\n          authorName: String(commitAuthor.name || ghAuthor.login || \'Contributor\'),\\n          authorLogin: String(ghAuthor.login || commitAuthor.name || \'contributor\'),\\n          authorAvatar: String(ghAuthor.avatar_url || \'\'),\\n          date: String(commitAuthor.date || new Date().toISOString()),\\n          htmlUrl: String(item.html_url || \'\'),\\n        };\\n      });\\n\\n      const mergedPRs: PullRequestItem[] = (pullsRes.data || [])\\n        .filter((pr) => Boolean(pr.merged_at))\\n        .slice(0, 10)\\n        .map((pr) => {\\n          const user = (pr.user as Record<string, unknown>) || {};\\n          const labels = Array.isArray(pr.labels)\\n            ? pr.labels.map((l) => String((l as Record<string, unknown>).name || \'\')).filter(Boolean)\\n            : [];\\n          return {\\n            number: Number(pr.number || 0),\\n            title: String(pr.title || \'Merged Pull Request\'),\\n            userLogin: String(user.login || \'contributor\'),\\n            userAvatar: String(user.avatar_url || \'\'),\\n            mergedAt: String(pr.merged_at),\\n            htmlUrl: String(pr.html_url || \'\'),\\n            labels: labels.slice(0, 3),\\n          };\\n        });\\n\\n      const releases: ReleaseItem[] = (releasesRes.data || []).slice(0, 5).map((rel) => {\\n        const author = (rel.author as Record<string, unknown>) || {};\\n        return {\\n          id: Number(rel.id || 0),\\n          tagName: String(rel.tag_name || \'v0.0.0\'),\\n          name: String(rel.name || rel.tag_name || \'Latest Release\'),\\n          publishedAt: String(rel.published_at || rel.created_at || new Date().toISOString()),\\n          body: String(rel.body || \'\').slice(0, 2200),\\n          htmlUrl: String(rel.html_url || \'\'),\\n          authorLogin: String(author.login || \'maintainer\'),\\n        };\\n      });\\n\\n      const contributors: ContributorItem[] = (contribRes.data || []).slice(0, 8).map((c) => ({\\n        login: String(c.login || \'contributor\'),\\n        avatarUrl: String(c.avatar_url || \'\'),\\n        contributions: Number(c.contributions || 0),\\n        htmlUrl: String(c.html_url || \'\'),\\n      }));\\n\\n      const velocitySeries = buildVelocitySeries(allCommits, mergedPRs);\\n\\n      const snapshot: RepoSnapshot = {\\n        repo: {\\n          owner: String(ownerObj.login || owner),\\n          name: String(r.name || repo),\\n          fullName: String(r.full_name || `${owner}/${repo}`),\\n          description: String(r.description || \'An active open-source project on GitHub.\'),\\n          stars: Number(r.stargazers_count || 0),\\n          forks: Number(r.forks_count || 0),\\n          openIssues: Number(r.open_issues_count || 0),\\n          watchers: Number(r.subscribers_count || r.watchers_count || 0),\\n          language: String(r.language || \'Open Source\'),\\n          defaultBranch: String(r.default_branch || \'main\'),\\n          pushedAt: String(r.pushed_at || new Date().toISOString()),\\n          updatedAt: String(r.updated_at || new Date().toISOString()),\\n          createdAt: String(r.created_at || new Date().toISOString()),\\n          htmlUrl: String(r.html_url || `https://github.com/${owner}/${repo}`),\\n          avatarUrl: String(ownerObj.avatar_url || \'\'),\\n          topics: Array.isArray(r.topics) ? (r.topics as string[]).slice(0, 6) : [],\\n          license: licenseObj ? String(licenseObj.spdx_id || licenseObj.name || \'\') : null,\\n        },\\n        commits: allCommits.slice(0, 14),\\n        mergedPRs,\\n        releases,\\n        contributors,\\n        velocitySeries,\\n        syncedAt: new Date().toISOString(),\\n        rateLimitRemaining: repoRes.rateLimitRemaining,\\n        cached: repoRes.fromCache && commitsRes.fromCache,\\n      };\\n\\n      snapshotCache.set(cacheKey, { snapshot, fetchedAt: Date.now() });\\n      res.json(snapshot);\\n    } catch (err: unknown) {\\n      const error = err as Error & { status?: number };\\n      const status = error.status || 500;\\n      res.status(status).json({ error: error.message || \'Failed to fetch repository data.\' });\\n    }\\n  });\\n\\n  // 2. Multi-Provider AI Plain-English Community Digest & Jargon Decoder\\n  app.post(\'/api/ai/summarize\', async (req: Request, res: Response) => {\\n    const { snapshot, providerConfig } = req.body as {\\n      snapshot?: RepoSnapshot;\\n      providerConfig?: AiProviderConfig;\\n    };\\n\\n    const provider = providerConfig?.provider || \'gemini\';\\n    const model =\\n      providerConfig?.model ||\\n      (provider === \'gemini-lite\' ? \'gemini-3.1-flash-lite\' : \'gemini-4-hydrogen\');\\n\\n    try {\\n      if (!snapshot?.repo?.fullName) {\\n        res.status(400).json({ error: \'Missing repository snapshot for AI summary.\' });\\n        return;\\n      }\\n\\n      const latestSha = snapshot.commits[0]?.shortSha || \'none\';\\n      const latestTag = snapshot.releases[0]?.tagName || \'none\';\\n      const dCacheKey = `${provider}::${model}::${snapshot.repo.fullName.toLowerCase()}::${latestSha}::${latestTag}`;\\n      const cachedDigest = digestCache.get(dCacheKey);\\n      if (cachedDigest && Date.now() - cachedDigest.generatedAt < DIGEST_CACHE_TTL_MS) {\\n        res.json(cachedDigest.digest);\\n        return;\\n      }\\n\\n      const { systemInstruction, userPrompt, jsonSchemaContract, hasLatestRelease } =\\n        buildSummarizePrompts(snapshot);\\n\\n      let digest: AiDigest;\\n\\n      if (provider === \'gemini\' || provider === \'gemini-lite\') {\\n        const ai = createGeminiClient();\\n        const geminiModel =\\n          provider === \'gemini-lite\' ? \'gemini-3.1-flash-lite\' : \'gemini-4-hydrogen\';\\n\\n        const config: Record<string, unknown> = {\\n          systemInstruction,\\n          responseMimeType: \'application/json\',\\n          responseSchema: {\\n            type: Type.OBJECT,\\n            properties: {\\n              headline: { type: Type.STRING },\\n              playfulSummary: { type: Type.STRING },\\n              momentumMood: { type: Type.STRING },\\n              momentumEmoji: { type: Type.STRING },\\n              nextMilestoneEstimate: { type: Type.STRING },\\n              milestoneProgressPct: { type: Type.NUMBER },\\n              progressChapters: {\\n                type: Type.ARRAY,\\n                items: {\\n                  type: Type.OBJECT,\\n                  properties: {\\n                    emoji: { type: Type.STRING },\\n                    title: { type: Type.STRING },\\n                    summary: { type: Type.STRING },\\n                    impactLabel: { type: Type.STRING },\\n                    keyWins: { type: Type.ARRAY, items: { type: Type.STRING } },\\n                    relatedCount: { type: Type.INTEGER },\\n                  },\\n                  required: [\'emoji\', \'title\', \'summary\', \'impactLabel\', \'keyWins\', \'relatedCount\'],\\n                },\\n              },\\n              jargonDecoder: {\\n                type: Type.ARRAY,\\n                items: {\\n                  type: Type.OBJECT,\\n                  properties: {\\n                    term: { type: Type.STRING },\\n                    plainMeaning: { type: Type.STRING },\\n                    emoji: { type: Type.STRING },\\n                  },\\n                  required: [\'term\', \'plainMeaning\', \'emoji\'],\\n                },\\n              },\\n              lifecycleStageBriefs: {\\n                type: Type.OBJECT,\\n                properties: {\\n                  commits: { type: Type.STRING },\\n                  prs: { type: Type.STRING },\\n                  community: { type: Type.STRING },\\n                  release: { type: Type.STRING },\\n                },\\n                required: [\'commits\', \'prs\', \'community\', \'release\'],\\n              },\\n              releaseTranslation: {\\n                type: Type.OBJECT,\\n                nullable: true,\\n                properties: {\\n                  tagName: { type: Type.STRING },\\n                  cheerfulTitle: { type: Type.STRING },\\n                  summary: { type: Type.STRING },\\n                  highlights: {\\n                    type: Type.ARRAY,\\n                    items: {\\n                      type: Type.OBJECT,\\n                      properties: {\\n                        emoji: { type: Type.STRING },\\n                        text: { type: Type.STRING },\\n                      },\\n                      required: [\'emoji\', \'text\'],\\n                    },\\n                  },\\n                },\\n                required: [\'tagName\', \'cheerfulTitle\', \'summary\', \'highlights\'],\\n              },\\n              commitTranslations: {\\n                type: Type.ARRAY,\\n                items: {\\n                  type: Type.OBJECT,\\n                  properties: {\\n                    sha: { type: Type.STRING },\\n                    emoji: { type: Type.STRING },\\n                    plainTitle: { type: Type.STRING },\\n                    whyItMatters: { type: Type.STRING },\\n                    category: { type: Type.STRING },\\n                  },\\n                  required: [\'sha\', \'emoji\', \'plainTitle\', \'whyItMatters\', \'category\'],\\n                },\\n              },\\n              prTranslations: {\\n                type: Type.ARRAY,\\n                items: {\\n                  type: Type.OBJECT,\\n                  properties: {\\n                    number: { type: Type.INTEGER },\\n                    emoji: { type: Type.STRING },\\n                    plainTitle: { type: Type.STRING },\\n                    whyItMatters: { type: Type.STRING },\\n                    category: { type: Type.STRING },\\n                  },\\n                  required: [\'number\', \'emoji\', \'plainTitle\', \'whyItMatters\', \'category\'],\\n                },\\n              },\\n            },\\n            required: [\\n              \'headline\',\\n              \'playfulSummary\',\\n              \'momentumMood\',\\n              \'momentumEmoji\',\\n              \'nextMilestoneEstimate\',\\n              \'milestoneProgressPct\',\\n              \'progressChapters\',\\n              \'jargonDecoder\',\\n              \'lifecycleStageBriefs\',\\n              \'commitTranslations\',\\n              \'prTranslations\',\\n            ],\\n          },\\n        };\\n\\n        if (geminiModel === \'gemini-4-hydrogen\') {\\n          config.thinkingConfig = { thinkingLevel: ThinkingLevel.LOW };\\n        }\\n\\n        const response = await ai.models.generateContent({\\n          model: geminiModel,\\n          contents: userPrompt,\\n          config,\\n        });\\n\\n        const parsed = extractJsonObject(response.text || \'{}\') as Partial<AiDigest>;\\n        digest = normalizeDigest(parsed, snapshot, hasLatestRelease);\\n      } else if (provider === \'anthropic\') {\\n        const apiKey = providerConfig?.apiKey?.trim();\\n        if (!apiKey) {\\n          res.status(400).json({\\n            error: \'Please enter your Anthropic API key in the AI Provider dropdown.\',\\n          });\\n          return;\\n        }\\n\\n        const resp = await fetch(\'https://api.anthropic.com/v1/messages\', {\\n          method: \'POST\',\\n          headers: {\\n            \'Content-Type\': \'application/json\',\\n            \'x-api-key\': apiKey,\\n            \'anthropic-version\': \'2023-06-01\',\\n          },\\n          body: JSON.stringify({\\n            model,\\n            max_tokens: 2400,\\n            system: `${systemInstruction}\\\\n\\\\n${jsonSchemaContract}`,\\n            messages: [{ role: \'user\', content: userPrompt }],\\n          }),\\n        });\\n\\n        if (!resp.ok) {\\n          const errJson = (await resp.json().catch(() => ({}))) as {\\n            error?: { message?: string };\\n          };\\n          const err = new Error(\\n            errJson.error?.message || `Anthropic returned HTTP ${resp.status}`\\n          ) as Error & { status?: number };\\n          err.status = resp.status;\\n          throw err;\\n        }\\n\\n        const data = (await resp.json()) as {\\n          content?: { type: string; text?: string }[];\\n        };\\n        const text = data.content?.find((b) => b.type === \'text\')?.text || \'{}\';\\n        const parsed = extractJsonObject(text) as Partial<AiDigest>;\\n        digest = normalizeDigest(parsed, snapshot, hasLatestRelease);\\n      } else {\\n        // OpenAI, NVIDIA NIM, Groq, OpenRouter (OpenAI-compatible REST API)\\n        const baseUrl = (\\n          providerConfig?.baseUrl ||\\n          OPENAI_COMPAT_BASE_URLS[provider] ||\\n          \'\'\\n        ).replace(/\\\\/+$/, \'\');\\n        const apiKey = providerConfig?.apiKey?.trim();\\n\\n        if (!baseUrl) {\\n          res.status(400).json({ error: `Unsupported AI provider \\\"${provider}\\\".` });\\n          return;\\n        }\\n        if (!apiKey) {\\n          res.status(400).json({\\n            error: `Please enter your ${provider.toUpperCase()} API key in the AI Provider dropdown.`,\\n          });\\n          return;\\n        }\\n\\n        const headers: Record<string, string> = {\\n          \'Content-Type\': \'application/json\',\\n          Authorization: `Bearer ${apiKey}`,\\n        };\\n        if (provider === \'openrouter\') {\\n          headers[\'HTTP-Referer\'] = process.env.APP_URL || \'http://localhost:3000\';\\n          headers[\'X-Title\'] = \'PulseIsle\';\\n        }\\n\\n        const bodyPayload: Record<string, unknown> = {\\n          model,\\n          messages: [\\n            { role: \'system\', content: `${systemInstruction}\\\\n\\\\n${jsonSchemaContract}` },\\n            { role: \'user\', content: userPrompt },\\n          ],\\n        };\\n        if (provider === \'openai\' || provider === \'groq\') {\\n          bodyPayload.response_format = { type: \'json_object\' };\\n        }\\n\\n        const resp = await fetch(`${baseUrl}/chat/completions`, {\\n          method: \'POST\',\\n          headers,\\n          body: JSON.stringify(bodyPayload),\\n        });\\n\\n        if (!resp.ok) {\\n          const errJson = (await resp.json().catch(() => ({}))) as {\\n            error?: { message?: string };\\n            detail?: string;\\n          };\\n          const err = new Error(\\n            errJson.error?.message ||\\n              errJson.detail ||\\n              `${provider.toUpperCase()} returned HTTP ${resp.status}`\\n          ) as Error & { status?: number };\\n          err.status = resp.status;\\n          throw err;\\n        }\\n\\n        const data = (await resp.json()) as {\\n          choices?: { message?: { content?: string } }[];\\n        };\\n        const text = data.choices?.[0]?.message?.content || \'{}\';\\n        const parsed = extractJsonObject(text) as Partial<AiDigest>;\\n        digest = normalizeDigest(parsed, snapshot, hasLatestRelease);\\n      }\\n\\n      digestCache.set(dCacheKey, { digest, generatedAt: Date.now() });\\n      res.json(digest);\\n    } catch (err: unknown) {\\n      console.error(\'AI summarize error:\', err);\\n      const formatted = formatFriendlyAiError(err, provider.toUpperCase());\\n      res.status(formatted.status).json({ error: formatted.message });\\n    }\\n  });\\n\\n  // 3. Multi-Provider Streaming Community Q&A Chat\\n  app.post(\'/api/ai/chat\', async (req: Request, res: Response) => {\\n    const { snapshot, digest, messages, providerConfig } = req.body as {\\n      snapshot?: RepoSnapshot;\\n      digest?: AiDigest | null;\\n      messages?: { role: \'user\' | \'assistant\'; content: string }[];\\n      providerConfig?: AiProviderConfig;\\n    };\\n\\n    const provider = providerConfig?.provider || \'gemini\';\\n    const model =\\n      providerConfig?.model ||\\n      (provider === \'gemini-lite\' ? \'gemini-3.1-flash-lite\' : \'gemini-4-hydrogen\');\\n\\n    try {\\n      if (!snapshot?.repo?.fullName || !Array.isArray(messages) || messages.length === 0) {\\n        res.status(400).json({ error: \'Missing repository context or chat messages.\' });\\n        return;\\n      }\\n\\n      const systemInstruction = buildChatSystemInstruction(snapshot, digest ?? null);\\n\\n      const startSse = () => {\\n        res.setHeader(\'Content-Type\', \'text/event-stream\');\\n        res.setHeader(\'Cache-Control\', \'no-cache\');\\n        res.setHeader(\'Connection\', \'keep-alive\');\\n        res.flushHeaders?.();\\n      };\\n\\n      if (provider === \'gemini\' || provider === \'gemini-lite\') {\\n        const ai = createGeminiClient();\\n        const geminiModel =\\n          provider === \'gemini-lite\' ? \'gemini-3.1-flash-lite\' : \'gemini-4-hydrogen\';\\n\\n        const contents = messages.slice(-10).map((m) => ({\\n          role: m.role === \'assistant\' ? \'model\' : \'user\',\\n          parts: [{ text: m.content }],\\n        }));\\n\\n        const config: Record<string, unknown> = { systemInstruction };\\n        if (geminiModel === \'gemini-4-hydrogen\') {\\n          config.thinkingConfig = { thinkingLevel: ThinkingLevel.LOW };\\n        }\\n\\n        const stream = await ai.models.generateContentStream({\\n          model: geminiModel,\\n          contents,\\n          config,\\n        });\\n\\n        startSse();\\n        for await (const chunk of stream) {\\n          if (chunk.text) {\\n            res.write(`data: ${JSON.stringify({ text: chunk.text })}\\\\n\\\\n`);\\n          }\\n        }\\n        res.write(\'data: [DONE]\\\\n\\\\n\');\\n        res.end();\\n        return;\\n      }\\n\\n      if (provider === \'anthropic\') {\\n        const apiKey = providerConfig?.apiKey?.trim();\\n        if (!apiKey) {\\n          res.status(400).json({\\n            error: \'Please enter your Anthropic API key in the AI Provider dropdown.\',\\n          });\\n          return;\\n        }\\n\\n        const upstream = await fetch(\'https://api.anthropic.com/v1/messages\', {\\n          method: \'POST\',\\n          headers: {\\n            \'Content-Type\': \'application/json\',\\n            \'x-api-key\': apiKey,\\n            \'anthropic-version\': \'2023-06-01\',\\n          },\\n          body: JSON.stringify({\\n            model,\\n            max_tokens: 1400,\\n            stream: true,\\n            system: systemInstruction,\\n            messages: messages.slice(-10).map((m) => ({ role: m.role, content: m.content })),\\n          }),\\n        });\\n\\n        if (!upstream.ok || !upstream.body) {\\n          const errJson = (await upstream.json().catch(() => ({}))) as {\\n            error?: { message?: string };\\n          };\\n          const err = new Error(\\n            errJson.error?.message || `Anthropic returned HTTP ${upstream.status}`\\n          ) as Error & { status?: number };\\n          err.status = upstream.status;\\n          throw err;\\n        }\\n\\n        startSse();\\n        const reader = upstream.body.getReader();\\n        const decoder = new TextDecoder();\\n        let buffer = \'\';\\n\\n        while (true) {\\n          const { done, value } = await reader.read();\\n          if (done) break;\\n          buffer += decoder.decode(value, { stream: true });\\n          const lines = buffer.split(\'\\\\n\');\\n          buffer = lines.pop() || \'\';\\n          for (const rawLine of lines) {\\n            const line = rawLine.trim();\\n            if (!line.startsWith(\'data:\')) continue;\\n            const payload = line.slice(5).trim();\\n            try {\\n              const parsed = JSON.parse(payload) as {\\n                type?: string;\\n                delta?: { type?: string; text?: string };\\n              };\\n              if (parsed.type === \'content_block_delta\' && parsed.delta?.text) {\\n                res.write(`data: ${JSON.stringify({ text: parsed.delta.text })}\\\\n\\\\n`);\\n              }\\n            } catch {\\n              // Ignore non-JSON lines\\n            }\\n          }\\n        }\\n        res.write(\'data: [DONE]\\\\n\\\\n\');\\n        res.end();\\n        return;\\n      }\\n\\n      // OpenAI-compatible streaming (OpenAI, NVIDIA NIM, Groq, OpenRouter)\\n      const baseUrl = (\\n        providerConfig?.baseUrl ||\\n        OPENAI_COMPAT_BASE_URLS[provider] ||\\n        \'\'\\n      ).replace(/\\\\/+$/, \'\');\\n      const apiKey = providerConfig?.apiKey?.trim();\\n\\n      if (!baseUrl || !apiKey) {\\n        res.status(400).json({\\n          error: `Please provide your ${provider.toUpperCase()} API key in the AI Provider dropdown.`,\\n        });\\n        return;\\n      }\\n\\n      const headers: Record<string, string> = {\\n        \'Content-Type\': \'application/json\',\\n        Authorization: `Bearer ${apiKey}`,\\n      };\\n      if (provider === \'openrouter\') {\\n        headers[\'HTTP-Referer\'] = process.env.APP_URL || \'http://localhost:3000\';\\n        headers[\'X-Title\'] = \'PulseIsle\';\\n      }\\n\\n      const upstream = await fetch(`${baseUrl}/chat/completions`, {\\n        method: \'POST\',\\n        headers,\\n        body: JSON.stringify({\\n          model,\\n          stream: true,\\n          messages: [\\n            { role: \'system\', content: systemInstruction },\\n            ...messages.slice(-10).map((m) => ({ role: m.role, content: m.content })),\\n          ],\\n        }),\\n      });\\n\\n      if (!upstream.ok || !upstream.body) {\\n        const errJson = (await upstream.json().catch(() => ({}))) as {\\n          error?: { message?: string };\\n          detail?: string;\\n        };\\n        const err = new Error(\\n          errJson.error?.message ||\\n            errJson.detail ||\\n            `${provider.toUpperCase()} returned HTTP ${upstream.status}`\\n        ) as Error & { status?: number };\\n        err.status = upstream.status;\\n        throw err;\\n      }\\n\\n      startSse();\\n      const reader = upstream.body.getReader();\\n      const decoder = new TextDecoder();\\n      let buffer = \'\';\\n\\n      while (true) {\\n        const { done, value } = await reader.read();\\n        if (done) break;\\n        buffer += decoder.decode(value, { stream: true });\\n        const lines = buffer.split(\'\\\\n\');\\n        buffer = lines.pop() || \'\';\\n        for (const rawLine of lines) {\\n          const line = rawLine.trim();\\n          if (!line.startsWith(\'data:\')) continue;\\n          const payload = line.slice(5).trim();\\n          if (payload === \'[DONE]\') continue;\\n          try {\\n            const parsed = JSON.parse(payload) as {\\n              choices?: { delta?: { content?: string } }[];\\n            };\\n            const text = parsed.choices?.[0]?.delta?.content;\\n            if (text) {\\n              res.write(`data: ${JSON.stringify({ text })}\\\\n\\\\n`);\\n            }\\n          } catch {\\n            // Ignore partial chunks\\n          }\\n        }\\n      }\\n      res.write(\'data: [DONE]\\\\n\\\\n\');\\n      res.end();\\n    } catch (err: unknown) {\\n      console.error(\'AI chat error:\', err);\\n      const formatted = formatFriendlyAiError(err, provider.toUpperCase());\\n      if (!res.headersSent) {\\n        res.status(formatted.status).json({ error: formatted.message });\\n      } else {\\n        res.write(`data: ${JSON.stringify({ error: formatted.message })}\\\\n\\\\n`);\\n        res.end();\\n      }\\n    }\\n  });\\n\\n  if (IS_PROD) {\\n    const distDir = path.resolve(__dirname, \'dist\');\\n    app.use(express.static(distDir));\\n    app.get(\'*\', (_req, res) => {\\n      res.sendFile(path.join(distDir, \'index.html\'));\\n    });\\n  } else {\\n    const { createServer: createViteServer } = await import(\'vite\');\\n    const vite = await createViteServer({\\n      server: { middlewareMode: true },\\n      appType: \'spa\',\\n    });\\n    app.use(vite.middlewares);\\n  }\\n\\n  app.listen(PORT, \'0.0.0.0\', () => {\\n    console.log(`PulseIsle server running at http://localhost:${PORT}`);\\n  });\\n}\\n\\nstartServer();\\n\", \"Description\":\"Extend Express /api/ai/summarize and /api/ai/chat routes to support Built-in Gemini, Gemini Flash Lite, OpenAI, Anthropic Claude, NVIDIA NIM, Groq, and OpenRouter with unified streaming and friendly quota error messages.\", \"Overwrite\":true, \"TargetFile\":\"/server.ts\"}"
      original_name: "write_to_file"
    }
