              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - **Velocity Charts & Contributor Spotlight**: Animated interactive charts (commit cadence area/bar chart, PR merge momentum, and animated milestone progress bars) paired with a top-contributors leaderboard highlighting recent momentum and cheerful rank badges."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
