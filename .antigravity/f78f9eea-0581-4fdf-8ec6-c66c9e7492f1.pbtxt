      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add AI provider configuration types to src/types.ts.\", \"EndLine\":176, \"Instruction\":\"Append AiProviderId and AiProviderConfig interfaces to src/types.ts\", \"ReplacementContent\":\"export interface LifecycleStageInfo {\\n  id: LifecycleStageId;\\n  stepNumber: number;\\n  label: string;\\n  metricText: string;\\n  emoji: string;\\n  whatThisStageMeans: string;\\n  liveSummary: string;\\n  url: string;\\n  cameraPos: [number, number, number];\\n  lookAt: [number, number, number];\\n  worldAnchor: [number, number, number];\\n}\\n\\nexport type AiProviderId =\\n  | \'gemini\'\\n  | \'gemini-lite\'\\n  | \'openai\'\\n  | \'anthropic\'\\n  | \'nvidia\'\\n  | \'groq\'\\n  | \'openrouter\'\\n  | \'local\';\\n\\nexport interface AiProviderConfig {\\n  provider: AiProviderId;\\n  model: string;\\n  apiKey?: string;\\n  baseUrl?: string;\\n}\\n\", \"StartLine\":160, \"TargetContent\":\"export interface LifecycleStageInfo {\\n  id: LifecycleStageId;\\n  stepNumber: number;\\n  label: string;\\n  metricText: string;\\n  emoji: string;\\n  whatThisStageMeans: string;\\n  liveSummary: string;\\n  url: string;\\n  cameraPos: [number, number, number];\\n  lookAt: [number, number, number];\\n  worldAnchor: [number, number, number];\\n}\", \"TargetFile\":\"/src/types.ts\"}"
