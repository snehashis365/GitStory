        instruction: "export interface RepoMetadata {\n  owner: string;\n  name: string;\n  fullName: string;\n  description: string;\n  stars: number;\n  forks: number;\n  openIssues: number;\n  watchers: number;\n  language: string;\n  defaultBranch: string;\n  pushedAt: string;\n  updatedAt: string;\n  createdAt: string;\n  htmlUrl: string;\n  avatarUrl: string;\n  topics: string[];\n  license: string | null;\n}\n\nexport interface CommitItem {\n  sha: string;\n  shortSha: string;\n  message: string;\n  firstLine: string;\n  authorName: string;\n  authorLogin: string;\n  authorAvatar: string;\n  date: string;\n  htmlUrl: string;\n}\n\nexport interface PullRequestItem {\n  number: number;\n  title: string;\n  userLogin: string;\n  userAvatar: string;\n  mergedAt: string;\n  htmlUrl: string;\n  labels: string[];\n}\n\nexport interface ReleaseItem {\n  id: number;\n  tagName: string;\n  name: string;\n  publishedAt: string;\n  body: string;\n  htmlUrl: string;\n  authorLogin: string;\n}\n\nexport interface ContributorItem {\n  login: string;\n  avatarUrl: string;\n  contributions: number;\n  htmlUrl: string;\n}\n\nexport interface VelocityPoint {\n  label: string;\n  date: string;\n  commits: number;\n  mergedPRs: number;\n}\n\nexport interface RepoSnapshot {\n  repo: RepoMetadata;\n  commits: CommitItem[];\n  mergedPRs: PullRequestItem[];\n  releases: ReleaseItem[];\n  contributors: ContributorItem[];\n  velocitySeries: VelocityPoint[];\n  syncedAt: string;\n  rateLimitRemaining: number | null;\n  cached: boolean;\n}\n\nexport type ChangeCategory = \'Feature\' | \'Fix\' | \'Speed\' | \'Docs\' | \'Polish\';\n\nexport interface CommitTranslation {\n  sha: string;\n  emoji: string;\n  plainTitle: string;\n  whyItMatters: string;\n  category: ChangeCategory;\n}\n\nexport interface PrTranslation {\n  number: number;\n  emoji: string;\n  plainTitle: string;\n  whyItMatters: string;\n  category: ChangeCategory;\n}\n\nexport interface ReleaseHighlight {\n  emoji: string;\n  text: string;\n}\n\nexport interface ReleaseTranslation {\n  tagName: string;\n  cheerfulTitle: string;\n  summary: string;\n  highlights: ReleaseHighlight[];\n}\n\nexport interface AiDigest {\n  headline: string;\n  playfulSummary: string;\n  momentumMood: string;\n  momentumEmoji: string;\n  nextMilestoneEstimate: string;\n  milestoneProgressPct: number;\n  releaseTranslation: ReleaseTranslation | null;\n  commitTranslations: CommitTranslation[];\n  prTranslations: PrTranslation[];\n  generatedAt: string;\n}\n\nexport interface ChatMessage {\n  id: string;\n  role: \'user\' | \'assistant\';\n  content: string;\n  timestamp: string;\n  contextLabel?: string;\n}\n\nexport interface MilestoneAlert {\n  id: string;\n  type: \'commit\' | \'pr\' | \'release\' | \'celebration\';\n  title: string;\n  body: string;\n  emoji: string;\n  timestamp: string;\n  isSimulated?: boolean;\n}\n\nexport interface IslandStation {\n  id: string;\n  kind: \'release\' | \'pr\' | \'commit\' | \'contributor\';\n  title: string;\n  subtitle: string;\n  emoji: string;\n  detail: string;\n  meta: string;\n  url: string;\n  cameraPos: [number, number, number];\n  lookAt: [number, number, number];\n}\n"
